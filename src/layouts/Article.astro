---
import { getCollection } from 'astro:content';
import Base from './Base.astro';
import 'katex/dist/katex.min.css';
import ArticleHeader from '../components/article/ArticleHeader.astro';
import ShareActions from '../components/article/ShareActions.astro';
import ArticleJourney from '../components/blog/ArticleJourney.astro';
import MobileToc from '../components/blog/MobileToc.astro';
import TableOfContents from '../components/blog/TableOfContents.astro';
import CommentSection from '../components/comments/CommentSection.astro';
import MermaidRenderer from '../components/markdown/MermaidRenderer.astro';
import MarkdownWidgets from '../components/markdown/MarkdownWidgets.astro';
import { getSiteConfig } from '../config';
import { resolveCommentsConfig, supportsCommentSection } from '../lib/comments';
import { sortByDateDesc } from '../lib/content-dates';
import { slugifyGroupName } from '../lib/content-groups';
import { buildTocTree, countTocItems } from '../lib/toc-tree';
import { getUiText } from '../lib/ui-text';
import { withBase } from '../lib/url';
import '../styles/blog-article.css';

const siteConfig = await getSiteConfig();
const { comments: rawComments, site, profile, article: articleConfig } = siteConfig;
const comments = resolveCommentsConfig(rawComments);
const ui = getUiText(siteConfig);
const profileAvatar = withBase(profile.avatar);

type SidebarConfig = {
  enable?: boolean;
  toc?: boolean;
};

interface Props {
  post?: {
    id: string;
    collection?: string;
    body?: string;
    data: {
      title: string;
      description: string;
      date: Date;
      heroImage?: ImageMetadata | string;
      showHeroImage?: boolean;
      tags?: string[];
      categories?: string[];
      comments?: boolean;
      draft?: boolean;
      sidebar?: SidebarConfig;
      references?: { title?: string; link?: string }[];
    };
  };
  headings?: { depth: number; slug: string; text: string }[];
  sidebar?: SidebarConfig;
  headerVariant?: 'default' | 'archive';
  headerKicker?: string;
  headerNote?: string;
  title?: string;
  description?: string;
  date?: Date;
  heroImage?: ImageMetadata | string;
  showHeroImage?: boolean;
  tags?: string[];
  categories?: string[];
  contentFont?: 'article' | 'ui';
}

const props = Astro.props;
const headings = props.headings ?? [];
const post = props.post ?? {
  id: 'standalone',
  collection: 'standalone',
  body: props.description ?? '',
  data: {
    title: props.title ?? 'Untitled',
    description: props.description ?? '',
    date: props.date ?? new Date(),
    heroImage: props.heroImage,
    showHeroImage: props.showHeroImage ?? true,
    tags: props.tags ?? [],
    categories: props.categories ?? [],
    draft: false,
    sidebar: { enable: true, toc: true },
  },
};
const isBlogPost = post.collection === 'blog';
const shouldMountCommentSection = supportsCommentSection(post.collection);
const { title, description, date, heroImage, showHeroImage = true } = post.data;
const contentFont = props.contentFont ?? 'article';
const bodyText = 'body' in post && typeof post.body === 'string' ? post.body : description;
const englishWords = bodyText.match(/[A-Za-z0-9]+(?:['’-][A-Za-z0-9]+)*/g) ?? [];
const cjkChars =
  bodyText.match(/[\p{Script=Han}\p{Script=Hiragana}\p{Script=Katakana}\p{Script=Hangul}]/gu) ?? [];
const wordCount = englishWords.length + cjkChars.length;
const readingMinutes = Math.max(1, Math.ceil(englishWords.length / 220 + cjkChars.length / 500));
const readingTime = ui.article.readingTime(readingMinutes);
const tags = post.data.tags ?? [];
const tagLinks = tags.map((name) => ({
  name,
  slug: slugifyGroupName(name),
}));
const categoryLinks = (post.data.categories ?? []).map((name) => ({
  name,
  slug: slugifyGroupName(name),
}));
const references = post.data.references?.filter(({ title, link }) => title || link) ?? [];
const tocItems = buildTocTree(headings);
const tocItemCount = countTocItems(tocItems);
const sidebarConfig = {
  enable: true,
  toc: true,
  ...post.data.sidebar,
  ...props.sidebar,
};
const shouldRenderSidebar = sidebarConfig.enable ?? true;
const shouldRenderToc = sidebarConfig.toc ?? true;
const hasToc = shouldRenderToc && tocItemCount > 0;

const allBlogPosts = await getCollection('blog', ({ data }) => !data.draft);
const timeline = sortByDateDesc(allBlogPosts);
const currentIndex = timeline.findIndex((entry) => entry.id === post.id);
const nextPost = currentIndex > 0 ? timeline[currentIndex - 1] : undefined;
const previousPost =
  currentIndex >= 0 && currentIndex < timeline.length - 1 ? timeline[currentIndex + 1] : undefined;
const navigationIds = new Set(
  [previousPost?.id, nextPost?.id].filter((id): id is string => Boolean(id)),
);
const morePostCandidates = timeline
  .filter(({ id }) => id !== post.id && !navigationIds.has(id))
  .slice(0, 3);
const morePosts = articleConfig.morePosts ? morePostCandidates : [];
const showJourney = articleConfig.navigation || (articleConfig.morePosts && morePosts.length > 0);
const hasSidebar = shouldRenderSidebar && hasToc;
const shareUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const posterCover = heroImage ? (typeof heroImage === 'string' ? heroImage : heroImage.src) : '';
---

<Base
  title={title}
  description={description}
  bodyClass={[
    'blog-detail-page',
    contentFont === 'ui' && 'blog-content-ui',
    hasToc && 'has-mobile-toc',
  ]
    .filter(Boolean)
    .join(' ')}
  showTocIcon={hasToc}
  tocItems={tocItems}
>
  <Fragment slot="head">
    {
      comments.provider === 'waline' && comments.enabled && (
        <link rel="stylesheet" href="https://unpkg.com/@waline/client@v3/dist/waline.css" />
      )
    }
  </Fragment>
  <div class="blog-background" aria-hidden="true"></div>

  <main class:list={['blog-layout', { 'blog-layout-centered': !hasSidebar }]} data-pagefind-body>
    <div class="article-column">
      <article class="article-card">
        <ArticleHeader
          title={title}
          description={description}
          date={date}
          wordCount={wordCount}
          readingTime={readingTime}
          tags={tagLinks}
          categories={categoryLinks}
          heroImage={heroImage}
          showHeroImage={showHeroImage}
          variant={props.headerVariant}
          kicker={props.headerKicker}
          note={props.headerNote}
        />

        <section
          id="article-start"
          class:list={['article-content', { 'article-content-ui': contentFont === 'ui' }]}
          data-sonder-content
        >
          <slot />
        </section>
      </article>
      {
        references.length > 0 && (
          <section class="article-references" aria-label={ui.article.referencesLabel}>
            <h2 class="article-references-title">{ui.article.references}</h2>
            <ol class="article-references-list">
              {references.map(({ title, link }) => (
                <li>
                  {link ? (
                    <a href={link} target="_blank" rel="noopener noreferrer">
                      {title || link}
                    </a>
                  ) : (
                    <span>{title}</span>
                  )}
                </li>
              ))}
            </ol>
          </section>
        )
      }
      {
        isBlogPost && articleConfig.share && (
          <ShareActions
            title={title}
            description={description}
            url={shareUrl}
            siteTitle={site.title}
            author={profile.name}
            date={date.toISOString()}
            avatar={profileAvatar}
            logo={profileAvatar}
            coverImage={posterCover}
            coverSelector={showHeroImage && heroImage ? '.article-hero-image img' : ''}
          />
        )
      }
      {
        isBlogPost && showJourney && (
          <ArticleJourney
            showPager={articleConfig.navigation}
            previous={articleConfig.navigation ? previousPost : undefined}
            next={articleConfig.navigation ? nextPost : undefined}
            more={morePosts}
          />
        )
      }
      {
        shouldMountCommentSection && (
          <CommentSection frontmatter={post.data} pathname={Astro.url.pathname} />
        )
      }
    </div>

    {
      hasSidebar && (
        <aside class="right-sidebar" aria-label={ui.article.readingTools}>
          <div class="right-sidebar-inner">
            {hasToc && <TableOfContents items={tocItems} font={contentFont} />}
          </div>
        </aside>
      )
    }
  </main>
  {hasToc && <MobileToc items={tocItems} font={contentFont} />}
  <Fragment slot="after-content">
    <MermaidRenderer />
    <MarkdownWidgets />
  </Fragment>
</Base>
<style>
  .article-references {
    margin-top: var(--spacing-lg, 2rem);
    padding: 1rem 1.25rem;
    border: 1px solid var(--paper-rule);
    border-radius: 0.75rem;
    background: var(--paper-fog);
    font-family: var(--font-meta);
    font-size: 0.875rem;
  }

  .article-references-title {
    margin: 0 0 0.5rem;
    font-family: var(--font-heading);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--paper-accent);
  }

  .article-references-list {
    margin: 0;
    padding-inline-start: 1.25rem;
    display: grid;
    gap: 0.375rem;
    line-height: 1.6;
  }

  .article-references-list a {
    color: inherit;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .article-references-list a:hover {
    color: var(--paper-accent);
  }
</style>
