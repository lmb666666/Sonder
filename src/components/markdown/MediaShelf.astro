---
import type { ImageMetadata } from 'astro';
import { BookOpenText } from 'lucide-astro';
import '../../styles/media-shelf.css';

export type MediaStatus = 'completed' | 'in-progress' | 'planned' | 'abandoned';

export type MediaShelfItem = {
  title: string;
  creator: string;
  type: 'book' | 'film' | 'series' | 'album' | 'podcast';
  status?: MediaStatus;
  cover?: string | ImageMetadata;
  coverAspect?: 'portrait' | 'landscape' | 'square' | 'wide';
  rating?: number;
  href?: string;
  reviewHref?: string;
  reviewLabel?: string;
  note?: string;
};

interface Props {
  items: MediaShelfItem[];
  variant?: 'shelf' | 'inline';
  columns?: 2 | 3 | 4 | 5;
  class?: string;
  label?: string;
  statusLabels?: Record<string, string>;
}

const {
  items,
  variant = 'shelf',
  columns = 4,
  class: className,
  label = 'Media shelf',
  statusLabels = {},
} = Astro.props;
const coverSrc = (cover: MediaShelfItem['cover']) =>
  typeof cover === 'string' ? cover : cover?.src;
const ratingLabel = (rating: number | undefined) =>
  rating ? '★'.repeat(Math.max(1, Math.min(5, Math.round(rating)))) : undefined;
---

<section
  class:list={['sonder-media-shelf', `sonder-media-shelf--${variant}`, className]}
  style={`--media-shelf-columns: ${columns};`}
  aria-label={label}
>
  {
    items.map((item) => {
      const destination = item.reviewHref ?? item.href;
      const rating = ratingLabel(item.rating);
      const content = (
        <>
          <figure
            class="sonder-media-shelf__cover"
            data-media-type={item.type}
            data-cover-aspect={item.coverAspect}
          >
            {coverSrc(item.cover) ? (
              <img src={coverSrc(item.cover)} alt={item.title} loading="lazy" decoding="async" />
            ) : (
              <span aria-hidden="true">{item.type}</span>
            )}
          </figure>
          <div class="sonder-media-shelf__content">
            <strong>{item.title}</strong>
            <span class="sonder-media-shelf__meta">
              <span class="sonder-media-shelf__creator">{item.creator}</span>
              {rating && <span class="sonder-media-shelf__rating">{rating}</span>}
            </span>
            {item.status ? (
              <span class="sonder-media-shelf__status" data-status={item.status}>
                {statusLabels[item.status] ?? item.status}
              </span>
            ) : null}
            {item.reviewHref && item.reviewLabel ? (
              <span class="sonder-media-shelf__review">
                <BookOpenText size={13} strokeWidth={1.8} aria-hidden="true" />
                {item.reviewLabel}
              </span>
            ) : null}
            {item.note ? <p>{item.note}</p> : null}
          </div>
        </>
      );

      return destination ? (
        <a
          class="sonder-media-shelf__item"
          href={destination}
          target={item.reviewHref ? undefined : '_blank'}
          rel={item.reviewHref ? undefined : 'noreferrer'}
        >
          {content}
        </a>
      ) : (
        <article class="sonder-media-shelf__item">{content}</article>
      );
    })
  }
</section>
