---
/**
 * 外挂指令的重型组件客户端：只包含交互脚本与全局样式。
 * 由文章布局（Article）渲染；脚本各自探测 DOM 标记，无标记时零行为；
 * 重依赖（abcjs）按需动态加载。
 */
import '../../plugins/markdown/directives/widgets.css';
// 指令与提醒块样式：作为真实样式表加载（此前经 head-inline 由 JS 注入，
// 首屏会有无样式闪烁，且禁用 JS 时全部丢失）
import '../../plugins/markdown/callout/styles.css';
import '../../plugins/markdown/directives/styles.css';
import '../../styles/media-shelf.css';
import '../../styles/friend-link-card.css';
import '../../styles/friend-link-application.css';
---

<script>
  import { bindKeys } from '../../plugins/markdown/directives/widgets/key.js';
  import { initCarousels } from '../../plugins/markdown/directives/widgets/carousel.js';
  import { initFriendCircles } from '../../plugins/markdown/directives/widgets/friend-circle.js';
  import {
    initAudioPlayers,
    pauseAudioPlayers,
  } from '../../plugins/markdown/directives/widgets/audio-player.js';
  import {
    renderMusicScores,
    pauseMusicScores,
  } from '../../plugins/markdown/directives/widgets/music-score.js';
  import { initFriendLinkApplications } from '../../plugins/markdown/directives/widgets/friend-link-application.js';
  import { bindBlurs } from '../../plugins/markdown/directives/widgets/blur.js';
  import { applyVideoZoom } from '../../plugins/markdown/directives/widgets/video.js';

  document.addEventListener('click', (event) => {
    const frame =
      event.target instanceof Element ? event.target.closest('.expressive-code .frame') : null;
    frame?.classList.add('ff-copy-revealed');
  });

  const boot = async () => {
    bindKeys();
    bindBlurs();
    applyVideoZoom();
    initCarousels();
    initFriendCircles();
    initAudioPlayers();
    initFriendLinkApplications();
    void renderMusicScores();

    if (document.querySelector('[data-sonder-content] img')) {
      const { initLightbox } =
        await import('../../plugins/markdown/directives/widgets/lightbox.js');
      initLightbox();
    }
  };

  document.addEventListener('astro:page-load', () => void boot());
  document.addEventListener('astro:before-swap', () => {
    pauseAudioPlayers();
    pauseMusicScores();
  });
</script>
