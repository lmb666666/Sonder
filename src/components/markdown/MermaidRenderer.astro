<script>
  const selector = '[data-mermaid-diagram] .mermaid';
  const sources = new WeakMap<Element, string>();
  let module: typeof import('mermaid') | undefined;
  let scheduled = false;

  const currentTheme = () =>
    document.documentElement.dataset.theme === 'dark' ? 'dark' : 'default';

  const render = async () => {
    const nodes = Array.from(document.querySelectorAll<HTMLElement>(selector));
    if (!nodes.length) return;
    nodes.forEach((node) => {
      const source = sources.get(node) ?? node.textContent ?? '';
      sources.set(node, source);
      node.textContent = source;
      node.removeAttribute('data-processed');
    });
    try {
      module ??= await import('mermaid');
      const mermaid = module.default;
      mermaid.initialize({
        startOnLoad: false,
        securityLevel: 'strict',
        theme: currentTheme(),
        fontFamily: getComputedStyle(document.documentElement)
          .getPropertyValue('--font-article')
          .trim(),
      });
      await mermaid.run({ nodes });
    } catch (error) {
      console.error('Unable to render Mermaid diagram.', error);
    }
  };
  const schedule = () => {
    if (scheduled) return;
    scheduled = true;
    window.requestAnimationFrame(() => {
      scheduled = false;
      void render();
    });
  };

  document.addEventListener('astro:page-load', schedule);
  window.addEventListener('sonder:theme-change', schedule);
  new MutationObserver(schedule).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['data-theme'],
  });
</script>
