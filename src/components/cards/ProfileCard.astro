---
import Icon from '../Icon.astro';

interface Profile {
  name: string;
  handle: string;
  role: string;
  email: string;
  website: string;
  avatar: string;
}

const { profile } = Astro.props as { profile: Profile };
---

<article class="profile-card">
  <div class="avatar-wrap">
    <img
      src={profile.avatar}
      alt={`${profile.name} GitHub avatar`}
      width="128"
      height="128"
      loading="eager"
    />
  </div>

  <div class="profile-heading">
    <h1>{profile.name}</h1>
    <span><Icon name="sparkle" /> {profile.role}</span>
  </div>
</article>

<style>
  /* 紧凑身份行：头像 + 名号横排，为侧栏寻路卡让出视觉重量 */
  .profile-card {
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    padding: 4px 0;
    text-align: left;
    overflow: hidden;
  }

  .avatar-wrap {
    flex: 0 0 auto;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: transparent;
    box-shadow: none;
  }

  .avatar-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: inherit;
  }

  .profile-heading {
    min-width: 0;
  }

  .profile-heading h1 {
    margin: 0;
    color: var(--paper-ink);
    font-size: 1.08rem;
    letter-spacing: 0;
  }

  .profile-heading span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 4px;
    color: var(--paper-ink);
    font-size: 0.78rem;
  }

  .profile-heading svg {
    width: 15px;
    height: 15px;
    flex: 0 0 auto;
    color: var(--paper-accent);
  }

  @media (max-width: 820px) {
    /* 移动端刊头：头像、名号、签名居中对齐 */
    .profile-card {
      flex-direction: column;
      justify-content: center;
      gap: 10px;
      padding: 0;
      text-align: center;
    }

    .avatar-wrap {
      width: 68px;
      height: 68px;
    }

    .profile-heading h1 {
      font-size: 1.16rem;
    }

    .profile-heading span {
      justify-content: center;
      margin-top: 6px;
      font-size: 0.8rem;
    }
  }
</style>
