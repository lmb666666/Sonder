---
import { getCollection } from 'astro:content';
import Icon from '../Icon.astro';
import BlogPostMediaList from '../blog/BlogPostMediaList.astro';
import { getSiteConfig } from '../../data/site';
import { getLatestPosts } from '../../utils/blog-heatmap';
import { sortByDateDesc } from '../../utils/content-dates';
import { getUiText } from '../../utils/ui-text';

interface Props {
  count?: number;
  excludeDraft?: boolean;
}

const { count = 1, excludeDraft = true } = Astro.props;
const posts = await getCollection('blog', ({ data }) => !excludeDraft || !data.draft);
const latestPosts = getLatestPosts(posts, count);
// 移动端把最近两篇升级为封面卡（与博客列表同一张卡）
const mobilePosts = sortByDateDesc(posts).slice(0, 2);
const ui = getUiText(await getSiteConfig());
const formatShortDate = new Intl.DateTimeFormat(ui.locale, {
  month: 'short',
  day: 'numeric',
});
---

{
  (latestPosts.length > 0 || mobilePosts.length > 0) && (
    <section class="latest-block" aria-label={ui.heatmap.latestPublishedPosts}>
      {/* 移动端：小组标题 + 两张封面卡 + 动态行 */}
      <div class="latest-narrow">
        <h2 class="latest-heading">
          <Icon name="pen" size={14} />
          {ui.heatmap.latest}
        </h2>
        {mobilePosts.length > 0 && <BlogPostMediaList posts={mobilePosts} />}
      </div>

      {/* 桌面端：紧凑索引卡 */}
      <article class="latest-card">
        <strong>{ui.heatmap.latest}</strong>
        <div class="latest-list">
          {latestPosts.map((post) => (
            <a class="latest-link" href={post.href} title={post.title}>
              <span class="latest-kind">{ui.heatmap.latestArticle}</span>
              <em>{post.title}</em>
              <time datetime={post.date.toISOString()}>{formatShortDate.format(post.date)}</time>
            </a>
          ))}
        </div>
      </article>
    </section>
  )
}

<style>
  .latest-block {
    display: grid;
  }

  /* 移动端区块默认隐藏，桌面显示索引卡 */
  .latest-narrow {
    display: none;
  }

  .latest-card {
    display: grid;
    gap: 8px;
    padding: 14px 16px;
    border: 1px solid var(--paper-line);
    border-radius: 8px;
    background: var(--paper-surface-muted);
  }

  .latest-list {
    display: grid;
    gap: 8px;
  }

  .latest-link {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) max-content;
    align-items: center;
    min-width: 0;
    gap: 10px;
    color: inherit;
    text-decoration: none;
  }

  /* 类型标：区分最新文章与最新动态，权重压到 metadata 层 */
  .latest-kind {
    padding: 1px 6px;
    border: 1px solid var(--paper-line);
    border-radius: 4px;
    background: var(--paper-control);
    color: var(--paper-ink-soft);
    font-family: var(--font-meta);
    font-size: 0.66rem;
    font-weight: 600;
    line-height: 1.5;
    white-space: nowrap;
  }

  strong {
    color: color-mix(in srgb, var(--accent-dark, #3b566e) 82%, var(--paper-ink));
    font-size: 0.72rem;
    line-height: 1.15;
  }

  em {
    overflow: hidden;
    color: var(--paper-ink);
    font-size: 0.88rem;
    font-style: normal;
    font-weight: 650;
    line-height: 1.25;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color 180ms ease;
  }

  time {
    color: var(--paper-ink-soft);
    font-size: 0.72rem;
    line-height: 1;
    white-space: nowrap;
  }

  .latest-link:hover em,
  .latest-link:focus-visible em {
    color: var(--paper-accent);
  }

  .latest-link:focus-visible {
    border-radius: 6px;
    outline: 2px solid color-mix(in srgb, var(--paper-accent) 28%, transparent);
    outline-offset: 3px;
  }

  @media (max-width: 820px) {
    .latest-card {
      display: none;
    }

    .latest-narrow {
      display: grid;
      gap: 14px;
    }

    .latest-heading {
      display: flex;
      align-items: center;
      gap: 7px;
      margin: 0;
      color: var(--paper-ink-soft);
      font-size: 0.82rem;
      font-weight: 650;
      letter-spacing: 0.02em;
      line-height: 1.2;
    }

    .latest-heading :global(svg) {
      color: var(--paper-accent);
    }

    /* 收进两栏滚动区之外：卡片间距与高度按移动端收紧 */
    .latest-narrow :global(.media-stack) {
      gap: 14px;
    }

    .latest-narrow :global(.media-card) {
      border-radius: 16px;
    }

    .latest-narrow :global(.media-body) {
      padding: 14px 16px 15px;
    }

    .latest-narrow :global(.media-title) {
      font-size: 1.04rem;
    }
  }
</style>
