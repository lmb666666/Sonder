---
import { getCollection } from 'astro:content';
import Icon from '../Icon.astro';
import BlogPostMediaList from '../blog/BlogPostMediaList.astro';
import { getSiteConfig } from '../../data/site';
import { sortByDateDesc } from '../../utils/content-dates';
import { getUiText } from '../../utils/ui-text';

interface Props {
  count?: number;
  excludeDraft?: boolean;
}

const { count = 2, excludeDraft = true } = Astro.props;
const posts = await getCollection('blog', ({ data }) => !excludeDraft || !data.draft);
// 与文章页共用同一张封面卡（BlogPostMediaList），首页不再维护另一套索引样式
const latestPosts = sortByDateDesc(posts).slice(0, Math.max(1, count));
const ui = getUiText(await getSiteConfig());
---

{
  latestPosts.length > 0 && (
    <section class="latest-block" aria-label={ui.heatmap.latestPublishedPosts}>
      <h2 class="latest-heading">
        <Icon name="pen" size={14} />
        {ui.heatmap.latest}
      </h2>
      <BlogPostMediaList posts={latestPosts} />
    </section>
  )
}

<style>
  .latest-block {
    display: grid;
    gap: 14px;
  }

  .latest-heading {
    display: flex;
    align-items: center;
    gap: 7px;
    margin: 0;
    color: var(--paper-ink-soft);
    font-size: 0.82rem;
    font-weight: 650;
    letter-spacing: 0.02em;
    line-height: 1.2;
  }

  .latest-heading :global(svg) {
    color: var(--paper-accent);
  }
</style>
