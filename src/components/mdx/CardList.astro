---
/**
 * 卡片列表：把插槽里的 Markdown 列表渲染为响应式卡片网格。
 *
 * 用法：
 * ```mdx
 * <CardList>
 *   - 第一项
 *   - 第二项
 * </CardList>
 * ```
 * 移植自 Sonder v1 CardList.vue，视觉对齐 navfolio token。
 */
---

<div class="card-list">
  <slot />
</div>

<style>
  .card-list :global(> :where(ol, ul):not([class])) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 0.75em;
    margin: 1.5em 0;
    padding-inline-start: 0;
    list-style: none;
  }

  .card-list :global(> :where(ol, ul):not([class]) > li) {
    margin: 0;
    padding: 0.6em 0.9em;
    border: 1px solid var(--paper-line-strong);
    border-radius: 0.5em;
    background: var(--paper-surface);
    box-shadow: var(--paper-shadow);
    font-family: var(--font-meta);
  }
</style>
