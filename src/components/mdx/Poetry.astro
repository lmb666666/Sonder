---
/**
 * 诗歌排版：居中标题 / 作者 / 正文（保留换行与段落）/ 脚注。
 * 移植自 Sonder v1 Poetry.vue，视觉对齐 navfolio token。
 */
interface Props {
  title?: string;
  author?: string;
  footer?: string;
}

const { title, author, footer } = Astro.props;
---

<section class="poetry">
  {title && <h2 class="poetry-title">{title}</h2>}
  {author && <div class="poetry-meta">{author}</div>}
  <div class="poetry-content">
    <slot />
  </div>
  {footer && <div class="poetry-meta">{footer}</div>}
</section>

<style>
  .poetry {
    width: fit-content;
    max-width: 100%;
    margin: 2em auto;
    white-space: pre-wrap;
    text-align: center;
  }

  .poetry-title {
    margin: 0 0 0.25em;
    font-family: var(--font-heading);
    font-size: 1.2em;
    font-weight: 600;
  }

  .poetry-meta {
    color: var(--paper-ink-faint);
    font-family: var(--font-meta);
    font-size: 0.875em;
  }

  .poetry-content {
    margin-top: 0.75em;
  }

  .poetry-content :global(p) {
    width: fit-content;
    margin: 0.5em auto;
    text-align: center;
  }
</style>
