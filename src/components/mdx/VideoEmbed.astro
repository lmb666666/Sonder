---
/**
 * 视频嵌入：raw / bilibili / bilibili-nano / youtube / douyin / douyin-wide / tiktok。
 * 移植自 Sonder v1 VideoEmbed.vue，视觉对齐 navfolio token。
 * 抖音系列播放器需按容器宽度设置 CSS zoom 才能正确选择竖/横屏模式，见下方脚本。
 */
interface Props {
  type?: 'raw' | 'bilibili' | 'bilibili-nano' | 'youtube' | 'douyin' | 'douyin-wide' | 'tiktok';
  id: string;
  autoplay?: boolean;
  /** 宽高比，如 "16 / 9"、"1.6" */
  ratio?: string;
  /** 仅 type="raw" 时可用 */
  poster?: string;
  width?: string;
  height?: string;
}

const { type = 'raw', id, autoplay = false, ratio, poster, width, height = '80vh' } = Astro.props;

const defaultRatio: Record<string, string | undefined> = {
  raw: undefined,
  douyin: '27 / 56',
  'douyin-wide': '1198 / 731',
};

const resolvedRatio = ratio ?? defaultRatio[type] ?? '16 / 9';

function playerSrc(): string {
  switch (type) {
    case 'bilibili':
      return `https://player.bilibili.com/player.html?bvid=${id}&autoplay=${autoplay}`;
    case 'bilibili-nano':
      return `https://www.bilibili.com/blackboard/newplayer.html?bvid=${id}&autoplay=${autoplay}`;
    case 'youtube':
      return `https://www.youtube.com/embed/${id}?rel=0&disablekb=1&playsinline=1&autoplay=${autoplay}`;
    case 'douyin':
    case 'douyin-wide':
      return `https://open.douyin.com/player/video?vid=${id}`;
    case 'tiktok':
      return `https://www.tiktok.com/embed/v3/${id}`;
    default:
      return id;
  }
}

// 抖音预检测 iframe 宽度：小于 730px 返回竖屏，否则横屏。
// zoom 因子来自 Sonder v1 的实测值，乘以容器实际宽度得到补偿 zoom。
const isZoomed = type === 'douyin' || type === 'douyin-wide';
const zoomFactor = type === 'douyin' ? 0.0031 : 0.00134;
---

<div
  class="video-embed"
  class:list={{ 'video-embed-zoom': isZoomed }}
  data-zoom-factor={isZoomed ? zoomFactor : undefined}
  style={`aspect-ratio: ${resolvedRatio ?? undefined}; max-width: ${width ?? undefined}; max-height: ${height};`}
>
  {
    type === 'raw' ? (
      <video controls poster={poster} src={id} preload="metadata" />
    ) : (
      <iframe
        src={playerSrc()}
        scrolling="no"
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; fullscreen; gyroscope; picture-in-picture"
        title={id}
      />
    )
  }
</div>

<style>
  .video-embed {
    contain: paint;
    margin: 2rem auto;
    border: 1px solid var(--paper-line);
    border-radius: 0.75rem;
    background: var(--paper-surface);
    box-shadow: var(--paper-shadow);
    overflow: hidden;
  }

  .video-embed :global(iframe),
  .video-embed :global(video) {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>

<script>
  const applyZoom = () => {
    document.querySelectorAll<HTMLElement>('.video-embed-zoom').forEach((container) => {
      const factor = Number(container.dataset.zoomFactor ?? '0');
      const iframe = container.querySelector('iframe');
      if (!factor || !iframe) return;
      (iframe as HTMLElement).style.zoom = String(container.clientWidth * factor);
    });
  };
  const schedule = () => window.requestAnimationFrame(applyZoom);
  document.addEventListener('astro:page-load', schedule);
  if (document.readyState === 'loading')
    document.addEventListener('DOMContentLoaded', schedule, { once: true });
  else schedule();
</script>
