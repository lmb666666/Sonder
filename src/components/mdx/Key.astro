---
/**
 * 快捷键按键展示。macOS 客户端检测：mac 显示符号（⌘ ⌥ ⇧），其他平台显示文字。
 * 真实按下对应组合键时高亮。移植自 Sonder v1 Key.vue，视觉对齐 sonder token。
 */
interface Props {
  text?: string;
  /** KeyboardEvent.key 值，见 MDN */
  code?: string;
  /** 仅 macOS 默认显示符号；显式开启则全平台显示符号 */
  icon?: boolean;
  ctrl?: boolean;
  shift?: boolean;
  alt?: boolean;
  meta?: boolean;
  win?: boolean;
  /** 智能适配：Windows 用 Ctrl，macOS 用 Cmd */
  cmd?: boolean;
}

const { text, code, icon, ctrl, shift, alt, meta, win, cmd } = Astro.props;

const attrs: string[] = [];
if (ctrl) attrs.push('ctrl');
if (shift) attrs.push('shift');
if (alt) attrs.push('alt');
if (meta) attrs.push('meta');
if (win) attrs.push('win');
if (cmd) attrs.push('cmd');
if (icon === true) attrs.push('icon');
if (icon === false) attrs.push('no-icon');
---

<kbd class="key" data-key={code ?? ''} data-mods={attrs.join(' ')}>{text ?? code ?? ''}</kbd>

<style>
  kbd.key {
    display: inline-block;
    margin: 0.1em;
    padding: 0 0.45em 0.1em;
    border: 1px solid var(--paper-line-strong);
    border-radius: 0.3em;
    background-color: var(--paper-surface-muted);
    box-shadow: inset 0 -0.15em 0 var(--paper-fog, var(--paper-surface-muted));
    color: var(--paper-ink-soft);
    font-family: var(--font-code);
    font-size: 0.9em;
    line-height: 1.5;
    user-select: none;
    transition: all 0.1s;
  }

  kbd.key.active {
    border-color: var(--paper-accent);
    background-color: var(--paper-accent-soft);
    color: var(--paper-accent);
    transform: translateY(0.05em);
  }
</style>

<script>
  const symbolMap: Record<string, string> = {
    ' ': '␣',
    Alt: '⌥',
    Backspace: '⌫',
    Control: '⌃',
    Delete: '⦻',
    Enter: '↵',
    Escape: '⎋',
    Shift: '⇧',
    Tab: '⇥',
    Win: '⊞',
  };
  const displayMap: Record<string, string> = {
    ' ': 'Space',
    ArrowDown: '↓',
    ArrowLeft: '←',
    ArrowRight: '→',
    ArrowUp: '↑',
    Control: 'Ctrl',
    Delete: 'Del',
    Escape: 'Esc',
  };

  const isMac = /mac ?os/i.test(navigator.userAgent);

  // data-mods 使用小写短名，映射回标准 KeyboardEvent key 名
  const canonicalMod: Record<string, string> = {
    ctrl: 'Control',
    shift: 'Shift',
    alt: 'Alt',
    meta: 'Meta',
    win: 'Win',
    cmd: 'Cmd',
  };

  function labelFor(mod: string, useSymbol: boolean): string {
    if (mod === 'meta' || mod === 'Meta') {
      if (useSymbol) return isMac ? '⌘' : '⊞';
      return isMac ? 'Cmd' : 'Win';
    }
    const key = canonicalMod[mod] ?? mod;
    if (useSymbol && key in symbolMap) return symbolMap[key];
    if (key in displayMap) return displayMap[key];
    return key;
  }

  function renderKey(el: HTMLElement) {
    if (el.dataset.rendered === '1') return;
    const mods = (el.dataset.mods ?? '').split(' ').filter(Boolean);
    const code = el.dataset.key ?? '';
    if (el.textContent?.trim()) {
      // text 显式指定时仅做标记，不重写
      el.dataset.rendered = '1';
      return;
    }
    const useSymbol = isMac ? !mods.includes('no-icon') : mods.includes('icon');
    const parts: string[] = [];
    if (mods.includes('cmd')) parts.push(labelFor(isMac ? 'meta' : 'ctrl', useSymbol));
    if (mods.includes('ctrl') && !mods.includes('cmd')) parts.push(labelFor('ctrl', useSymbol));
    if (mods.includes('shift')) parts.push(labelFor('shift', useSymbol));
    if (mods.includes('alt')) parts.push(labelFor('alt', useSymbol));
    if (mods.includes('meta') && !mods.includes('cmd')) parts.push(labelFor('meta', useSymbol));
    if (mods.includes('win') && !mods.includes('meta')) parts.push(labelFor('win', useSymbol));
    if (code) parts.push(labelFor(code, useSymbol));
    el.textContent = parts.join(useSymbol ? '' : '+');
    el.dataset.rendered = '1';
  }

  const state = { ctrl: false, shift: false, alt: false, meta: false };

  function modifiersMatch(el: HTMLElement): boolean {
    const mods = (el.dataset.mods ?? '').split(' ');
    if (mods.includes('cmd')) {
      if (isMac ? !state.meta : !state.ctrl) return false;
    }
    if (mods.includes('ctrl') && !mods.includes('cmd') && !state.ctrl) return false;
    if (mods.includes('shift') && !state.shift) return false;
    if (mods.includes('alt') && !state.alt) return false;
    if (mods.includes('meta') && !mods.includes('cmd') && !state.meta) return false;
    return true;
  }

  function matchEvent(el: HTMLElement, event: KeyboardEvent): boolean {
    const code = el.dataset.key;
    if (code && event.key.toLowerCase() !== code.toLowerCase()) return false;
    return modifiersMatch(el);
  }

  const refreshAll = () => document.querySelectorAll<HTMLElement>('kbd.key').forEach(renderKey);

  document.addEventListener('astro:page-load', refreshAll);
  if (document.readyState === 'loading')
    document.addEventListener('DOMContentLoaded', refreshAll, { once: true });
  else refreshAll();

  document.addEventListener('keydown', (event) => {
    state.ctrl = event.ctrlKey;
    state.shift = event.shiftKey;
    state.alt = event.altKey;
    state.meta = event.metaKey;
    const target = event.target;
    if (target instanceof Element && target.closest('input, textarea, select, [contenteditable]'))
      return;
    document.querySelectorAll<HTMLElement>('kbd.key').forEach((el) => {
      if (matchEvent(el, event)) el.classList.add('active');
    });
  });

  document.addEventListener('keyup', (event) => {
    state.ctrl = event.ctrlKey;
    state.shift = event.shiftKey;
    state.alt = event.altKey;
    state.meta = event.metaKey;
    document.querySelectorAll<HTMLElement>('kbd.key').forEach((el) => {
      const code = el.dataset.key ?? '';
      const keyReleased = Boolean(code) && event.key.toLowerCase() === code.toLowerCase();
      if (keyReleased || !modifiersMatch(el)) el.classList.remove('active');
    });
  });

  window.addEventListener('blur', () => {
    document
      .querySelectorAll<HTMLElement>('kbd.key.active')
      .forEach((el) => el.classList.remove('active'));
  });
</script>
