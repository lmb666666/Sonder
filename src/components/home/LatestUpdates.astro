---
import { getCollection } from 'astro:content';
import Icon from '../Icon.astro';
import BlogPostMediaList from '../blog/BlogPostMediaList.astro';
import { getSiteConfig } from '../../config';
import { sortByDateDesc } from '../../lib/content-dates';
import { getUiText } from '../../lib/ui-text';

interface Props {
  count?: number;
  excludeDraft?: boolean;
}

const { count = 2, excludeDraft = true } = Astro.props;
const posts = await getCollection('blog', ({ data }) => !excludeDraft || !data.draft);
// 与文章页共用同一张封面卡（BlogPostMediaList），首页不再维护另一套索引样式
const latestPosts = sortByDateDesc(posts).slice(0, Math.max(1, count));
const ui = getUiText(await getSiteConfig());
---

{
  latestPosts.length > 0 && (
    <section class="latest-block" aria-label={ui.heatmap.latestPublishedPosts}>
      <h2 class="latest-heading">
        <Icon name="pen" size={14} />
        {ui.heatmap.latest}
      </h2>
      <BlogPostMediaList posts={latestPosts} />
    </section>
  )
}

<style>
  .latest-block {
    display: grid;
    gap: 14px;
    container-type: inline-size;
  }

  .latest-heading {
    display: flex;
    align-items: center;
    gap: 7px;
    margin: 0;
    color: var(--paper-ink-soft);
    font-size: 0.82rem;
    font-weight: 650;
    letter-spacing: 0.02em;
    line-height: 1.2;
  }

  .latest-heading :global(svg) {
    color: var(--paper-accent);
  }

  /* 首页桌面变体：更扁宽的封面 + 固定两行信息（标题一行、元信息一行） */
  @container (min-width: 720px) {
    .latest-block :global(.media-cover-frame) {
      aspect-ratio: 2 / 1;
    }

    .latest-block :global(.media-body) {
      gap: 5px;
      padding: 14px 18px 16px;
    }

    .latest-block :global(.media-title) {
      font-size: 1.1rem;
      -webkit-line-clamp: 1;
    }

    .latest-block :global(.media-meta) {
      flex-wrap: nowrap;
      gap: 4px 8px;
      font-size: 0.75rem;
    }

    .latest-block :global(.media-meta-side) {
      flex-wrap: nowrap;
      min-width: 0;
      gap: 4px 8px;
    }

    .latest-block :global(.media-meta-chip) {
      flex: 0 0 auto;
      gap: 3px;
    }

    .latest-block :global(.media-meta-chip > svg) {
      width: 12px;
      height: 12px;
    }

    .latest-block :global(.media-meta-groups) {
      flex: 0 1 auto;
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }
</style>
