---
import Icon from '../Icon.astro';
import { getSiteConfig } from '../../config';
import { withBase } from '../../lib/url';

interface Profile {
  name: string;
  handle: string;
  role: string;
  email: string;
  website: string;
  avatar: string;
}

const { profile } = Astro.props as { profile: Profile };
const { theme } = await getSiteConfig();
---

<article class="profile-card" data-nav-style={theme.navStyle}>
  <div class="avatar-wrap" data-avatar-slot transition:name="site-avatar">
    <img
      src={withBase(profile.avatar)}
      alt={`${profile.name} avatar`}
      width="128"
      height="128"
      loading="eager"
    />
  </div>

  <div class="profile-heading">
    <h1>{profile.name}</h1>
    <span><Icon name="sparkle" /> {profile.role}</span>
  </div>
</article>

<style>
  /* 紧凑身份行：头像 + 名号横排，为侧栏寻路卡让出视觉重量 */
  .profile-card {
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    padding: 4px 0;
    text-align: left;
    overflow: hidden;
  }

  /* 与导航栏头像同一套外框（纸面底 + 发丝圆环 + 阴影），保证各页一致 */
  .avatar-wrap {
    flex: 0 0 auto;
    width: 64px;
    height: 64px;
    padding: 2px;
    border: 1px solid var(--paper-line-strong);
    border-radius: 50%;
    background: var(--paper-surface);
    box-shadow: var(--paper-shadow);
  }

  .avatar-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: inherit;
  }

  .profile-heading {
    min-width: 0;
  }

  .profile-heading h1 {
    margin: 0;
    color: var(--paper-ink);
    font-size: 1.08rem;
    letter-spacing: 0;
  }

  .profile-heading span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 4px;
    color: var(--paper-ink);
    font-size: 0.78rem;
  }

  .profile-heading svg {
    width: 15px;
    height: 15px;
    flex: 0 0 auto;
    color: var(--paper-accent);
  }

  @media (max-width: 720px) {
    /* 胶囊模式下头像交给随滚动移动的浮动头像；整块隐藏（保留占位），
       否则空的圆框会留在原处，与浮动头像叠出重影 */
    .profile-card[data-nav-style='pill'] .avatar-wrap {
      visibility: hidden;
    }

    /* 给英雄区多留一点顶部空间，让头像停靠的行程与 krisyan 接近（约 110px） */
    .profile-card[data-nav-style='pill'] {
      margin-top: 24px;
    }
  }

  @media (max-width: 820px) {
    /* 移动端只留头像：名号与签名交给下方主标题，h1 保留给读屏 */
    .profile-card {
      gap: 0;
      padding: 0;
    }

    .avatar-wrap {
      width: 64px;
      height: 64px;
    }

    .profile-heading {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      padding: 0;
      overflow: hidden;
      border: 0;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>
