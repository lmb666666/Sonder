---
import { getCollection } from 'astro:content';
import { getSiteConfig } from '../../config';
import { createRecentBlogHeatmap, type HeatmapDay } from '../../lib/blog-heatmap';
import { getUiText } from '../../lib/ui-text';

interface Props {
  weeks?: number;
  excludeDraft?: boolean;
  dateArchiveBaseHref?: string;
  startDate?: Date | string | null;
  /** 覆盖顶部统计行（label/value）；缺省用内置的总文章/活跃天数/连续天数 */
  stats?: { label: string; value: string }[];
}

const { weeks = 24, excludeDraft = true, dateArchiveBaseHref, startDate, stats } = Astro.props;
const posts = await getCollection('blog', ({ data }) => !excludeDraft || !data.draft);
const heatmap = createRecentBlogHeatmap(posts, weeks, undefined, startDate);
const ui = getUiText(await getSiteConfig());
const statItems = stats ?? [
  { label: ui.heatmap.totalPosts, value: heatmap.totalPosts },
  { label: ui.heatmap.activeDays, value: heatmap.activeDays },
  { label: ui.heatmap.dayStreak, value: heatmap.currentStreak },
];
const heatmapLabel = startDate
  ? ui.heatmap.writingSince(heatmap.startDate)
  : ui.heatmap.recentWeeks(heatmap.weeks);

function getPostLabel(count: number) {
  return ui.heatmap.postCount(count);
}

function getDayTitle(day: HeatmapDay) {
  if (day.isFuture) return `${day.date}: ${ui.heatmap.upcoming}`;

  const titleLines = day.posts.slice(0, 5).map((post) => `- ${post.title}`);
  const overflowLine = day.posts.length > 5 ? ['...'] : [];

  return [`${day.date}: ${getPostLabel(day.count)}`, ...titleLines, ...overflowLine].join('\n');
}

function getDayHref(day: HeatmapDay) {
  if (dateArchiveBaseHref && day.count > 0) {
    return `${dateArchiveBaseHref.replace(/\/$/, '')}/${day.date}/`;
  }

  return day.posts[0]?.href;
}
---

<article class="glass-card heatmap-card">
  <div class="stats-row">
    {
      statItems.map((item) => (
        <div class="stat-item">
          <strong>{item.value}</strong>
          <span>{item.label}</span>
        </div>
      ))
    }
  </div>

  <div class="rhythm-grid" aria-label={heatmapLabel}>
    <div class="weekday-column" aria-hidden="true">
      {ui.heatmap.weekdays.map((weekday) => <span>{weekday}</span>)}
    </div>

    <div class="heatmap-cells" style={`--week-count: ${heatmap.weeks};`}>
      {
        heatmap.days.map((day) => {
          if (day.isFuture) {
            return <span class="heatmap-cell future-cell" aria-hidden="true" />;
          }

          const href = getDayHref(day);
          const content = (
            <span
              class={`heatmap-cell level-${day.level}`}
              title={getDayTitle(day)}
              aria-hidden="true"
            />
          );

          return href ? (
            <a class="cell-link" href={href} aria-label={getDayTitle(day)}>
              {content}
            </a>
          ) : (
            <span class="cell-link static-cell" role="img" aria-label={getDayTitle(day)}>
              {content}
            </span>
          );
        })
      }
    </div>
  </div>

  <footer>
    <span>{ui.heatmap.less}</span>
    {[0, 1, 2, 3, 4].map((level) => <i class={`heatmap-cell level-${level}`} />)}
    <span>{ui.heatmap.more}</span>
  </footer>
</article>

<style>
  .stats-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
  }

  .stat-item {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .stat-item strong {
    color: var(--paper-ink);
    font-size: 1.12rem;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .stat-item span {
    overflow: hidden;
    color: var(--paper-ink-soft);
    font-size: 0.72rem;
    line-height: 1.2;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .heatmap-card {
    display: grid;
    gap: 16px;
    padding: 20px;
    border-color: transparent;
    background: transparent;
    box-shadow: none;
    overflow: visible;
  }

  .heatmap-card:hover {
    border-color: transparent;
    box-shadow: none;
    transform: none;
  }

  .rhythm-grid {
    --cell-size: 8px;
    --cell-gap: 2.5px;
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr);
    gap: 8px;
    align-items: center;
    width: 100%;
    max-width: 100%;
    overflow: visible;
  }

  .weekday-column {
    display: grid;
    grid-template-rows: repeat(3, var(--cell-size));
    gap: calc(var(--cell-size) + var(--cell-gap));
    /* ink-soft：0.62rem 微字在两种主题下都要保住对比度 */
    color: var(--paper-ink-soft);
    font-size: 0.62rem;
    line-height: 1;
  }

  .heatmap-cells {
    display: grid;
    grid-auto-flow: column;
    grid-template-rows: repeat(7, var(--cell-size));
    grid-auto-columns: var(--cell-size);
    gap: var(--cell-gap);
    width: calc(
      (var(--cell-size) * var(--week-count)) + (var(--cell-gap) * (var(--week-count) - 1))
    );
    max-width: 100%;
  }

  .heatmap-cell,
  .cell-link {
    display: block;
    width: var(--cell-size);
    height: var(--cell-size);
    min-width: 8px;
    min-height: 8px;
  }

  .cell-link {
    position: relative;
    color: inherit;
    text-decoration: none;
  }

  /* 视觉保持 8px，命中区扩到 24px（target-size 达标，重叠区域按网格顺序取后者） */
  .cell-link::after {
    content: '';
    position: absolute;
    inset: -8px;
  }

  .cell-link:hover .heatmap-cell {
    outline: 1px solid var(--paper-line-strong);
    outline-offset: 1px;
  }

  .heatmap-cell {
    border-radius: 2.5px;
    background: rgba(102, 125, 109, 0.12);
    box-shadow: inset 0 0 0 1px var(--paper-line);
  }

  .future-cell {
    background: transparent;
    box-shadow: none;
  }

  .level-0 {
    background: rgba(102, 125, 109, 0.16);
  }

  .level-1 {
    background: #dce8dc;
  }

  .level-2 {
    background: #b9cbb9;
  }

  .level-3 {
    background: #8fa58f;
  }

  .level-4 {
    background: #667d6d;
  }

  footer {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--paper-ink-faint);
    font-size: 0.72rem;
  }

  footer .heatmap-cell {
    --cell-size: 9px;
  }

  @media (max-width: 1180px) and (min-width: 821px) {
    .rhythm-grid {
      --cell-size: 8px;
    }
  }

  @media (max-width: 820px) {
    .heatmap-card {
      gap: 14px;
      padding: 0;
      overflow: hidden;
    }

    .rhythm-grid {
      --cell-gap: 2.5px;
      grid-template-columns: 22px minmax(0, 1fr);
      overflow: hidden;
      width: 100%;
    }

    .heatmap-cells {
      grid-template-rows: repeat(7, auto);
      grid-auto-columns: minmax(0, 1fr);
      width: 100%;
      max-width: 360px;
    }

    .heatmap-cells .heatmap-cell,
    .heatmap-cells .cell-link {
      width: 100%;
      height: auto;
      min-width: 0;
      min-height: 0;
      aspect-ratio: 1;
    }

    .weekday-column {
      font-size: 0.58rem;
    }
  }
</style>
