---
import { getSiteConfig, getTopNavLinks } from '../data/site';
import HeaderLink from './HeaderLink.astro';
import Icon from './Icon.astro';

const { profile, site } = await getSiteConfig();
const links = await getTopNavLinks();
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');

function withBase(href: string) {
  if (href === '/') {
    return `${basePath}/` || '/';
  }

  return `${basePath}${href.startsWith('/') ? href : `/${href}`}`;
}
---

<header data-pagefind-ignore>
  <nav>
    <h2><a href={withBase('/')}>{site.title}</a></h2>
    <div class="internal-links">
      {links.map((link) => <HeaderLink href={link.href}>{link.label}</HeaderLink>)}
    </div>
    <div class="social-links">
      <a href={profile.website} target="_blank" rel="noreferrer">
        <span class="sr-only">Open website</span>
        <Icon name="compass" size={18} />
      </a>
      <a href={profile.github} target="_blank" rel="noreferrer">
        <span class="sr-only">Open GitHub profile</span>
        <Icon name="github" size={18} />
      </a>
      <a href={`mailto:${profile.email}`}>
        <span class="sr-only">Email</span>
        <Icon name="mail" size={18} />
      </a>
    </div>
  </nav>
</header>
<style>
  header {
    position: fixed;
    top: 0;
    right: 0;
    left: 0;
    z-index: 50;
    margin: 0;
    padding: 0 var(--layout-page-gutter, 1em);
    background: var(--paper-nav);
    border-bottom: 1px solid var(--paper-line);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.02);
  }
  h2 {
    flex: 0 0 auto;
    margin: 0;
    font-size: 1em;
  }

  h2 a,
  h2 a.active {
    display: inline-block;
    padding: 1em 0;
    text-decoration: none;
    white-space: nowrap;
  }
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 56px;
  }
  .internal-links {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .internal-links::-webkit-scrollbar {
    display: none;
  }
  nav a {
    padding: 1em 0.5em;
    color: var(--paper-ink);
    border-bottom: 2px solid transparent;
    text-decoration: none;
    white-space: nowrap;
  }
  nav a.active {
    text-decoration: none;
    border-bottom-color: var(--paper-accent);
  }
  .social-links,
  .social-links a {
    display: flex;
  }
  .social-links {
    flex: 0 0 auto;
  }
  .social-links a {
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
  }
  @media (max-width: 720px) {
    header {
      padding: 0 10px;
    }
    h2 {
      font-size: 0.92rem;
    }
    nav {
      gap: 8px;
    }
    nav a {
      padding: 0.9em 0.38em;
    }
    .social-links {
      display: none;
    }
  }
</style>
