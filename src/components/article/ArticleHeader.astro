---
import SmartImage from '../SmartImage.astro';
import FormattedDate from '../FormattedDate.astro';
import MetadataItem from '../MetadataItem.astro';
import { getSiteConfig } from '../../data/site';
import { slugifyGroupName } from '../../utils/content-groups';
import { getUiText } from '../../utils/ui-text';

type TagLink = string | { name: string; slug: string };

interface Props {
  title: string;
  description?: string;
  date?: Date;
  wordCount: number;
  readingTime: string;
  tags?: TagLink[];
  categories?: { name: string; slug: string }[];
  heroImage?: ImageMetadata | string;
  showHeroImage?: boolean;
  variant?: 'default' | 'archive';
  kicker?: string;
  note?: string;
}

const {
  title,
  description,
  date,
  wordCount,
  readingTime,
  tags = [],
  categories = [],
  heroImage,
  showHeroImage = true,
  variant = 'default',
  kicker = 'Notebook entry',
  note,
} = Astro.props;
const tagLinks = tags.map((tag) =>
  typeof tag === 'string' ? { name: tag, slug: slugifyGroupName(tag) } : tag,
);
const hasTags = tagLinks.length > 0;
const isArchiveHeader = variant === 'archive';
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const ui = getUiText(await getSiteConfig());
const wordCountLabel = ui.article.wordCount(wordCount);

const categoryGroups = categories.map((category) => ({
  name: category.name,
  href: `${basePath}/blog/categories/${category.slug}/`,
}));
const hasGroups = categoryGroups.length > 0;
---

<header
  class:list={[
    'article-header',
    { 'article-header-archive': isArchiveHeader, 'archive-header-shared': isArchiveHeader },
  ]}
>
  {
    isArchiveHeader ? (
      <>
        <div class="archive-heading archive-header-main">
          <p class="archive-kicker">{kicker}</p>
          <h1 class="archive-title" data-pagefind-meta="title">
            {title}
          </h1>
          <div class="meta-line" aria-label={ui.article.metadata}>
            {date && (
              <MetadataItem kind="date" separated={false}>
                <FormattedDate date={date} />
              </MetadataItem>
            )}
            <MetadataItem kind="words" separated={Boolean(date)}>
              {wordCountLabel}
            </MetadataItem>
            <MetadataItem kind="reading">{readingTime}</MetadataItem>
            {hasGroups && (
              <MetadataItem kind="categories" class="category-list" aria-label={ui.article.groups}>
                {categoryGroups.map((item) => (
                  <a class="category-link" href={item.href}>
                    {item.name}
                  </a>
                ))}
              </MetadataItem>
            )}
            {hasTags && (
              <MetadataItem kind="tags" class="tag-list">
                {tagLinks.map((tag) => (
                  <a class="tag" href={`${basePath}/blog/tags/${tag.slug}/`}>
                    #{tag.name}
                  </a>
                ))}
              </MetadataItem>
            )}
          </div>
        </div>
        {(description || note) && (
          <div class="archive-copy">
            {description && <p class="archive-subtitle">{description}</p>}
            {note && <p class="archive-note">{note}</p>}
          </div>
        )}
      </>
    ) : (
      <>
        <h1 data-pagefind-meta="title">{title}</h1>

        <div class="meta-line" aria-label={ui.article.metadata}>
          {date && (
            <MetadataItem kind="date" separated={false}>
              <FormattedDate date={date} />
            </MetadataItem>
          )}
          <MetadataItem kind="words" separated={Boolean(date)}>
            {wordCountLabel}
          </MetadataItem>
          <MetadataItem kind="reading">{readingTime}</MetadataItem>
          {hasGroups && (
            <MetadataItem kind="categories" class="category-list" aria-label={ui.article.groups}>
              {categoryGroups.map((item) => (
                <a class="category-link" href={item.href}>
                  {item.name}
                </a>
              ))}
            </MetadataItem>
          )}
          {hasTags && (
            <MetadataItem kind="tags" class="tag-list">
              {tagLinks.map((tag) => (
                <a class="tag" href={`${basePath}/blog/tags/${tag.slug}/`}>
                  #{tag.name}
                </a>
              ))}
            </MetadataItem>
          )}
        </div>
      </>
    )
  }

  {
    showHeroImage && heroImage && (
      <figure class="article-hero-image">
        <SmartImage width={1020} height={510} src={heroImage} alt="" />
      </figure>
    )
  }
</header>

<style>
  .article-header {
    display: grid;
    gap: 14px;
    width: 100%;
    max-width: var(--article-content-max, 720px);
    margin-bottom: 34px;
  }

  .article-header-archive {
    max-width: none;
    margin-bottom: 54px;
  }

  .archive-heading {
    min-width: 0;
  }

  h1 {
    margin: 0;
    color: var(--paper-ink);
    font-family: var(--font-heading);
    font-size: clamp(2.15rem, 4.8vw, 3.45rem);
    font-weight: 400;
    line-height: 1.08;
  }

  :global(.blog-content-ui) h1 {
    font-family: var(--font-page-heading);
  }

  .archive-heading .meta-line {
    margin-top: 14px;
  }

  .meta-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    row-gap: 6px;
    color: var(--paper-ink-faint);
    font-family: var(--font-meta);
    font-size: 0.84rem;
    font-weight: 600;
    line-height: 1.5;
  }

  /* 移动端 MetadataItem 会把 content 改成 inline（同权重的 data-astro-cid 规则），
     这里用更高优先级保持弹性布局，否则标签之间会粘在一起 */
  :global(.metadata-item.tag-list .metadata-content),
  :global(.metadata-item.category-list .metadata-content) {
    display: inline-flex;
    flex-wrap: wrap;
    column-gap: 8px;
    row-gap: 6px;
  }

  .tag {
    color: var(--paper-accent);
    font-family: var(--font-meta);
    font-weight: 700;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .tag:hover {
    color: var(--paper-ink);
  }

  .tag:focus-visible,
  .category-link:focus-visible {
    border-radius: 4px;
    outline: 2px solid var(--paper-line-strong);
    outline-offset: 3px;
  }

  .category-link {
    color: var(--paper-accent);
    font-family: var(--font-meta);
    font-weight: 700;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .category-link:hover {
    color: var(--paper-ink);
  }

  .category-link + .category-link::before {
    margin: 0 8px 0 0;
    color: var(--paper-ink-faint);
    content: '\00b7';
  }

  .article-hero-image {
    width: 100%;
    height: 84px;
    margin: 10px 0 0;
    overflow: hidden;
    border: 1px solid var(--paper-line);
    border-radius: 7px;
    background: var(--paper-surface-muted);
  }

  .article-hero-image :global(img) {
    display: block;
    width: 100%;
    height: 84px;
    object-fit: cover;
    border: 0;
    border-radius: 0;
    box-shadow: none;
    filter: saturate(0.72) contrast(0.96);
  }

  @media (max-width: 640px) {
    .article-header {
      gap: 12px;
      margin-bottom: 30px;
    }

    .article-header-archive {
      margin-bottom: 34px;
    }

    h1 {
      font-size: 2.08rem;
      line-height: 1.1;
    }

    .article-hero-image,
    .article-hero-image :global(img) {
      height: 84px;
      border-radius: 6px;
    }
  }
</style>
