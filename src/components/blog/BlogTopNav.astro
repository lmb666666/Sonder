---
import { ChevronDown, ListTree, Moon, Palette, Sun } from 'lucide-astro';
import SiteSearch from './SiteSearch.astro';
import TocTree from './TocTree.astro';
import { getRouteLabels, getSiteConfig, getTopNavLinks } from '../../data/site';
import { getUiText } from '../../utils/ui-text';
import type { TocItem } from '../../utils/toc-tree';

interface Props {
  showTocIcon?: boolean;
  tocItems?: TocItem[];
}

const { showTocIcon = false, tocItems = [] } = Astro.props;
const siteConfig = await getSiteConfig();
const { site, search, theme, profile } = siteConfig;
const ui = getUiText(siteConfig);
const links = await getTopNavLinks();
const navStyle = theme.navStyle;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPathname =
  basePath && Astro.url.pathname.startsWith(basePath)
    ? Astro.url.pathname.slice(basePath.length) || '/'
    : Astro.url.pathname;
const currentPath = currentPathname.replace(/\/$/, '') || '/';

function withBase(href: string) {
  if (href.startsWith('http') || href.startsWith('mailto:') || href.startsWith('#')) {
    return href;
  }

  if (href === '/') {
    return `${basePath}/` || '/';
  }

  return `${basePath}${href.startsWith('/') ? href : `/${href}`}`;
}

function isActive(href: string) {
  if (href.startsWith('http')) return false;

  const normalizedHref = href.replace(/\/$/, '') || '/';

  if (normalizedHref === '/') {
    return currentPath === '/';
  }

  return currentPath === normalizedHref || currentPath.startsWith(`${normalizedHref}/`);
}

const routeLabels = getRouteLabels();
const activeRoute = Object.entries(routeLabels).find(
  ([route]) => currentPath === route || currentPath.startsWith(`${route}/`),
);
const brandRouteLabel = activeRoute?.[1];
const shouldShowTocAction = showTocIcon && tocItems.length > 0;

// 控制面板可切换的色盘（与 palettes.css 的 data-palette 一一对应）
const paletteOptions = [
  { id: 'green-soft', label: ui.palette.greenSoft, accent: '#6b7d70', accentDark: '#a8baa9' },
  { id: 'green-vivid', label: ui.palette.greenVivid, accent: '#4e8a61', accentDark: '#93c9a1' },
  { id: 'rose-soft', label: ui.palette.roseSoft, accent: '#9b6b70', accentDark: '#d2a6ab' },
  { id: 'pink-soft', label: ui.palette.pinkSoft, accent: '#a66d8a', accentDark: '#d6a8c2' },
  {
    id: 'purple-soft',
    label: ui.palette.purpleSoft,
    accent: '#7b6fa8',
    accentDark: '#b9addd',
  },
  { id: 'blue-soft', label: ui.palette.blueSoft, accent: '#5b7488', accentDark: '#a4b6c6' },
  { id: 'orange-soft', label: ui.palette.orangeSoft, accent: '#9a7650', accentDark: '#d0b18a' },
  { id: 'brown-soft', label: ui.palette.brownSoft, accent: '#836f5d', accentDark: '#c3b09d' },
];
---

<header
  class:list={['blog-top-nav', `nav-${navStyle}`]}
  data-nav-style={navStyle}
  data-pagefind-ignore
  data-toc-open-label={ui.toc.open}
  data-toc-close-label={ui.toc.close}
  data-menu-open-label={ui.nav.openMenu}
  data-menu-close-label={ui.nav.closeMenu}
  data-palette-open-label={ui.nav.openPalette}
  data-palette-close-label={ui.nav.closePalette}
>
  <button
    class="mobile-menu-toggle"
    type="button"
    aria-label={ui.nav.openMenu}
    aria-expanded="false"
    aria-controls="mobile-nav-menu"
    data-mobile-menu-toggle
  >
    <span class="mobile-menu-label">{ui.nav.menu}</span>
    <ChevronDown class="mobile-menu-chevron" size={15} stroke-width={2} aria-hidden="true" />
  </button>

  {
    navStyle === 'pill' && currentPath === '/' && (
      <a
        class="nav-avatar-float"
        data-avatar-float
        href={withBase('/')}
        aria-label={`${site.title} 首页`}
      >
        <img src={profile.avatar} alt="" width="72" height="72" loading="eager" />
      </a>
    )
  }

  {
    navStyle === 'pill' ? (
      currentPath !== '/' && (
        <a
          class="nav-avatar"
          href={withBase('/')}
          aria-label={`${site.title} 首页`}
          transition:name="site-avatar"
        >
          <img src={profile.avatar} alt="" width="72" height="72" loading="eager" />
        </a>
      )
    ) : (
      <a class="brand" href={withBase('/')} aria-label={`Go to ${site.title} home`}>
        <span class="brand-mark" aria-hidden="true" />
        <span class="brand-title">
          <span>{site.title}</span>
          {brandRouteLabel && <span class="brand-route"> · {brandRouteLabel}</span>}
        </span>
      </a>
    )
  }

  <nav class="nav-links" aria-label="Article navigation">
    {
      links.map((link) =>
        link.disabled ? (
          <span
            class="nav-link nav-link-placeholder"
            aria-disabled="true"
            title="Projects content placeholder"
          >
            {link.label}
          </span>
        ) : (
          <a class:list={['nav-link', { active: isActive(link.href) }]} href={withBase(link.href)}>
            {link.label}
          </a>
        ),
      )
    }
  </nav>

  <nav
    class="mobile-menu-panel"
    id="mobile-nav-menu"
    aria-label={ui.nav.mobileNav}
    data-mobile-menu
  >
    <div class="mobile-menu-links">
      {
        links.map((link) =>
          link.disabled ? (
            <span class="mobile-menu-link mobile-menu-placeholder" aria-disabled="true">
              {link.label}
            </span>
          ) : (
            <a
              class:list={['mobile-menu-link', { active: isActive(link.href) }]}
              href={withBase(link.href)}
              data-mobile-menu-link
            >
              {link.label}
            </a>
          ),
        )
      }
    </div>

    <div class="mobile-menu-appearance">
      <p class="mobile-menu-section-title">{ui.nav.appearance}</p>
      <div class="mobile-theme-switch" role="group" aria-label={ui.nav.themeMode}>
        <button
          type="button"
          class="mobile-theme-option"
          data-mobile-theme-option="light"
          aria-pressed="false"
        >
          <Sun size={15} stroke-width={2} aria-hidden="true" />
          {ui.nav.light}
        </button>
        <button
          type="button"
          class="mobile-theme-option"
          data-mobile-theme-option="dark"
          aria-pressed="false"
        >
          <Moon size={15} stroke-width={2} aria-hidden="true" />
          {ui.nav.dark}
        </button>
      </div>

      <p class="mobile-menu-section-title">{ui.nav.accentColor}</p>
      <div class="mobile-palette-grid" role="group" aria-label={ui.nav.accentColor}>
        {
          paletteOptions.map((option) => (
            <button
              type="button"
              class="mobile-palette-option"
              data-palette-option={option.id}
              aria-label={option.label}
              aria-pressed="false"
            >
              <span
                class="palette-dot"
                aria-hidden="true"
                style={`--swatch-light: ${option.accent}; --swatch-dark: ${option.accentDark};`}
              />
              {option.label}
            </button>
          ))
        }
      </div>
    </div>
  </nav>

  <div class="nav-actions" aria-label="Page actions">
    <button
      type="button"
      data-palette-toggle
      aria-label={ui.nav.openPalette}
      aria-expanded="false"
      aria-controls="nav-palette-panel"
      title={ui.nav.accentColor}
    >
      <Palette size={17} stroke-width={2} />
    </button>
    <button type="button" data-theme-toggle aria-label="Switch theme">
      <Moon class="theme-icon-moon" size={17} stroke-width={2} />
      <Sun class="theme-icon-sun" size={17} stroke-width={2} />
    </button>
    {search.enabled && <SiteSearch search={search} />}
    {
      shouldShowTocAction && (
        <button
          class="toc-action"
          type="button"
          aria-label={ui.toc.open}
          aria-expanded="false"
          aria-controls="mobile-toc-menu"
          title={ui.toc.title}
          data-mobile-toc-trigger
        >
          <ListTree size={17} stroke-width={2} />
        </button>
      )
    }
  </div>

  <div
    class="palette-panel"
    id="nav-palette-panel"
    role="group"
    aria-label={ui.nav.accentColor}
    data-palette-panel
  >
    <p class="palette-panel-title">{ui.nav.accentColor}</p>
    <div class="palette-options">
      {
        paletteOptions.map((option) => (
          <button
            type="button"
            class="palette-option"
            data-palette-option={option.id}
            aria-pressed="false"
          >
            <span
              class="palette-dot"
              aria-hidden="true"
              style={`--swatch-light: ${option.accent}; --swatch-dark: ${option.accentDark};`}
            />
            <span class="palette-label">{option.label}</span>
          </button>
        ))
      }
    </div>
  </div>

  {
    shouldShowTocAction && (
      <nav
        class="mobile-toc-panel"
        id="mobile-toc-menu"
        aria-label={ui.toc.title}
        data-nav-toc-menu
        data-toc-root
        data-toc-scroll
      >
        <p>{ui.toc.title}</p>
        <TocTree items={tocItems} idPrefix="nav-toc" navLink />
      </nav>
    )
  }
</header>

<script>
  let navigationSequence = 0;
  let activeNavigationId = 0;

  // 视图过渡会替换整个导航 DOM：旧元素上的监听随元素一起消失，
  // 但挂在 window/document 上的监听必须显式回收，否则每次换页都会堆积。
  // 按所属元素登记，只在元素已脱离文档（旧页面）时回收，当前页的绑定保持不动。
  const navListenerDisposers = new Map<Element, Array<() => void>>();

  const registerNavListeners = (owner: Element, disposers: Array<() => void>) => {
    const existing = navListenerDisposers.get(owner) ?? [];
    navListenerDisposers.set(owner, [...existing, ...disposers]);
  };

  const disposeStaleNavListeners = () => {
    for (const [owner, disposers] of navListenerDisposers) {
      if (owner.isConnected) {
        continue;
      }

      for (const dispose of disposers) {
        dispose();
      }
      navListenerDisposers.delete(owner);
    }
  };

  const clearPendingNavigation = (navigationId?: number) => {
    if (navigationId && navigationId !== activeNavigationId) {
      return;
    }

    for (const header of document.querySelectorAll<HTMLElement>('.blog-top-nav')) {
      delete header.dataset.navPending;
      header.removeAttribute('aria-busy');

      for (const link of header.querySelectorAll<HTMLElement>('[data-nav-link-pending]')) {
        delete link.dataset.navLinkPending;
      }
    }

    activeNavigationId = 0;
  };

  const startPendingNavigation = (sourceElement?: Element) => {
    const sourceLink = sourceElement?.closest<HTMLAnchorElement>('.blog-top-nav a[href]');

    if (!sourceLink) {
      return 0;
    }

    const navigationId = ++navigationSequence;
    const pendingHref = sourceLink.href;
    activeNavigationId = navigationId;

    for (const header of document.querySelectorAll<HTMLElement>('.blog-top-nav')) {
      header.dataset.navPending = 'true';
      header.setAttribute('aria-busy', 'true');

      for (const link of header.querySelectorAll<HTMLAnchorElement>('a[href]')) {
        link.toggleAttribute('data-nav-link-pending', link.href === pendingHref);
      }
    }

    return navigationId;
  };

  const initMobileTopNav = () => {
    for (const header of document.querySelectorAll<HTMLElement>('.blog-top-nav')) {
      const toggle = header.querySelector<HTMLButtonElement>('[data-mobile-menu-toggle]');
      const menu = header.querySelector<HTMLElement>('[data-mobile-menu]');
      const tocTrigger = header.querySelector<HTMLButtonElement>('[data-mobile-toc-trigger]');
      const tocMenu = header.querySelector<HTMLElement>('[data-nav-toc-menu]');

      if (!header.dataset.scrollHideReady) {
        header.dataset.scrollHideReady = 'true';

        const topRevealOffset = 24;
        // 首页有浮动头像时，先让头像停靠进导航，再允许导航隐藏
        const hideAfterOffset = document.querySelector('[data-avatar-float]') ? 200 : 96;
        const scrollIntentDelta = 8;
        let lastScrollY = window.scrollY;

        const setNavHidden = (hidden: boolean) => {
          header.dataset.navHidden = hidden ? 'true' : 'false';
          header.toggleAttribute('inert', hidden);
          header.toggleAttribute('aria-hidden', hidden);

          // 首页浮动头像随导航一起隐藏/出现
          const floatAvatar = document.querySelector<HTMLElement>('[data-avatar-float]');
          if (floatAvatar) {
            if (hidden) {
              floatAvatar.dataset.navHidden = 'true';
            } else {
              delete floatAvatar.dataset.navHidden;
            }
            floatAvatar.toggleAttribute('inert', hidden);
            floatAvatar.toggleAttribute('aria-hidden', hidden);
          }
        };

        const shouldKeepVisible = () =>
          window.scrollY <= topRevealOffset ||
          header.dataset.mobileMenuOpen === 'true' ||
          header.dataset.mobileTocOpen === 'true' ||
          header.matches(':focus-within');

        const updateNavVisibility = () => {
          const currentScrollY = window.scrollY;
          const scrollDelta = currentScrollY - lastScrollY;

          if (shouldKeepVisible()) {
            setNavHidden(false);
            lastScrollY = currentScrollY;
            return;
          }

          if (Math.abs(scrollDelta) < scrollIntentDelta) {
            return;
          }

          setNavHidden(scrollDelta > 0 && currentScrollY > hideAfterOffset);
          lastScrollY = currentScrollY;
        };

        const onWindowScroll = () => {
          updateNavVisibility();
        };

        const onWindowResize = () => {
          if (window.scrollY <= topRevealOffset) {
            setNavHidden(false);
          }
        };

        window.addEventListener('scroll', onWindowScroll, { passive: true });
        window.addEventListener('resize', onWindowResize);
        registerNavListeners(header, [
          () => {
            window.removeEventListener('scroll', onWindowScroll);
            window.removeEventListener('resize', onWindowResize);
          },
        ]);

        setNavHidden(false);
      }

      if (toggle && menu && !header.dataset.mobileMenuReady) {
        header.dataset.mobileMenuReady = 'true';

        const setMenuOpen = (open: boolean) => {
          const openLabel = header.dataset.menuOpenLabel ?? 'Open navigation menu';
          const closeLabel = header.dataset.menuCloseLabel ?? 'Close navigation menu';

          header.dataset.mobileMenuOpen = open ? 'true' : 'false';
          toggle.setAttribute('aria-expanded', String(open));
          toggle.setAttribute('aria-label', open ? closeLabel : openLabel);
          header.dispatchEvent(new CustomEvent('navfolio:menu-toggle'));
        };
        const setTocOpen = (open: boolean) => {
          if (!tocTrigger || !tocMenu) {
            return;
          }

          const tocOpenLabel = header.dataset.tocOpenLabel ?? 'Open table of contents';
          const tocCloseLabel = header.dataset.tocCloseLabel ?? 'Close table of contents';

          header.dataset.mobileTocOpen = open ? 'true' : 'false';
          tocTrigger.setAttribute('aria-expanded', String(open));
          tocTrigger.setAttribute('aria-label', open ? tocCloseLabel : tocOpenLabel);
        };

        toggle.addEventListener('click', () => {
          const nextOpen = header.dataset.mobileMenuOpen !== 'true';
          setMenuOpen(nextOpen);
          header.dataset.navHidden = 'false';
          if (nextOpen) {
            setTocOpen(false);
          }
        });

        menu.addEventListener('click', (event) => {
          if ((event.target as Element).closest?.('[data-mobile-menu-link]')) {
            setMenuOpen(false);
          }
        });

        tocTrigger?.addEventListener('click', () => {
          const nextOpen = header.dataset.mobileTocOpen !== 'true';
          setTocOpen(nextOpen);
          header.dataset.navHidden = 'false';
          if (nextOpen) {
            setMenuOpen(false);
          }
        });

        tocMenu?.addEventListener('click', (event) => {
          if ((event.target as Element).closest?.('[data-nav-toc-link]')) {
            setTocOpen(false);
          }
        });

        const onDocumentClick = (event: MouseEvent) => {
          if (!header.contains(event.target as Node)) {
            setMenuOpen(false);
            setTocOpen(false);
          }
        };

        const onDocumentKeydown = (event: KeyboardEvent) => {
          if (event.key === 'Escape') {
            setMenuOpen(false);
            setTocOpen(false);
          }
        };

        document.addEventListener('click', onDocumentClick);
        document.addEventListener('keydown', onDocumentKeydown);
        registerNavListeners(header, [
          () => {
            document.removeEventListener('click', onDocumentClick);
            document.removeEventListener('keydown', onDocumentKeydown);
          },
        ]);
      }

      if (!header.dataset.paletteReady) {
        header.dataset.paletteReady = 'true';

        const paletteToggle = header.querySelector<HTMLButtonElement>('[data-palette-toggle]');
        const palettePanel = header.querySelector<HTMLElement>('[data-palette-panel]');
        const storageKey = 'navfolio-palette';
        const knownPalettes = new Set(
          [...header.querySelectorAll('[data-palette-option]')].map(
            (option) => option.getAttribute('data-palette-option') ?? '',
          ),
        );

        const applyMetaThemeColor = () => {
          const color = getComputedStyle(document.documentElement)
            .getPropertyValue('--paper-theme-color')
            .trim();
          if (!color) return;
          document.querySelector('meta[name="theme-color"]')?.setAttribute('content', color);
        };

        const setPaletteOpen = (open: boolean) => {
          if (!paletteToggle || !palettePanel) return;

          const openLabel = header.dataset.paletteOpenLabel ?? 'Open accent color panel';
          const closeLabel = header.dataset.paletteCloseLabel ?? 'Close accent color panel';

          header.dataset.paletteOpen = open ? 'true' : 'false';
          paletteToggle.setAttribute('aria-expanded', String(open));
          paletteToggle.setAttribute('aria-label', open ? closeLabel : openLabel);
        };

        const syncActiveOption = () => {
          const current = document.documentElement.dataset.palette ?? '';
          for (const option of header.querySelectorAll<HTMLButtonElement>(
            '[data-palette-option]',
          )) {
            const active = option.getAttribute('data-palette-option') === current;
            option.setAttribute('aria-pressed', String(active));
            option.classList.toggle('active', active);
          }
        };

        const readStoredPalette = () => {
          try {
            return localStorage.getItem(storageKey);
          } catch {
            return null;
          }
        };

        // 恢复持久化选择（早期脚本已应用，这里兜底同步选中态）
        const stored = readStoredPalette();
        if (stored && knownPalettes.has(stored)) {
          document.documentElement.dataset.palette = stored;
        }
        syncActiveOption();

        paletteToggle?.addEventListener('click', () => {
          const nextOpen = header.dataset.paletteOpen !== 'true';
          setPaletteOpen(nextOpen);
          header.dataset.navHidden = 'false';
          if (nextOpen) {
            // 与移动端菜单/目录互斥
            header.dataset.mobileMenuOpen = 'false';
            header.dataset.mobileTocOpen = 'false';
            header
              .querySelector('[data-mobile-menu-toggle]')
              ?.setAttribute('aria-expanded', 'false');
            header
              .querySelector('[data-mobile-toc-trigger]')
              ?.setAttribute('aria-expanded', 'false');
          }
        });

        // 色盘按钮同时出现在桌面面板与移动端菜单，统一在 header 上委托
        header.addEventListener('click', (event) => {
          const option = (event.target as Element).closest<HTMLButtonElement>(
            '[data-palette-option]',
          );
          if (!option) return;
          const palette = option.getAttribute('data-palette-option');
          if (!palette) return;
          document.documentElement.dataset.palette = palette;
          try {
            localStorage.setItem(storageKey, palette);
          } catch {
            // 存储不可用时仍允许本次切换生效
          }
          applyMetaThemeColor();
          syncActiveOption();
        });

        const onPaletteDocumentClick = (event: MouseEvent) => {
          if (header.dataset.paletteOpen === 'true' && !header.contains(event.target as Node)) {
            setPaletteOpen(false);
          }
        };

        const onPaletteDocumentKeydown = (event: KeyboardEvent) => {
          if (event.key === 'Escape' && header.dataset.paletteOpen === 'true') {
            setPaletteOpen(false);
          }
        };

        document.addEventListener('click', onPaletteDocumentClick);
        document.addEventListener('keydown', onPaletteDocumentKeydown);
        registerNavListeners(header, [
          () => {
            document.removeEventListener('click', onPaletteDocumentClick);
            document.removeEventListener('keydown', onPaletteDocumentKeydown);
          },
        ]);
      }

      if (!header.dataset.appearanceReady) {
        header.dataset.appearanceReady = 'true';

        const themeOptions = [
          ...header.querySelectorAll<HTMLButtonElement>('[data-mobile-theme-option]'),
        ];
        const themeApi = (
          window as Window & { __navfolioTheme?: { set?: (theme: string) => void } }
        ).__navfolioTheme;

        const syncThemeOptions = () => {
          const current = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';

          for (const option of themeOptions) {
            const active = option.dataset.mobileThemeOption === current;
            option.setAttribute('aria-pressed', String(active));
            option.classList.toggle('active', active);
          }
        };

        for (const option of themeOptions) {
          option.addEventListener('click', () => {
            const theme = option.dataset.mobileThemeOption;
            if (theme !== 'light' && theme !== 'dark') {
              return;
            }

            themeApi?.set?.(theme);
            syncThemeOptions();
          });
        }

        const onThemeChange = () => syncThemeOptions();
        window.addEventListener('navfolio:theme-change', onThemeChange);
        registerNavListeners(header, [
          () => window.removeEventListener('navfolio:theme-change', onThemeChange),
        ]);

        syncThemeOptions();
      }
    }
  };

  // 首页浮动头像：随滚动在内容区（64px）与导航（36px）之间连续移动
  const initFloatingAvatar = () => {
    const floatAvatar = document.querySelector<HTMLElement>('[data-avatar-float]');
    if (!floatAvatar || floatAvatar.dataset.avatarReady === 'true') {
      return;
    }
    floatAvatar.dataset.avatarReady = 'true';

    const slot = document.querySelector<HTMLElement>('[data-avatar-slot]');
    const header = document.querySelector<HTMLElement>('.blog-top-nav');
    const dockSize = 36;
    let slotTop = 0;
    let slotLeft = 20;
    let baseSize = 64;
    let headerTop = 0;
    let headerLeft = 0;
    let dockOffsetY = 0;
    let lastMenuOpen = header?.dataset.mobileMenuOpen === 'true';
    let menuTransitionTimer: number | undefined;

    const measure = () => {
      if (slot) {
        const rect = slot.getBoundingClientRect();
        slotTop = rect.top + window.scrollY;
        slotLeft = rect.left;
        baseSize = rect.width || 64;
      }

      if (!header) {
        return;
      }

      // 以导航栏自身为坐标系：停靠点就是导航栏左缘、与操作区同一基线
      const rect = header.getBoundingClientRect();
      headerTop = rect.top;
      headerLeft = rect.left;
      const anchor = header.querySelector('.mobile-menu-toggle');
      const anchorRect = anchor ? anchor.getBoundingClientRect() : rect;
      dockOffsetY = anchorRect.top + (anchorRect.height - dockSize) / 2 - rect.top;
    };

    const update = () => {
      if (!header) {
        return;
      }

      const menuOpen = header.dataset.mobileMenuOpen === 'true';
      if (menuOpen !== lastMenuOpen) {
        lastMenuOpen = menuOpen;
        floatAvatar.style.transition = 'transform 220ms ease, width 180ms ease, height 180ms ease';
        window.clearTimeout(menuTransitionTimer);
        menuTransitionTimer = window.setTimeout(() => {
          floatAvatar.style.transition = '';
        }, 260);
      }

      // 菜单展开时把首页头像停靠进导航左缘，避免被弹出面板遮住
      if (menuOpen) {
        floatAvatar.style.width = `${dockSize}px`;
        floatAvatar.style.height = `${dockSize}px`;
        floatAvatar.style.transform = `translate3d(0, ${dockOffsetY}px, 0)`;
        floatAvatar.style.visibility = 'visible';
        return;
      }

      const scrollY = window.scrollY;
      const dockAbsY = headerTop + dockOffsetY;
      const travel = Math.max(1, slotTop - dockAbsY);
      // 缩放区间等于「从内容位走到导航位」的距离
      const progress = Math.min(1, Math.max(0, scrollY / travel));
      const size = baseSize + (dockSize - baseSize) * progress;
      const yAbs = Math.max(dockAbsY, slotTop - scrollY);
      // 横向从内容列左缘过渡到导航栏左缘（两者本就接近，收拢到同一列）
      const startX = slotLeft - headerLeft;
      const x = startX * (1 - progress);
      const y = yAbs - headerTop;

      floatAvatar.style.width = `${size}px`;
      floatAvatar.style.height = `${size}px`;
      floatAvatar.style.transform = `translate3d(${x}px, ${y}px, 0)`;
      floatAvatar.style.visibility = 'visible';
    };

    // 点击导航栏里的头像胶囊：回到顶部（头像随之回到内容区）
    const homePath = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

    floatAvatar.addEventListener('click', (event) => {
      if (window.location.pathname.replace(/\/$/, '') !== homePath) {
        return;
      }

      event.preventDefault();
      const startY = window.scrollY;
      window.scrollTo({ top: 0, behavior: 'smooth' });

      // 平滑滚动被浏览器忽略时兜底回顶
      window.setTimeout(() => {
        if (window.scrollY >= startY) {
          window.scrollTo(0, 0);
        }
      }, 500);
    });

    const remeasure = () => {
      measure();
      update();
    };

    const onMenuToggle = () => update();
    header?.addEventListener('navfolio:menu-toggle', onMenuToggle);

    measure();
    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', remeasure);
    // 字体/图片加载后内容高度可能变化，重新测量一次内容位
    window.addEventListener('load', remeasure, { once: true });
    registerNavListeners(floatAvatar, [
      () => {
        header?.removeEventListener('navfolio:menu-toggle', onMenuToggle);
        window.clearTimeout(menuTransitionTimer);
        window.removeEventListener('scroll', update);
        window.removeEventListener('resize', remeasure);
        window.removeEventListener('load', remeasure);
      },
    ]);
  };

  disposeStaleNavListeners();
  initMobileTopNav();
  initFloatingAvatar();
  document.addEventListener('astro:before-preparation', (event) => {
    const navigationId = startPendingNavigation(event.sourceElement);

    if (!navigationId) {
      return;
    }

    const loadPage = event.loader;

    event.loader = async () => {
      try {
        await loadPage();

        if (event.signal.aborted) {
          clearPendingNavigation(navigationId);
        }
      } catch (error) {
        clearPendingNavigation(navigationId);
        throw error;
      }
    };
  });
  document.addEventListener('astro:after-swap', () => clearPendingNavigation());
  document.addEventListener('astro:page-load', () => {
    // 新页面已替换整个导航 DOM，先回收上一页挂在 window/document 上的监听
    disposeStaleNavListeners();
    initMobileTopNav();
    initFloatingAvatar();
  });
</script>

