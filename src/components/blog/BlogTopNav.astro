---
import { ListTree, Menu, Moon, Palette, Sun } from 'lucide-astro';
import SiteSearch from './SiteSearch.astro';
import TocTree from './TocTree.astro';
import { getRouteLabels, getSiteConfig, getTopNavLinks } from '../../data/site';
import { getUiText } from '../../utils/ui-text';
import type { TocItem } from '../../utils/toc-tree';

interface Props {
  showTocIcon?: boolean;
  tocItems?: TocItem[];
}

const { showTocIcon = false, tocItems = [] } = Astro.props;
const siteConfig = await getSiteConfig();
const { site, search, theme, profile } = siteConfig;
const ui = getUiText(siteConfig);
const links = await getTopNavLinks();
const navStyle = theme.navStyle;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPathname =
  basePath && Astro.url.pathname.startsWith(basePath)
    ? Astro.url.pathname.slice(basePath.length) || '/'
    : Astro.url.pathname;
const currentPath = currentPathname.replace(/\/$/, '') || '/';

function withBase(href: string) {
  if (href.startsWith('http') || href.startsWith('mailto:') || href.startsWith('#')) {
    return href;
  }

  if (href === '/') {
    return `${basePath}/` || '/';
  }

  return `${basePath}${href.startsWith('/') ? href : `/${href}`}`;
}

function isActive(href: string) {
  if (href.startsWith('http')) return false;

  const normalizedHref = href.replace(/\/$/, '') || '/';

  if (normalizedHref === '/') {
    return currentPath === '/';
  }

  return currentPath === normalizedHref || currentPath.startsWith(`${normalizedHref}/`);
}

const routeLabels = getRouteLabels();
const activeRoute = Object.entries(routeLabels).find(
  ([route]) => currentPath === route || currentPath.startsWith(`${route}/`),
);
const brandRouteLabel = activeRoute?.[1];
const shouldShowTocAction = showTocIcon && tocItems.length > 0;

// 控制面板可切换的色盘（与 palettes.css 的 data-palette 一一对应）
const paletteOptions = [
  { id: 'green-soft', label: '苔绿', accent: '#6b7d70', accentDark: '#a8baa9' },
  { id: 'green-vivid', label: '叶绿', accent: '#4e8a61', accentDark: '#93c9a1' },
  { id: 'rose-soft', label: '玫瑰', accent: '#9b6b70', accentDark: '#d2a6ab' },
  { id: 'pink-soft', label: '樱粉', accent: '#a66d8a', accentDark: '#d6a8c2' },
  { id: 'purple-soft', label: '薰衣草', accent: '#7b6fa8', accentDark: '#b9addd' },
  { id: 'blue-soft', label: '墨蓝', accent: '#5b7488', accentDark: '#a4b6c6' },
  { id: 'orange-soft', label: '暖橙', accent: '#9a7650', accentDark: '#d0b18a' },
  { id: 'brown-soft', label: '棕褐', accent: '#836f5d', accentDark: '#c3b09d' },
];
---

<header
  class:list={['blog-top-nav', `nav-${navStyle}`]}
  data-nav-style={navStyle}
  data-pagefind-ignore
  data-toc-open-label={ui.toc.open}
  data-toc-close-label={ui.toc.close}
>
  <button
    class="mobile-menu-toggle"
    type="button"
    aria-label="Open navigation menu"
    aria-expanded="false"
    aria-controls="mobile-nav-menu"
    data-mobile-menu-toggle
  >
    <Menu size={18} stroke-width={2} />
  </button>

  {
    navStyle === 'pill' ? (
      currentPath !== '/' && (
        <a
          class="nav-avatar"
          href={withBase('/')}
          aria-label={`${site.title} 首页`}
          transition:name="site-avatar"
        >
          <img src={profile.avatar} alt="" width="72" height="72" loading="eager" />
        </a>
      )
    ) : (
      <a class="brand" href={withBase('/')} aria-label={`Go to ${site.title} home`}>
        <span class="brand-mark" aria-hidden="true" />
        <span class="brand-title">
          <span>{site.title}</span>
          {brandRouteLabel && <span class="brand-route"> · {brandRouteLabel}</span>}
        </span>
      </a>
    )
  }

  <nav class="nav-links" aria-label="Article navigation">
    {
      links.map((link) =>
        link.disabled ? (
          <span
            class="nav-link nav-link-placeholder"
            aria-disabled="true"
            title="Projects content placeholder"
          >
            {link.label}
          </span>
        ) : (
          <a class:list={['nav-link', { active: isActive(link.href) }]} href={withBase(link.href)}>
            {link.label}
          </a>
        ),
      )
    }
  </nav>

  <nav
    class="mobile-menu-panel"
    id="mobile-nav-menu"
    aria-label="Mobile navigation"
    data-mobile-menu
  >
    {
      links.map((link) =>
        link.disabled ? (
          <span class="mobile-menu-link mobile-menu-placeholder" aria-disabled="true">
            {link.label}
          </span>
        ) : (
          <a
            class:list={['mobile-menu-link', { active: isActive(link.href) }]}
            href={withBase(link.href)}
            data-mobile-menu-link
          >
            {link.label}
          </a>
        ),
      )
    }
  </nav>

  <div class="nav-actions" aria-label="Page actions">
    <button
      type="button"
      data-palette-toggle
      aria-label="打开主题色面板"
      aria-expanded="false"
      aria-controls="nav-palette-panel"
      title="主题色"
    >
      <Palette size={17} stroke-width={2} />
    </button>
    <button type="button" data-theme-toggle aria-label="Switch theme">
      <Moon class="theme-icon-moon" size={17} stroke-width={2} />
      <Sun class="theme-icon-sun" size={17} stroke-width={2} />
    </button>
    {search.enabled && <SiteSearch search={search} />}
    {
      shouldShowTocAction && (
        <button
          class="toc-action"
          type="button"
          aria-label={ui.toc.open}
          aria-expanded="false"
          aria-controls="mobile-toc-menu"
          title={ui.toc.title}
          data-mobile-toc-trigger
        >
          <ListTree size={17} stroke-width={2} />
        </button>
      )
    }
  </div>

  <div
    class="palette-panel"
    id="nav-palette-panel"
    role="group"
    aria-label="主题色"
    data-palette-panel
  >
    <p class="palette-panel-title">主题色</p>
    <div class="palette-options">
      {
        paletteOptions.map((option) => (
          <button
            type="button"
            class="palette-option"
            data-palette-option={option.id}
            aria-pressed="false"
          >
            <span
              class="palette-dot"
              aria-hidden="true"
              style={`--swatch-light: ${option.accent}; --swatch-dark: ${option.accentDark};`}
            />
            <span class="palette-label">{option.label}</span>
          </button>
        ))
      }
    </div>
  </div>

  {
    shouldShowTocAction && (
      <nav
        class="mobile-toc-panel"
        id="mobile-toc-menu"
        aria-label={ui.toc.title}
        data-nav-toc-menu
        data-toc-root
        data-toc-scroll
      >
        <p>{ui.toc.title}</p>
        <TocTree items={tocItems} idPrefix="nav-toc" navLink />
      </nav>
    )
  }
</header>

<script>
  let navigationSequence = 0;
  let activeNavigationId = 0;

  const clearPendingNavigation = (navigationId?: number) => {
    if (navigationId && navigationId !== activeNavigationId) {
      return;
    }

    for (const header of document.querySelectorAll<HTMLElement>('.blog-top-nav')) {
      delete header.dataset.navPending;
      header.removeAttribute('aria-busy');

      for (const link of header.querySelectorAll<HTMLElement>('[data-nav-link-pending]')) {
        delete link.dataset.navLinkPending;
      }
    }

    activeNavigationId = 0;
  };

  const startPendingNavigation = (sourceElement?: Element) => {
    const sourceLink = sourceElement?.closest<HTMLAnchorElement>('.blog-top-nav a[href]');

    if (!sourceLink) {
      return 0;
    }

    const navigationId = ++navigationSequence;
    const pendingHref = sourceLink.href;
    activeNavigationId = navigationId;

    for (const header of document.querySelectorAll<HTMLElement>('.blog-top-nav')) {
      header.dataset.navPending = 'true';
      header.setAttribute('aria-busy', 'true');

      for (const link of header.querySelectorAll<HTMLAnchorElement>('a[href]')) {
        link.toggleAttribute('data-nav-link-pending', link.href === pendingHref);
      }
    }

    return navigationId;
  };

  const initMobileTopNav = () => {
    for (const header of document.querySelectorAll<HTMLElement>('.blog-top-nav')) {
      const toggle = header.querySelector<HTMLButtonElement>('[data-mobile-menu-toggle]');
      const menu = header.querySelector<HTMLElement>('[data-mobile-menu]');
      const tocTrigger = header.querySelector<HTMLButtonElement>('[data-mobile-toc-trigger]');
      const tocMenu = header.querySelector<HTMLElement>('[data-nav-toc-menu]');

      if (!header.dataset.scrollHideReady) {
        header.dataset.scrollHideReady = 'true';

        const topRevealOffset = 24;
        const hideAfterOffset = 96;
        const scrollIntentDelta = 8;
        let lastScrollY = window.scrollY;
        let scrollFrame = 0;

        const setNavHidden = (hidden: boolean) => {
          header.dataset.navHidden = hidden ? 'true' : 'false';

          // 胶囊模式只收起导航与操作区，头像始终可用
          if (header.dataset.navStyle === 'pill') {
            for (const el of header.querySelectorAll(
              '.nav-links, .nav-actions, .mobile-menu-toggle',
            )) {
              el.toggleAttribute('inert', hidden);
              el.toggleAttribute('aria-hidden', hidden);
            }
            return;
          }

          header.toggleAttribute('inert', hidden);
          header.toggleAttribute('aria-hidden', hidden);
        };

        const shouldKeepVisible = () =>
          window.scrollY <= topRevealOffset ||
          header.dataset.mobileMenuOpen === 'true' ||
          header.dataset.mobileTocOpen === 'true' ||
          header.matches(':focus-within');

        const updateNavVisibility = () => {
          scrollFrame = 0;
          const currentScrollY = window.scrollY;
          const scrollDelta = currentScrollY - lastScrollY;

          if (shouldKeepVisible()) {
            setNavHidden(false);
            lastScrollY = currentScrollY;
            return;
          }

          if (Math.abs(scrollDelta) < scrollIntentDelta) {
            return;
          }

          setNavHidden(scrollDelta > 0 && currentScrollY > hideAfterOffset);
          lastScrollY = currentScrollY;
        };

        window.addEventListener(
          'scroll',
          () => {
            if (scrollFrame) {
              return;
            }

            scrollFrame = window.requestAnimationFrame(updateNavVisibility);
          },
          { passive: true },
        );

        window.addEventListener('resize', () => {
          if (window.scrollY <= topRevealOffset) {
            setNavHidden(false);
          }
        });

        setNavHidden(false);
      }

      if (toggle && menu && !header.dataset.mobileMenuReady) {
        header.dataset.mobileMenuReady = 'true';

        const setMenuOpen = (open: boolean) => {
          header.dataset.mobileMenuOpen = open ? 'true' : 'false';
          toggle.setAttribute('aria-expanded', String(open));
          toggle.setAttribute(
            'aria-label',
            open ? 'Close navigation menu' : 'Open navigation menu',
          );
        };
        const setTocOpen = (open: boolean) => {
          if (!tocTrigger || !tocMenu) {
            return;
          }

          const tocOpenLabel = header.dataset.tocOpenLabel ?? 'Open table of contents';
          const tocCloseLabel = header.dataset.tocCloseLabel ?? 'Close table of contents';

          header.dataset.mobileTocOpen = open ? 'true' : 'false';
          tocTrigger.setAttribute('aria-expanded', String(open));
          tocTrigger.setAttribute('aria-label', open ? tocCloseLabel : tocOpenLabel);
        };

        toggle.addEventListener('click', () => {
          const nextOpen = header.dataset.mobileMenuOpen !== 'true';
          setMenuOpen(nextOpen);
          header.dataset.navHidden = 'false';
          if (nextOpen) {
            setTocOpen(false);
          }
        });

        menu.addEventListener('click', (event) => {
          if ((event.target as Element).closest?.('[data-mobile-menu-link]')) {
            setMenuOpen(false);
          }
        });

        tocTrigger?.addEventListener('click', () => {
          const nextOpen = header.dataset.mobileTocOpen !== 'true';
          setTocOpen(nextOpen);
          header.dataset.navHidden = 'false';
          if (nextOpen) {
            setMenuOpen(false);
          }
        });

        tocMenu?.addEventListener('click', (event) => {
          if ((event.target as Element).closest?.('[data-nav-toc-link]')) {
            setTocOpen(false);
          }
        });

        document.addEventListener('click', (event) => {
          if (!header.contains(event.target as Node)) {
            setMenuOpen(false);
            setTocOpen(false);
          }
        });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') {
            setMenuOpen(false);
            setTocOpen(false);
          }
        });
      }

      if (!header.dataset.paletteReady) {
        header.dataset.paletteReady = 'true';

        const paletteToggle = header.querySelector<HTMLButtonElement>('[data-palette-toggle]');
        const palettePanel = header.querySelector<HTMLElement>('[data-palette-panel]');
        const storageKey = 'navfolio-palette';
        const knownPalettes = new Set(
          [...header.querySelectorAll('[data-palette-option]')].map(
            (option) => option.getAttribute('data-palette-option') ?? '',
          ),
        );

        const applyMetaThemeColor = () => {
          const color = getComputedStyle(document.documentElement)
            .getPropertyValue('--paper-theme-color')
            .trim();
          if (!color) return;
          document.querySelector('meta[name="theme-color"]')?.setAttribute('content', color);
        };

        const setPaletteOpen = (open: boolean) => {
          if (!paletteToggle || !palettePanel) return;
          header.dataset.paletteOpen = open ? 'true' : 'false';
          paletteToggle.setAttribute('aria-expanded', String(open));
          paletteToggle.setAttribute('aria-label', open ? '关闭主题色面板' : '打开主题色面板');
        };

        const syncActiveOption = () => {
          const current = document.documentElement.dataset.palette ?? '';
          for (const option of header.querySelectorAll<HTMLButtonElement>(
            '[data-palette-option]',
          )) {
            const active = option.getAttribute('data-palette-option') === current;
            option.setAttribute('aria-pressed', String(active));
            option.classList.toggle('active', active);
          }
        };

        const readStoredPalette = () => {
          try {
            return localStorage.getItem(storageKey);
          } catch {
            return null;
          }
        };

        // 恢复持久化选择（早期脚本已应用，这里兜底同步选中态）
        const stored = readStoredPalette();
        if (stored && knownPalettes.has(stored)) {
          document.documentElement.dataset.palette = stored;
        }
        syncActiveOption();

        paletteToggle?.addEventListener('click', () => {
          const nextOpen = header.dataset.paletteOpen !== 'true';
          setPaletteOpen(nextOpen);
          header.dataset.navHidden = 'false';
          if (nextOpen) {
            // 与移动端菜单/目录互斥
            header.dataset.mobileMenuOpen = 'false';
            header.dataset.mobileTocOpen = 'false';
            header
              .querySelector('[data-mobile-menu-toggle]')
              ?.setAttribute('aria-expanded', 'false');
            header
              .querySelector('[data-mobile-toc-trigger]')
              ?.setAttribute('aria-expanded', 'false');
          }
        });

        palettePanel?.addEventListener('click', (event) => {
          const option = (event.target as Element).closest<HTMLButtonElement>(
            '[data-palette-option]',
          );
          if (!option) return;
          const palette = option.getAttribute('data-palette-option');
          if (!palette) return;
          document.documentElement.dataset.palette = palette;
          try {
            localStorage.setItem(storageKey, palette);
          } catch {
            // 存储不可用时仍允许本次切换生效
          }
          applyMetaThemeColor();
          syncActiveOption();
        });

        document.addEventListener('click', (event) => {
          if (header.dataset.paletteOpen === 'true' && !header.contains(event.target as Node)) {
            setPaletteOpen(false);
          }
        });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && header.dataset.paletteOpen === 'true') {
            setPaletteOpen(false);
          }
        });
      }
    }
  };

  initMobileTopNav();
  document.addEventListener('astro:before-preparation', (event) => {
    const navigationId = startPendingNavigation(event.sourceElement);

    if (!navigationId) {
      return;
    }

    const loadPage = event.loader;

    event.loader = async () => {
      try {
        await loadPage();

        if (event.signal.aborted) {
          clearPendingNavigation(navigationId);
        }
      } catch (error) {
        clearPendingNavigation(navigationId);
        throw error;
      }
    };
  });
  document.addEventListener('astro:after-swap', () => clearPendingNavigation());
  document.addEventListener('astro:page-load', initMobileTopNav);
</script>

<style>
  .blog-top-nav {
    position: fixed;
    top: 18px;
    right: 0;
    left: 0;
    z-index: 50;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 24px;
    align-items: center;
    width: min(calc(100% - 32px), 900px);
    min-height: 56px;
    padding: 10px 14px 10px 18px;
    margin: 0 auto;
    border: 1px solid var(--paper-line);
    border-radius: 8px;
    background: var(--paper-nav);
    box-shadow: var(--paper-shadow);
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 180ms ease,
      transform 220ms ease;
    will-change: transform;
  }

  .blog-top-nav::after {
    position: absolute;
    right: 14px;
    bottom: -1px;
    left: 14px;
    height: 2px;
    border-radius: 999px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--paper-accent) 6%,
      var(--paper-accent) 94%,
      transparent
    );
    content: '';
    opacity: 0;
    pointer-events: none;
    transform: scaleX(0);
    transform-origin: center;
    will-change: opacity, transform;
  }

  .blog-top-nav[data-nav-pending='true'] {
    cursor: progress;
  }

  .blog-top-nav[data-nav-pending='true']::after {
    animation: nav-route-progress 900ms ease-in-out infinite;
    opacity: 1;
  }

  .blog-top-nav[data-nav-hidden='true'] {
    opacity: 0;
    pointer-events: none;
    transform: translateY(calc(-100% - 24px));
  }

  .mobile-menu-toggle,
  .mobile-menu-panel,
  .mobile-toc-panel {
    display: none;
  }

  .brand,
  a.nav-link,
  a.mobile-menu-link,
  .mobile-toc-panel a {
    color: var(--paper-ink);
    text-decoration: none;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-weight: 700;
  }

  .brand-mark {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--paper-accent);
    box-shadow: none;
  }

  .nav-links {
    display: flex;
    justify-content: center;
    gap: 4px;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    justify-content: center;
    min-width: 74px;
    padding: 9px 12px 12px;
    border-radius: 8px;
    color: var(--paper-ink-soft);
    font-size: 0.9rem;
    font-weight: 700;
  }

  a.nav-link:hover,
  a.nav-link.active,
  a.nav-link[data-nav-link-pending] {
    background: var(--paper-control-hover);
    color: var(--paper-accent);
  }

  .nav-link.active::after,
  .nav-link[data-nav-link-pending]::after {
    position: absolute;
    bottom: 5px;
    left: 50%;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--paper-accent);
    content: '';
    transform: translateX(-50%);
  }

  .nav-link[data-nav-link-pending]::after,
  .brand[data-nav-link-pending] .brand-mark {
    animation: nav-pending-pulse 620ms ease-in-out infinite alternate;
  }

  .nav-link-placeholder {
    color: var(--paper-ink-faint);
    cursor: default;
  }

  .nav-actions {
    display: flex;
    gap: 8px;
  }

  .nav-actions a,
  .nav-actions button,
  .mobile-menu-toggle {
    display: inline-grid;
    place-items: center;
    width: 38px;
    height: 38px;
    padding: 0;
    border: 1px solid var(--paper-line);
    border-radius: 8px;
    background: var(--paper-control);
    color: var(--paper-ink);
    cursor: pointer;
  }

  .mobile-menu-toggle,
  .nav-actions .toc-action {
    display: none;
  }

  .nav-actions a:hover,
  .nav-actions button:hover,
  .mobile-menu-toggle:hover {
    background: var(--paper-control-hover);
    color: var(--paper-accent);
  }

  .palette-panel {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    display: grid;
    gap: 8px;
    width: min(248px, calc(100vw - 24px));
    padding: 12px;
    border: 1px solid var(--paper-line-strong);
    border-radius: 10px;
    background: var(--paper-nav);
    box-shadow: var(--paper-shadow-lift);
    opacity: 0;
    pointer-events: none;
    transform: translateY(-4px);
    transition:
      opacity 160ms ease,
      transform 160ms ease;
  }

  .blog-top-nav[data-palette-open='true'] .palette-panel {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .palette-panel-title {
    margin: 0;
    padding: 0 2px 2px;
    color: var(--paper-ink-faint);
    font-family: var(--font-ui-label);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .palette-options {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 4px;
  }

  .palette-option {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 36px;
    padding: 4px 8px;
    border: 1px solid transparent;
    border-radius: 7px;
    background: none;
    color: var(--paper-ink-soft);
    cursor: pointer;
    font-family: var(--font-ui-label);
    font-size: 0.82rem;
    font-weight: 600;
    transition:
      background 160ms ease,
      color 160ms ease;
  }

  .palette-option:hover {
    background: var(--paper-control-hover);
    color: var(--paper-ink);
  }

  .palette-option.active {
    border-color: var(--paper-line-strong);
    background: var(--paper-accent-soft);
    color: var(--paper-accent);
  }

  .palette-dot {
    flex: none;
    width: 14px;
    height: 14px;
    border: 2px solid var(--paper-surface);
    border-radius: 999px;
    box-shadow:
      0 0 0 1px var(--paper-line-strong),
      inset 0 0 0 1px rgba(0, 0, 0, 0.06);
    background: linear-gradient(135deg, var(--swatch-light) 50%, var(--swatch-dark) 50%);
  }

  @media (max-width: 720px) {
    .blog-top-nav {
      grid-template-columns: auto minmax(0, 1fr) auto;
      gap: 10px;
      top: 10px;
      width: min(calc(100% - 20px), 520px);
      min-height: 54px;
      padding: 8px 10px 8px 14px;
      border-radius: 8px;
    }

    .nav-links {
      display: none;
    }

    .mobile-menu-toggle {
      display: inline-grid;
    }

    .brand {
      min-width: 0;
      gap: 8px;
      font-size: 0.95rem;
    }

