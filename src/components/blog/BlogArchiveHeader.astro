---
import PageHero from '../PageHero.astro';

interface Props {
  kicker?: string;
  title?: string;
  subtitle?: string;
  note?: string;
}

const { kicker = 'Notebook archive', title = 'Writing notes', subtitle, note } = Astro.props;
---

<PageHero kicker={kicker} title={title} subtitle={subtitle} note={note} />
