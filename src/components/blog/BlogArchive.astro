---
import type { CollectionEntry } from 'astro:content';
import BlogArchiveHeader from './BlogArchiveHeader.astro';
import BlogPostList from './BlogPostList.astro';
import { getSiteConfig } from '../../data/site';
import { getUiText } from '../../lib/ui-text';
import { getPaginationItems } from '../../lib/pagination';
import '../../styles/blog-archive.css';

type BlogPost = CollectionEntry<'blog'>;
type CoverImageStyle = 'card' | 'mask';
type PostListLayout = 'rows' | 'media';

interface PaginationState {
  currentPage: number;
  lastPage: number;
  total: number;
  size: number;
  url: {
    current: string;
    prev?: string;
    next?: string;
  };
}

interface Props {
  page: PaginationState & {
    data: BlogPost[];
  };
  postOffset?: number;
  headerKicker?: string;
  headerTitle?: string;
  headerSubtitle?: string;
  headerNote?: string;
  coverImageStyle?: CoverImageStyle;
  listLayout?: PostListLayout;
}

const {
  page,
  postOffset = 0,
  headerKicker = 'Notebook archive',
  headerTitle = 'Writing notes',
  headerSubtitle,
  headerNote,
  coverImageStyle = 'card',
  listLayout = 'rows',
} = Astro.props;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const hasPagination = page.lastPage > 1;
const ui = getUiText(await getSiteConfig());

function withBase(href: string) {
  if (href === '/') {
    return `${basePath}/` || '/';
  }

  return `${basePath}${href.startsWith('/') ? href : `/${href}`}`;
}

function getPageHref(pageNumber: number) {
  return pageNumber === 1 ? '/blog/' : `/blog/page/${pageNumber}/`;
}
---

<BlogArchiveHeader
  kicker={headerKicker}
  title={headerTitle}
  subtitle={headerSubtitle}
  note={headerNote}
/>
<slot name="after-header" />
<section>
  <BlogPostList
    posts={page.data}
    postOffset={postOffset}
    coverImageStyle={coverImageStyle}
    listLayout={listLayout}
  />
</section>
{
  hasPagination && (
    <nav class="archive-pagination" aria-label={ui.pagination.blog}>
      {page.url.prev ? (
        <a class="pagination-link pagination-prev" href={withBase(page.url.prev)}>
          {ui.pagination.previous}
        </a>
      ) : (
        <span class="pagination-link pagination-prev disabled" aria-disabled="true">
          {ui.pagination.previous}
        </span>
      )}
      <div
        class="pagination-pages"
        aria-label={ui.pagination.page(page.currentPage, page.lastPage)}
      >
        {getPaginationItems(page.currentPage, page.lastPage).map((item) => {
          if (item === 'ellipsis') {
            return (
              <span class="pagination-ellipsis" aria-hidden="true">
                …
              </span>
            );
          }

          const pageNumber = item;
          const isCurrent = pageNumber === page.currentPage;

          return (
            <a
              class:list={['pagination-number', { current: isCurrent }]}
              href={withBase(getPageHref(pageNumber))}
              aria-current={isCurrent ? 'page' : undefined}
            >
              {pageNumber}
            </a>
          );
        })}
      </div>
      {page.url.next ? (
        <a class="pagination-link pagination-next" href={withBase(page.url.next)}>
          {ui.pagination.next}
        </a>
      ) : (
        <span class="pagination-link pagination-next disabled" aria-disabled="true">
          {ui.pagination.next}
        </span>
      )}
    </nav>
  )
}
