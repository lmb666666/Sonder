---
import type { CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import { format } from 'date-fns';
import FormattedDate from '../FormattedDate.astro';
import Icon from '../Icon.astro';
import SmartImage from '../SmartImage.astro';
import { getSiteConfig } from '../../config';
import { isStickyEntry } from '../../lib/content-dates';
import { getCoverBand } from '../../lib/cover-band';
import { getUiText } from '../../lib/ui-text';
import { countWords, readingMinutes } from '../../lib/word-count';
import '../../styles/blog-post-media-list.css';

type BlogPost = CollectionEntry<'blog'>;

interface Props {
  posts: BlogPost[];
  postOffset?: number;
  listTag?: 'ul' | 'ol';
}

const { posts, postOffset = 0, listTag = 'ul' } = Astro.props;
const ListTag = listTag;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const ui = getUiText(await getSiteConfig());

function withBase(href: string) {
  if (href === '/') {
    return `${basePath}/` || '/';
  }

  return `${basePath}${href.startsWith('/') ? href : `/${href}`}`;
}

// 磨砂文字条数据在模板外预取（sharp 读图是异步的，map 回调里不能 await）。
const cards = await Promise.all(
  posts.map(async (post, index) => {
    const cover = post.data.heroImage;
    const bodyText = typeof post.body === 'string' ? post.body : post.data.description;
    const band = cover ? await getCoverBand(cover, post.filePath) : null;
    // 文字条背景：封面缩略图（会被磨砂模糊，小尺寸即可），与图片区共用同一张图
    let bandImage: string | null = null;
    if (cover) {
      if (typeof cover === 'string') {
        bandImage = cover;
      } else {
        try {
          bandImage = (await getImage({ src: cover, width: 160, format: 'webp' })).src;
        } catch {
          bandImage = cover.src;
        }
      }
    }
    return {
      post,
      index,
      postHref: withBase(`/blog/${post.id}/`),
      sticky: isStickyEntry(post),
      // 分类直接取文章 frontmatter
      groups: [...post.data.categories],
      cover,
      shortDate: format(post.data.date, 'MM-dd'),
      words: countWords(bodyText),
      minutes: readingMinutes(bodyText),
      bandStyle: band ? `--media-band:${band.band};--media-fg:${band.fg}` : undefined,
      bandVars: bandImage ? `--media-image:url("${bandImage.replace(/"/g, '%22')}")` : undefined,
    };
  }),
);
---

<ListTag class="media-stack">
  {
    cards.map(
      ({
        post,
        index,
        postHref,
        sticky,
        groups,
        cover,
        shortDate,
        words,
        minutes,
        bandStyle,
        bandVars,
      }) => {
        return (
          <li class="media-item">
            <a
              class:list={['media-card', { 'is-fallback': !cover }]}
              href={postHref}
              data-archive-post-href={postHref}
              style={[bandStyle, bandVars].filter(Boolean).join(';') || undefined}
            >
              {cover ? (
                <span class="media-cover-frame">
                  <SmartImage
                    class="media-cover"
                    width={960}
                    height={540}
                    src={cover}
                    alt=""
                    loading={index === 0 ? 'eager' : 'lazy'}
                    fetchpriority={index === 0 ? 'high' : 'auto'}
                  />
                </span>
              ) : (
                <span class="media-cover-frame media-cover-fallback" aria-hidden="true">
                  <span class="media-ghost">{String(postOffset + index + 1).padStart(2, '0')}</span>
                </span>
              )}
              {sticky && (
                <span class="media-pin">
                  <Icon name="pin" size={12} stroke-width={2.4} />
                  {ui.article.pinned}
                </span>
              )}
              <span class="media-body">
                <h2 class="media-title">{post.data.title}</h2>
                <span class="media-meta">
                  <span class="media-meta-side">
                    <span class="media-meta-chip media-date">
                      <Icon name="calendar" size={13} stroke-width={2} />
                      <span class="media-date-full">
                        <FormattedDate date={post.data.date} />
                      </span>
                      <span class="media-date-short">{shortDate}</span>
                    </span>
                    {groups.length > 0 && (
                      <span class="media-meta-chip media-meta-groups">
                        <Icon name="folder" size={13} stroke-width={2} />
                        {groups.join(', ')}
                      </span>
                    )}
                  </span>
                  <span class="media-meta-side">
                    <span class="media-meta-chip media-meta-words">
                      <Icon name="pen" size={13} stroke-width={2} />
                      {ui.article.wordCount(words)}
                    </span>
                    <span class="media-meta-chip">
                      <Icon name="clock" size={13} stroke-width={2} />
                      {ui.article.readingTime(minutes)}
                    </span>
                  </span>
                </span>
              </span>
            </a>
          </li>
        );
      },
    )
  }
</ListTag>
