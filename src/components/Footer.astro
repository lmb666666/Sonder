---
import { getSiteConfig } from '../data/site';

const { site, profile } = await getSiteConfig();
const year = new Date().getFullYear();
const initial = site.title.trim().charAt(0).toUpperCase();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <span class="footer-mark" aria-hidden="true">{initial}</span>
      <div class="footer-copy">
        <p class="footer-title">{site.title}</p>
        <p class="footer-tagline">{profile.role}</p>
      </div>
    </div>

    <div class="footer-meta">
      <p class="footer-year">© {year} {site.title}</p>
      <p class="footer-note">{site.footerNote}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    width: min(100%, var(--layout-shell-width));
    margin: 0 auto;
    padding: 0 var(--layout-page-gutter);
    font-family: var(--font-meta);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 18px 40px;
    align-items: flex-end;
    justify-content: space-between;
    padding: 26px 0 44px;
    border-top: 1px solid var(--paper-line);
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }

  /* 字标：站点首字母方章 */
  .footer-mark {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 30px;
    height: 30px;
    border: 1px solid var(--paper-line-strong);
    border-radius: 7px;
    color: var(--paper-accent);
    font-family: var(--font-meta);
    font-size: 0.86rem;
    font-weight: 700;
    line-height: 1;
  }

  .footer-copy {
    min-width: 0;
  }

  .footer-title {
    margin: 0;
    color: var(--paper-ink);
    font-family: var(--font-heading);
    font-size: 0.98rem;
    font-weight: 650;
    line-height: 1.2;
  }

  .footer-tagline {
    margin: 3px 0 0;
    color: var(--paper-ink-faint);
    font-size: 0.74rem;
    line-height: 1.3;
  }

  .footer-meta {
    display: grid;
    gap: 3px;
    text-align: right;
    color: var(--paper-ink-faint);
    font-size: 0.72rem;
    line-height: 1.5;
  }

  .footer-meta p {
    margin: 0;
  }

  .footer-year {
    color: var(--paper-ink-soft);
  }

  @media (max-width: 720px) {
    .footer-inner {
      align-items: flex-start;
      padding: 24px 0 36px;
    }

    .footer-meta {
      text-align: left;
    }
  }
</style>
