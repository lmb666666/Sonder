---
import { getSiteConfig } from '../data/site';

const { site } = await getSiteConfig();
const year = new Date().getFullYear();
---

<footer>
  <p class="copyright">&copy; {year} {site.title}. {site.footerNote}</p>
  <p class="powered">
    Powered by <a href="https://astro.build/" target="_blank" rel="noreferrer">Astro</a>
  </p>
</footer>

<style>
  footer {
    padding: 3em 1em 6em;
    color: var(--paper-ink-faint);
    font-size: 0.88rem;
    text-align: center;
  }

  footer p {
    margin: 0;
  }

  .powered {
    margin-top: 0.6em;
    font-size: 0.8rem;
  }

  .powered a {
    color: var(--paper-ink-soft);
    text-decoration: none;
    border-bottom: 1px solid var(--paper-line);
    transition:
      color 180ms ease,
      border-color 180ms ease;
  }

  .powered a:hover,
  .powered a:focus-visible {
    color: var(--paper-accent);
    border-color: currentColor;
  }
</style>
