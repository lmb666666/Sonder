---
import { getSiteConfig } from '../data/site';

interface Props {
  /** 首页把页脚收进右侧边栏：桌面紧凑左对齐，移动端保持居中收尾。 */
  sidebar?: boolean;
}

const { sidebar = false } = Astro.props;
const { site } = await getSiteConfig();
const year = new Date().getFullYear();
---

<footer class:list={{ 'footer-sidebar': sidebar }}>
  <p class="copyright">&copy; {year} {site.title}.</p>
  <p class="powered">
    Powered by <a href="https://astro.build/" target="_blank" rel="noreferrer">Astro</a>
    <span class="sep" aria-hidden="true">·</span>
    <a href={site.repository} target="_blank" rel="noreferrer">Sonder</a>
  </p>
</footer>

<style>
  footer {
    padding: 3em 1em 6em;
    color: var(--paper-ink-faint);
    font-size: 0.88rem;
    text-align: center;
  }

  footer p {
    margin: 0;
  }

  .powered {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.45em;
    margin-top: 0.6em;
    font-size: 0.8rem;
  }

  .footer-sidebar {
    padding: 2.2em 1em 0;
  }

  /* 桌面把 Powered by 留在站点信息卡里，页脚只保留版权行；
     移动端站点信息隐藏，页脚继续展示完整来源。 */
  .footer-sidebar .powered {
    display: none;
  }

  @media (max-width: 820px) {
    .footer-sidebar .powered {
      display: inline-flex;
    }
  }

  /* 桌面：页脚成为侧栏最后一格，与站点信息用发丝线分隔 */
  @media (min-width: 921px) {
    .footer-sidebar {
      padding: 14px 0 0;
      border-top: 1px solid var(--paper-line);
      font-size: 0.76rem;
      text-align: left;
    }
  }

  .sep {
    opacity: 0.7;
  }

  .powered a {
    color: var(--paper-ink-soft);
    text-decoration: none;
    border-bottom: 1px solid var(--paper-line);
    transition:
      color 180ms ease,
      border-color 180ms ease;
  }

  .powered a:hover,
  .powered a:focus-visible {
    color: var(--paper-accent);
    border-color: currentColor;
  }
</style>
