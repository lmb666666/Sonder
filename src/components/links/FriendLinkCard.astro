---
import { Link, Rss } from 'lucide-astro';
import '../../styles/friend-link-card.css';
import {
  orderFriendLinks,
  resolveFriendLinkItems,
  type FriendDataSource,
  type FriendLinkItem,
} from '../../lib/friend-data';

interface Props {
  items?: FriendLinkItem[];
  src?: string;
  source?: FriendDataSource;
  columns?: 1 | 2 | 3 | 4;
  randomBackground?: boolean;
  shuffle?: boolean;
  preview?: boolean;
}

const {
  columns = 4,
  randomBackground = false,
  shuffle = false,
  preview = false,
  ...dataSource
} = Astro.props;
const items = orderFriendLinks(await resolveFriendLinkItems(dataSource), shuffle);
const trim = (value: unknown) => (typeof value === 'string' ? value.trim() : '');
const background = (index: number) => {
  if (!randomBackground) return undefined;
  const hue = Math.floor(Math.random() * 360);
  const saturation = 42 + Math.floor(Math.random() * 30);
  const lightness = 42 + Math.floor(Math.random() * 22);
  return `--friend-link-random: hsl(${hue} ${saturation}% ${lightness}% / 0.22); --friend-link-random-strong: hsl(${hue} ${saturation}% ${lightness}% / 0.34); --friend-link-index: ${index};`;
};
---

<div class="friend-link-region">
  <div class="friend-link-list" style={`--friend-link-columns: ${columns};`}>
    {
      items.map((item, index) => {
        const name = trim(item.name);
        const avatar = trim(item.avatar);
        const bio = trim(item.bio);
        const explicitBackground = randomBackground ? '' : trim(item.backgroundImage);
        const backgroundImage = explicitBackground || avatar;
        const displayName = name || (preview ? '你的站点' : '');
        const displayBio = bio || (preview ? '站点简介会显示在这里' : '');
        return (
          <a
            class:list={[
              'friend-link-card',
              backgroundImage && 'friend-link-card--with-image',
              randomBackground && 'friend-link-card--random',
              preview && 'friend-link-card--preview',
            ]}
            href={preview ? undefined : trim(item.url)}
            target={preview ? undefined : '_blank'}
            rel={preview ? undefined : 'noopener noreferrer'}
            title={displayName}
            role={preview ? 'group' : undefined}
            aria-label={preview ? `友链卡片实时预览：${displayName}` : undefined}
            data-friend-link-card-preview={preview ? '' : undefined}
            style={background(index)}
          >
            {backgroundImage || preview ? (
              <img
                class="friend-link-card__background"
                src={backgroundImage || undefined}
                alt=""
                loading={preview ? 'eager' : 'lazy'}
                decoding="async"
                aria-hidden="true"
                hidden={!backgroundImage}
                data-friend-link-card-background={preview ? '' : undefined}
              />
            ) : null}
            <span class="friend-link-card__avatar" aria-hidden="true">
              {preview ? (
                <>
                  <img
                    src={avatar || undefined}
                    alt=""
                    loading="eager"
                    decoding="async"
                    hidden={!avatar}
                    data-friend-link-card-avatar
                  />
                  <span hidden={Boolean(avatar)} data-friend-link-card-fallback>
                    {(displayName[0] || '?').toUpperCase()}
                  </span>
                </>
              ) : avatar ? (
                <img src={avatar} alt="" loading="lazy" decoding="async" />
              ) : (
                <span>{(name[0] || '?').toUpperCase()}</span>
              )}
            </span>
            {trim(item.rss) && !preview ? (
              <span class="friend-link-card__rss" title={`RSS: ${trim(item.rss)}`}>
                <Rss size={12} strokeWidth={1.8} aria-hidden="true" />
              </span>
            ) : null}
            <span class="friend-link-card__meta">
              <span class="friend-link-card__heading">
                <strong data-friend-link-card-name={preview ? '' : undefined}>{displayName}</strong>
                <Link size={13} strokeWidth={1.8} aria-hidden="true" />
              </span>
              {displayBio ? (
                <span
                  class="friend-link-card__bio"
                  data-friend-link-card-bio={preview ? '' : undefined}
                >
                  {displayBio}
                </span>
              ) : null}
            </span>
          </a>
        );
      })
    }
  </div>
</div>
