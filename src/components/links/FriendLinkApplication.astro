---
import { ArrowLeft, ArrowRight, Check, Copy, ExternalLink, FileJson2 } from 'lucide-astro';
import FriendLinkCard from './FriendLinkCard.astro';
import '../../styles/friend-link-application.css';
import type { FriendLinkItem } from '../../lib/friend-data';
import { getSiteConfig } from '../../config';
import { getUiText } from '../../lib/ui-text';

type ApplicationField = 'name' | 'url' | 'bio' | 'avatar' | 'backgroundImage' | 'rss';
type ApplicationValue = FriendLinkItem;
type IssueFieldMap = Partial<Record<ApplicationField, string | false>>;
type ApplicationAppearance = 'seamless' | 'bordered';

interface Props {
  repository: string;
  appearance?: ApplicationAppearance;
  labels?: string[];
  issueTemplate?: string;
  issueTitle?: string;
  issueBody?: string;
  issueFieldMap?: IssueFieldMap;
  assignees?: string[];
  milestone?: string;
  projects?: string[];
  initialValue?: ApplicationValue;
  placeholders?: Partial<Record<ApplicationField, string>>;
  title?: string;
  description?: string;
  applyLabel?: string;
  applyHint?: string;
  copyHint?: string;
  copySuccessText?: string;
  showLivePreview?: boolean;
  nameMaxLength?: number;
  bioMaxLength?: number;
  urlMaxLength?: number;
}

const siteConfig = await getSiteConfig();
const ui = getUiText(siteConfig);
const messages = ui.friendApplication;
const fields = messages.fields;
const clientMessages = {
  previewName: messages.previewName,
  previewBio: messages.previewBio,
  statusReady: messages.statusReady,
  statusIncomplete: messages.statusIncomplete,
  copyFailed: messages.copyFailed,
  invalidUrl: messages.invalidUrl,
  invalidUrlProtocol: messages.invalidUrlProtocol,
  previewAriaPrefix: messages.previewAriaPrefix,
};

const defaultPlaceholders: Record<ApplicationField, string> = {
  name: messages.placeholders.name,
  url: messages.placeholders.url,
  bio: messages.placeholders.bio,
  avatar: messages.placeholders.avatar,
  backgroundImage: messages.placeholders.backgroundImage,
  rss: messages.placeholders.rss,
};

const defaultIssueFieldMap: Record<ApplicationField, string> = {
  name: 'name',
  url: 'url',
  bio: 'bio',
  avatar: 'avatar',
  backgroundImage: 'backgroundImage',
  rss: 'rss',
};

const {
  repository,
  appearance = 'seamless',
  labels = [],
  issueTemplate,
  issueTitle = messages.issueTitle('{name}'),
  issueBody = messages.issueBody('{json}'),
  issueFieldMap = {},
  assignees = [],
  milestone,
  projects = [],
  initialValue = {},
  placeholders: customPlaceholders = {},
  title = messages.title,
  description = messages.description,
  applyLabel = messages.applyLabel,
  applyHint = messages.applyHint,
  copyHint = messages.copyHint,
  copySuccessText = messages.copySuccessText,
  showLivePreview = false,
  nameMaxLength = 80,
  bioMaxLength = 160,
  urlMaxLength = 2048,
} = Astro.props;

const resolveRepository = (value: string) => {
  const raw = value?.trim();
  if (!raw) throw new Error('FriendLinkApplication requires a GitHub repository.');

  let path = raw;
  if (/^https?:\/\//i.test(raw)) {
    const parsed = new URL(raw);
    if (!['github.com', 'www.github.com'].includes(parsed.hostname.toLowerCase())) {
      throw new Error('FriendLinkApplication repository must use github.com.');
    }
    path = parsed.pathname;
  } else if (/^git@github\.com:/i.test(raw)) {
    path = raw.replace(/^git@github\.com:/i, '');
  }

  const segments = path
    .replace(/^\/+|\/+$/g, '')
    .replace(/\.git$/i, '')
    .split('/')
    .filter(Boolean);
  const repositoryPath = segments.slice(0, 2).join('/');
  if (segments.length !== 2 || !/^[A-Za-z0-9_.-]+\/[A-Za-z0-9_.-]+$/.test(repositoryPath)) {
    throw new Error(
      'FriendLinkApplication repository must be "owner/repository" or a GitHub repository URL.',
    );
  }
  return repositoryPath;
};

const positiveInteger = (value: number, fallback: number) =>
  Number.isInteger(value) && value > 0 ? value : fallback;
const cleanList = (values: string[]) =>
  values.map((value) => value.trim()).filter((value) => value.length > 0);
const cleanValue = (value: unknown) => (typeof value === 'string' ? value : '');
const repositoryPath = resolveRepository(repository);
const placeholders = { ...defaultPlaceholders, ...customPlaceholders };
const fieldMap = { ...defaultIssueFieldMap, ...issueFieldMap };
Object.values(fieldMap).forEach((fieldId) => {
  if (fieldId !== false && !/^[A-Za-z0-9_-]+$/.test(fieldId)) {
    throw new Error(
      `FriendLinkApplication issue field id "${fieldId}" may only contain letters, numbers, hyphens, and underscores.`,
    );
  }
});
const initialData = {
  name: cleanValue(initialValue.name),
  url: cleanValue(initialValue.url),
  bio: cleanValue(initialValue.bio),
  avatar: cleanValue(initialValue.avatar),
  backgroundImage: cleanValue(initialValue.backgroundImage),
  rss: cleanValue(initialValue.rss),
  sticky: false,
};
const config = {
  issueBase: `https://github.com/${repositoryPath}/issues/new`,
  labels: cleanList(labels),
  issueTemplate: issueTemplate?.trim() || '',
  issueTitle,
  issueBody,
  issueFieldMap: fieldMap,
  assignees: cleanList(assignees),
  milestone: milestone?.trim() || '',
  projects: cleanList(projects),
  copyHint,
  copySuccessText,
  messages: clientMessages,
};
const serializedConfig = JSON.stringify(config).replace(/</g, '\\u003c');
const safeNameMaxLength = positiveInteger(nameMaxLength, 80);
const safeBioMaxLength = positiveInteger(bioMaxLength, 160);
const safeUrlMaxLength = positiveInteger(urlMaxLength, 2048);
const safeShowLivePreview = showLivePreview === true;
const safeAppearance: ApplicationAppearance = appearance === 'bordered' ? 'bordered' : 'seamless';
const formatApplicationPreview = (json: string) =>
  json
    .split('\n')
    .slice(1, -1)
    .map((line) => (line.startsWith('  ') ? line.slice(2) : line))
    .join('\n');
const initialPreview = formatApplicationPreview(JSON.stringify(initialData, null, 2));
---

<section
  class="friend-link-application"
  data-appearance={safeAppearance}
  data-friend-link-application
>
  <div class="friend-link-application__viewport">
    <div class="friend-link-application__track" data-application-track>
      <section
        class="friend-link-application__slide friend-link-application__form-page"
        data-application-form-page
      >
        <header
          class:list={[
            'friend-link-application__header',
            safeShowLivePreview && 'friend-link-application__header--with-live-preview',
          ]}
        >
          <div class="friend-link-application__intro">
            <h2>{title}</h2>
            <p>{description}</p>
          </div>
          {
            safeShowLivePreview && (
              <div class="friend-link-application__card-preview" data-application-card-preview>
                <FriendLinkCard items={[initialData]} columns={1} preview />
              </div>
            )
          }
          <button
            class="friend-link-application__switch friend-link-application__switch--next"
            type="button"
            data-show-application-preview
          >
            <span>{messages.previewCta}</span>
            <ArrowRight size={17} strokeWidth={1.8} aria-hidden="true" />
          </button>
        </header>

        <form class="friend-link-application__form" data-application-form>
          <div class="friend-link-application__fields">
            <label class="friend-link-application__field">
              <span>{fields.name} <em>{messages.required}</em></span>
              <input
                name="name"
                type="text"
                value={initialData.name}
                placeholder={placeholders.name}
                maxlength={safeNameMaxLength}
                autocomplete="name"
                required
              />
            </label>

            <label class="friend-link-application__field">
              <span>{fields.url} <em>{messages.required}</em></span>
              <input
                name="url"
                type="url"
                value={initialData.url}
                placeholder={placeholders.url}
                autocomplete="url"
                inputmode="url"
                maxlength={safeUrlMaxLength}
                required
                data-url-field
              />
            </label>

            <label class="friend-link-application__field">
              <span>{fields.avatar}</span>
              <input
                name="avatar"
                type="url"
                value={initialData.avatar}
                placeholder={placeholders.avatar}
                autocomplete="off"
                inputmode="url"
                maxlength={safeUrlMaxLength}
                data-url-field
              />
            </label>

            <label class="friend-link-application__field">
              <span>{fields.backgroundImage}</span>
              <input
                name="backgroundImage"
                type="url"
                value={initialData.backgroundImage}
                placeholder={placeholders.backgroundImage}
                autocomplete="off"
                inputmode="url"
                maxlength={safeUrlMaxLength}
                data-url-field
              />
            </label>

            <label class="friend-link-application__field friend-link-application__field--wide">
              <span>{fields.bio}</span>
              <textarea
                name="bio"
                rows="2"
                placeholder={placeholders.bio}
                maxlength={safeBioMaxLength}>{initialData.bio}</textarea
              >
            </label>

            <label class="friend-link-application__field">
              <span>{fields.rss}</span>
              <input
                name="rss"
                type="url"
                value={initialData.rss}
                placeholder={placeholders.rss}
                autocomplete="off"
                inputmode="url"
                maxlength={safeUrlMaxLength}
                data-url-field
              />
            </label>

            <div class="friend-link-application__actions">
              <a
                class="friend-link-application__apply"
                target="_blank"
                rel="noopener noreferrer"
                href={config.issueBase}
                aria-disabled="true"
                data-tooltip={applyHint}
                data-apply-application
              >
                <span>{applyLabel}</span>
                <ExternalLink size={15} strokeWidth={1.8} aria-hidden="true" />
              </a>
              <p data-application-status aria-live="polite">
                {messages.statusIncomplete}
              </p>
            </div>
          </div>
        </form>
      </section>

      <aside
        class="friend-link-application__slide friend-link-application__preview"
        aria-hidden="true"
        aria-label={messages.previewAriaLabel}
        data-application-preview-page
        inert
      >
        <header class="friend-link-application__preview-header">
          <button
            class="friend-link-application__switch friend-link-application__switch--back"
            type="button"
            data-show-application-form
          >
            <ArrowLeft size={17} strokeWidth={1.8} aria-hidden="true" />
            <span>{messages.backCta}</span>
          </button>
          <h3>{messages.previewTitle}</h3>
          <button
            class="friend-link-application__copy"
            type="button"
            aria-label={copyHint}
            aria-disabled="true"
            data-tooltip={copyHint}
            data-copy-application
          >
            <Copy
              class="friend-link-application__copy-icon"
              size={17}
              strokeWidth={1.8}
              aria-hidden="true"
            />
            <Check
              class="friend-link-application__check-icon"
              size={17}
              strokeWidth={2}
              aria-hidden="true"
            />
          </button>
        </header>
        <div class="friend-link-application__code">
          <FileJson2 size={19} strokeWidth={1.6} aria-hidden="true" />
          <pre><code data-application-preview>{initialPreview}</code></pre>
        </div>
      </aside>
    </div>
  </div>

  <script
    is:inline
    type="application/json"
    data-friend-link-application-config
    set:html={serializedConfig}
  />
</section>

<script>
  import { bindFriendLinkApplications } from '../../lib/friend-link-application';

  bindFriendLinkApplications();
</script>
