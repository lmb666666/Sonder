---
import '../../styles/youlin-apply.css';

interface Props {
  href: string;
  title: string;
  description: string;
  label: string;
}

const { href, title, description, label } = Astro.props;
---

<section class="links-apply" aria-label={title}>
  <a class="youlin-apply-card" href={href} target="_blank" rel="noopener noreferrer">
    <span class="youlin-apply-card__copy">
      <strong>{title}</strong>
      <span>{description}</span>
    </span>
    <span class="youlin-apply-card__action" aria-hidden="true">{label} →</span>
  </a>
</section>
