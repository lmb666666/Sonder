<main class="flow-shell" data-pagefind-body>
  <section class="flow-grid" aria-label="Sonder 个人出版物">
    <section class="flow-column main-column">
      <slot name="intro" />
      <slot name="doing" />
    </section>

    <aside class="flow-column side-column">
      <slot name="profile" />
      <slot name="connect" />
      <slot name="latest" />
      <slot name="siteInfo" />
    </aside>
  </section>
</main>

<style>
  .flow-shell {
    width: min(100%, var(--layout-shell-width));
    margin: 0 auto;
    padding: 132px var(--layout-page-gutter) var(--layout-page-bottom);
  }

  .flow-grid {
    display: grid;
    grid-template-columns: minmax(0, 760px) minmax(240px, 286px);
    justify-content: center;
    gap: 64px;
    align-items: start;
  }

  .flow-column {
    display: grid;
    align-content: start;
    min-width: 0;
  }

  /* 主列下移：与侧栏底部对齐，避免左侧内容过早结束留出空档 */
  .main-column {
    padding-top: 84px;
  }

  /* 侧栏为身份与寻路，跟随滚动（主栏承载长内容） */
  .side-column {
    position: sticky;
    top: 92px;
  }

  .flow-grid :global(.glass-card) {
    width: 100%;
  }

  .flow-grid :global(.profile-card) {
    min-height: auto;
    padding: 2px 0 6px;
  }

  .flow-grid :global(.heatmap-card) {
    padding: 18px 0;
  }

  /* 热力图留在侧栏：格子弹性铺满栏宽（约 10px），比固定 8px 更清晰。
     三级类名压过组件 scoped 选择器（含 cid 属性）的同权重规则 */
  .flow-grid .side-column :global(.heatmap-cells) {
    width: 100%;
    grid-auto-columns: minmax(0, 1fr);
    grid-template-rows: repeat(7, auto);
  }

  .flow-grid .side-column :global(.heatmap-cells .heatmap-cell),
  .flow-grid .side-column :global(.heatmap-cells .cell-link) {
    width: 100%;
    height: auto;
    min-width: 0;
    min-height: 0;
    aspect-ratio: 1;
  }

  .flow-grid :global(.connect-card) {
    padding: 0 0 10px;
  }

  .flow-grid :global(.site-info-card) {
    margin-top: 12px;
  }

  .flow-grid :global(.intro-card) {
    min-height: 0;
    padding: 0 0 8px;
  }

  @media (max-width: 920px) {
    .flow-grid {
      grid-template-columns: 1fr;
      gap: 26px;
    }

    .main-column {
      padding-top: 0;
    }

    .side-column {
      position: static;
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 820px) {
    .flow-shell {
      padding: 96px 18px 42px;
    }

    .flow-grid {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }

    .main-column,
    .side-column {
      display: contents;
    }

    .flow-grid :global(.intro-card) {
      order: 5;
      min-height: auto;
      padding: 0;
    }

    .flow-grid :global(.profile-card) {
      order: 1;
    }

    .flow-grid :global(.connect-card) {
      order: 2;
      margin-block: -18px -10px;
    }

    .flow-grid :global(.heatmap-card) {
      order: 4;
      margin-top: -8px;
      padding: 14px 2px;
    }

    .flow-grid :global(.doing-card) {
      order: 6;
    }

    .flow-grid :global(.site-info-card) {
      order: 7;
      margin-top: 0;
    }
  }
</style>
