<main class="flow-shell" data-pagefind-body>
  <section class="flow-grid" aria-label="Sonder 个人出版物">
    <section class="flow-column main-column">
      <slot name="intro" />
      <slot name="latest" />
    </section>

    <aside class="flow-column side-column">
      <slot name="profile" />
      <slot name="connect" />
      <slot name="heatmap" />
      <slot name="siteInfo" />
    </aside>
  </section>
</main>

<style>
  .flow-shell {
    width: min(100%, var(--layout-shell-width));
    margin: 0 auto;
    padding: 132px var(--layout-page-gutter) var(--layout-page-bottom);
  }

  .flow-grid {
    display: grid;
    grid-template-columns: minmax(0, 760px) minmax(240px, 286px);
    justify-content: center;
    gap: 64px;
    align-items: start;
  }

  .flow-column {
    display: grid;
    align-content: start;
    min-width: 0;
  }

  /* 主列下移：与侧栏底部对齐，避免左侧内容过早结束留出空档 */
  .main-column {
    padding-top: 95px;
  }

  .flow-grid .main-column :global(.latest-block) {
    margin-top: 55px;
  }

  /* 侧栏为身份与寻路，跟随滚动（主栏承载长内容） */
  .side-column {
    position: sticky;
    top: 92px;
  }

  .flow-grid :global(.glass-card) {
    width: 100%;
  }

  .flow-grid :global(.profile-card) {
    min-height: auto;
    padding: 2px 0 4px;
  }

  /* 统计与热力图自成一組：顶部细线与站点信息同节奏，connect 与身份行之间留呼吸 */
  .flow-grid :global(.heatmap-card) {
    margin-top: 18px;
    padding: 18px 0 14px;
    border-top: 1px solid var(--paper-line);
    gap: 18px;
  }

  /* 热力图留在侧栏：格子弹性铺满栏宽（约 10px），比固定 8px 更清晰。
     三级类名压过组件 scoped 选择器（含 cid 属性）的同权重规则 */
  .flow-grid .side-column :global(.heatmap-cells) {
    width: 100%;
    grid-auto-columns: minmax(0, 1fr);
    grid-template-rows: repeat(7, auto);
  }

  .flow-grid .side-column :global(.heatmap-cells .heatmap-cell),
  .flow-grid .side-column :global(.heatmap-cells .cell-link) {
    width: 100%;
    height: auto;
    min-width: 0;
    min-height: 0;
    aspect-ratio: 1;
  }

  .flow-grid :global(.connect-card) {
    padding: 14px 0 0;
  }

  .flow-grid :global(.site-info-card) {
    margin-top: 0;
  }

  .flow-grid :global(.intro-card) {
    min-height: 0;
    padding: 0 0 8px;
  }

  @media (max-width: 920px) {
    .flow-grid {
      grid-template-columns: 1fr;
      gap: 26px;
    }

    .main-column {
      padding-top: 0;
    }

    .side-column {
      position: static;
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 820px) {
    .flow-shell {
      padding: 96px 20px 48px;
    }

    .flow-grid {
      display: flex;
      flex-direction: column;
      /* 桌面端为栅格保留了 align-items: start，flex 列下需拉回整宽 */
      align-items: stretch;
      gap: 26px;
    }

    .main-column,
    .side-column {
      display: contents;
    }

    /* 移动端：单一左轴 —— 署名、正文、社交图标，发丝线收口后接最新 */
    .flow-grid :global(.profile-card) {
      order: 1;
    }

    .flow-grid :global(.intro-card) {
      order: 2;
      min-height: auto;
      padding: 0;
    }

    .flow-grid :global(.connect-card) {
      order: 3;
      margin-top: -6px;
      padding-bottom: 22px;
      border-bottom: 1px solid var(--paper-line);
    }

    .flow-grid :global(.latest-block) {
      order: 4;
      margin-top: 0;
    }

    /* 收起数据面板：只保留身份、社交与正文 */
    .flow-grid :global(.heatmap-card),
    .flow-grid :global(.site-info-card) {
      display: none;
    }
  }
</style>
