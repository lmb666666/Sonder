---
import { aboutGallery } from '../../data/about-gallery';
import SmartImage from '../SmartImage.astro';
---

<div class="about-gallery">
  {
    aboutGallery.map((item, itemIndex) => (
      <figure class="about-gallery-item">
        <div class="about-gallery-frame">
          <SmartImage
            src={item.image}
            alt=""
            widths={[360, 720, 1080]}
            sizes="(max-width: 760px) 72vw, (max-width: 1100px) 40vw, 24vw"
            loading="lazy"
          />
        </div>
        <figcaption>
          <span class="about-gallery-index" aria-hidden="true">
            {String(itemIndex + 1).padStart(2, '0')}
          </span>
          <span class="about-gallery-copy">
            <strong>{item.title}</strong>
            <small>{item.meta}</small>
          </span>
        </figcaption>
      </figure>
    ))
  }
</div>
