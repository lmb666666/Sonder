---
import type { CollectionEntry } from 'astro:content';
import { format } from 'date-fns';

import { withBase } from '../../lib/url';
import SmartImage from '../SmartImage.astro';

interface Props {
  posts: CollectionEntry<'blog'>[];
  label: string;
  title: string;
  index: string;
}

const { posts, label, title, index } = Astro.props;
---

{
  posts.length > 0 && (
    <section class="about-gallery" id="gallery">
      <header class="about-section-head">
        <p class="about-section-label">
          <span>{index}</span>
          {label}
        </p>
        <h2>{title}</h2>
      </header>

      <div class="about-gallery-grid">
        {posts.map((post) => (
          <a class="about-gallery-item" href={withBase(`/blog/${post.id}/`)}>
            <div class="about-gallery-frame">
              {post.data.heroImage && (
                <SmartImage
                  src={post.data.heroImage}
                  alt=""
                  widths={[480, 720, 960]}
                  sizes="(max-width: 760px) 100vw, 33vw"
                  loading="lazy"
                />
              )}
            </div>
            <div class="about-gallery-caption">
              <span>
                {format(post.data.date, 'yyyy.MM.dd')}
                {post.data.categories[0] ? ` · ${post.data.categories[0]}` : ''}
              </span>
              <h3>{post.data.title}</h3>
            </div>
          </a>
        ))}
      </div>
    </section>
  )
}
