---
import type { ImageMetadata } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { ArrowUpRight } from 'lucide-astro';

import SmartImage from '../SmartImage.astro';

interface Props {
  projects: CollectionEntry<'projects'>[];
  images: Record<string, ImageMetadata | string>;
  label: string;
  title: string;
  index: string;
}

const { projects, images, label, title, index } = Astro.props;
---

{
  projects.length > 0 && (
    <section class="about-chapter about-works" id="works">
      <header class="about-section-head">
        <p class="about-section-label">
          <span>{index}</span>
          {label}
        </p>
        <h2>{title}</h2>
      </header>

      <div class="about-works-grid">
        {projects.map((project) => {
          const link = project.data.links[0]?.href;
          const image = images[project.id];
          return (
            <a
              class="about-work-card"
              href={link}
              target={link?.startsWith('http') ? '_blank' : undefined}
              rel={link?.startsWith('http') ? 'noreferrer' : undefined}
            >
              {image && (
                <div class="about-work-media">
                  <SmartImage
                    src={image}
                    alt=""
                    widths={[640, 960, 1200]}
                    sizes="(max-width: 760px) 100vw, 50vw"
                    loading="lazy"
                  />
                </div>
              )}
              <div class="about-work-body">
                <div class="about-work-title">
                  <h3>{project.data.title}</h3>
                  <span aria-hidden="true">
                    <ArrowUpRight size={17} strokeWidth={1.7} />
                  </span>
                </div>
                <p>{project.data.description}</p>
                {project.data.tags.length > 0 && (
                  <ul class="about-work-tags">
                    {project.data.tags.map((tag) => (
                      <li>{tag}</li>
                    ))}
                  </ul>
                )}
              </div>
            </a>
          );
        })}
      </div>
    </section>
  )
}
