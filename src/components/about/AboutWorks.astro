---
import type { CollectionEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import { ArrowUpRight } from 'lucide-astro';

import SmartImage from '../SmartImage.astro';

interface Props {
  projects: CollectionEntry<'projects'>[];
  covers: (ImageMetadata | string)[];
}

const { projects, covers } = Astro.props;
---

{
  projects.length > 0 && (
    <ol class="about-works">
      {projects.map((project, projectIndex) => {
        const link = project.data.links[0]?.href;
        const year = project.data.date.getFullYear();
        const cover = covers[projectIndex % covers.length] ?? covers[0];
        return (
          <li>
            <a
              class="about-work"
              href={link}
              target={link?.startsWith('http') ? '_blank' : undefined}
              rel={link?.startsWith('http') ? 'noreferrer' : undefined}
            >
              <span class="about-work-index" aria-hidden="true">
                {String(projectIndex + 1).padStart(2, '0')}
              </span>
              {cover && (
                <span class="about-work-cover" aria-hidden="true">
                  <SmartImage
                    src={cover}
                    alt=""
                    widths={[240, 480]}
                    sizes="(max-width: 760px) 90px, 148px"
                    loading="lazy"
                  />
                </span>
              )}
              <span class="about-work-body">
                <span class="about-work-meta">
                  <span>{year}</span>
                  {project.data.tags.length > 0 && (
                    <span>{project.data.tags.slice(0, 3).join(' / ')}</span>
                  )}
                </span>
                <strong>{project.data.title}</strong>
                <span class="about-work-description">{project.data.description}</span>
              </span>
              <span class="about-work-arrow" aria-hidden="true">
                <ArrowUpRight size={18} strokeWidth={1.6} />
              </span>
            </a>
          </li>
        );
      })}
    </ol>
  )
}
