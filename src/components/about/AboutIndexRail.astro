---
interface IndexItem {
  id: string;
  index: string;
  label: string;
}

interface Props {
  items: IndexItem[];
  label: string;
}

const { items, label } = Astro.props;
---

<nav class="about-index" aria-label={label} data-about-index>
  <div class="about-index-mark" aria-hidden="true">
    <span></span>
    <span></span>
    <span></span>
    <span></span>
  </div>
  <p class="about-index-title">{label}</p>
  <ol>
    {
      items.map((item) => (
        <li>
          <a href={`#${item.id}`} data-about-index-link data-target={item.id}>
            <span>{item.index}</span>
            {item.label}
          </a>
        </li>
      ))
    }
  </ol>
</nav>
