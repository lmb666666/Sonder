---
interface SkillLevel {
  name: string;
  percent: number;
}

interface Props {
  levels: SkillLevel[];
  focus: string[];
}

const { levels, focus } = Astro.props;
---

<div class="about-skills">
  <ol class="about-skill-list">
    {
      levels.map((item) => {
        const filled = Math.round(item.percent / 10);
        return (
          <li>
            <span class="about-skill-name">{item.name}</span>
            <span class="about-skill-ticks" aria-hidden="true">
              {Array.from({ length: 10 }, (_, index) => (
                <i class={index < filled ? 'is-filled' : undefined} />
              ))}
            </span>
            <span class="about-skill-percent">{item.percent}%</span>
          </li>
        );
      })
    }
  </ol>

  {
    focus.length > 0 && (
      <ul class="about-skill-focus" aria-label="关注方向">
        {focus.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    )
  }
</div>
