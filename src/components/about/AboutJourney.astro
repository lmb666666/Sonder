---
interface JourneyItem {
  year: string;
  label: string;
  meta?: string;
  description?: string;
  color?: string;
}

interface Props {
  items: JourneyItem[];
  label: string;
  title: string;
  accent: string;
  index: string;
}

const { items, label, title, accent, index } = Astro.props;

const shortYear = (year: string) => {
  const match = year.match(/\d{4}/);
  if (match) return match[0];
  if (/今天|now/i.test(year)) return 'NOW';
  return year;
};

const first = items[0];
const count = items.length;
---

{
  items.length > 0 && (
    <section
      class="about-chapter about-journey"
      id="experience"
      data-about-journey
      style={first?.color ? `--journey-accent:${first.color}` : undefined}
    >
      <header class="about-section-head">
        <p class="about-section-label">
          <span>{index}</span>
          {label}
        </p>
        <h2>
          {title}
          <br />
          <em>{accent}</em>
        </h2>
      </header>

      <div class="about-journey-body">
        <div class="about-journey-display" aria-hidden="true">
          <span class="about-journey-count" data-journey-count>
            01 / {String(count).padStart(2, '0')}
          </span>
          <span class="about-journey-year" data-journey-year>
            {shortYear(first?.year ?? '')}
          </span>
          <span class="about-journey-rule" />
        </div>

        <ol class="about-journey-list">
          {items.map((item, itemIndex) => (
            <li
              data-journey-item
              data-year={shortYear(item.year)}
              data-color={item.color}
              style={item.color ? `--journey-item-color:${item.color}` : undefined}
            >
              <span class="about-journey-index">{String(itemIndex + 1).padStart(2, '0')}</span>
              <div class="about-journey-entry">
                <span class="about-journey-date">{item.year}</span>
                <h3>{item.label}</h3>
                {item.meta && <p class="about-journey-meta">{item.meta}</p>}
                {item.description && <p class="about-journey-desc">{item.description}</p>}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )
}
