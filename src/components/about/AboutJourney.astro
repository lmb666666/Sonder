---
interface JourneyItem {
  year: string;
  label: string;
  meta?: string;
  color?: string;
}

interface Props {
  items: JourneyItem[];
  label: string;
  title: string;
  index: string;
}

const { items, label, title, index } = Astro.props;
---

{
  items.length > 0 && (
    <section class="about-chapter about-journey" id="experience">
      <header class="about-section-head">
        <p class="about-section-label">
          <span>{index}</span>
          {label}
        </p>
        <h2>{title}</h2>
      </header>

      <ol class="about-journey-list">
        {items.map((item, itemIndex) => (
          <li style={item.color ? `--journey-item-color:${item.color}` : undefined}>
            <span class="about-journey-index" aria-hidden="true">
              {String(itemIndex + 1).padStart(2, '0')}
            </span>
            <span class="about-journey-date">{item.year}</span>
            <div class="about-journey-entry">
              <h3>{item.label}</h3>
              {item.meta && <p class="about-journey-meta">{item.meta}</p>}
            </div>
          </li>
        ))}
      </ol>
    </section>
  )
}
