---
import { ArrowDown, ArrowUpRight } from 'lucide-astro';

import AboutAvatar from './AboutAvatar.astro';

interface Mood {
  key: string;
  label: string;
}

interface Props {
  profile: { name: string; role: string };
  title: string;
  description: string;
  lede: string[];
  subtitle?: string;
  location?: string;
  status?: string;
  since?: string;
  sinceLabel: string;
  kicker: string;
  avatarLabel: string;
  avatarControls: string;
  moods: Mood[];
}

const {
  profile,
  title,
  description,
  lede,
  subtitle = '',
  location = '',
  status = '',
  since = '',
  sinceLabel,
  kicker,
  avatarLabel,
  avatarControls,
  moods,
} = Astro.props;

const meta = [profile.role, location].map((item) => item.trim()).filter(Boolean);
const ledeLines = lede.length > 0 ? lede : [description];
---

<header class="about-hero" id="top">
  <div class="about-hero-top">
    <p class="about-kicker"><span aria-hidden="true"></span>{kicker}</p>
    {
      status && (
        <p class="about-status">
          <i aria-hidden="true" />
          {status}
        </p>
      )
    }
  </div>

  <div class="about-hero-grid">
    <div class="about-hero-copy">
      <h1 id="about-title" aria-label={title}>
        <span>关于</span>
        <em>{profile.name}</em>
      </h1>
      <p class="about-hero-lede">
        {ledeLines.map((line) => <span>{line}</span>)}
      </p>
      <p class="about-hero-meta">
        {
          meta.map((item, index) => (
            <>
              {index > 0 && <i aria-hidden="true">·</i>}
              <span>{item}</span>
            </>
          ))
        }
        {
          since && (
            <>
              <i aria-hidden="true">·</i>
              <span>
                {sinceLabel} {since}
              </span>
            </>
          )
        }
      </p>
      <div class="about-hero-actions">
        <a class="about-button about-button-primary" href="#contact">
          写信给我
          <ArrowUpRight size={15} strokeWidth={1.8} aria-hidden="true" />
        </a>
        <a class="about-button about-button-quiet" href="#gallery">
          看看生活
          <ArrowDown size={15} strokeWidth={1.8} aria-hidden="true" />
        </a>
      </div>
    </div>

    <AboutAvatar moods={moods} label={avatarLabel} controlsLabel={avatarControls} note={subtitle} />
  </div>
</header>
