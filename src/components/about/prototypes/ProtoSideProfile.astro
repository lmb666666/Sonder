---
import type { AvatarMood } from '../../../lib/pixel-avatar';
import ProtoAvatar from './ProtoAvatar.astro';

interface Props {
  name: string;
  role: string;
  bio: string[];
  tags: string[];
  location: string;
  moods: { key: AvatarMood; label: string }[];
  avatarLabel: string;
  avatarControls: string;
}

const { name, role, bio, tags, location, moods, avatarLabel, avatarControls } = Astro.props;
---

<div class="proto-side-profile">
  <ProtoAvatar moods={moods} label={avatarLabel} controlsLabel={avatarControls} />
  <div class="proto-side-profile-copy">
    <p class="proto-profile-name">{name}</p>
    <p class="proto-profile-role">{role}</p>
    <p class="proto-mini-bio">{bio.join(' ')}</p>
    <ul class="proto-mini-tags">
      {tags.map((tag) => <li>{tag}</li>)}
    </ul>
    {location && <p class="proto-side-location">{location}</p>}
  </div>
</div>
