---
import type { AvatarMood } from '../../../lib/pixel-avatar';
import AboutAvatar from '../AboutAvatar.tsx';

interface Props {
  moods: { key: AvatarMood; label: string }[];
  label: string;
  controlsLabel: string;
}

const { moods, label, controlsLabel } = Astro.props;
---

<div class="proto-avatar">
  <AboutAvatar moods={moods} label={label} controlsLabel={controlsLabel} client:visible />
</div>
