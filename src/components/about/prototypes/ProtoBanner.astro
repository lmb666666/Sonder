---
import type { AvatarMood } from '../../../lib/pixel-avatar';
import ProtoAvatar from './ProtoAvatar.astro';

interface Props {
  name: string;
  lede: string[];
  tags: string[];
  location: string;
  moods: { key: AvatarMood; label: string }[];
  avatarLabel: string;
  avatarControls: string;
}

const { name, lede, tags, location, moods, avatarLabel, avatarControls } = Astro.props;
---

<header class="proto-banner">
  <ProtoAvatar moods={moods} label={avatarLabel} controlsLabel={avatarControls} />
  <div class="proto-banner-copy">
    <p class="proto-banner-kicker">About</p>
    <h1>关于 {name}</h1>
    <p class="proto-banner-lede">
      {lede.map((line) => <span>{line}</span>)}
    </p>
    <ul class="proto-banner-tags">
      {tags.map((tag) => <li>{tag}</li>)}
    </ul>
    {location && <p class="proto-banner-location">{location}</p>}
  </div>
</header>
