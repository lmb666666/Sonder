---
interface Props {
  index: string;
  label: string;
  title: string;
  class?: string;
}

const { index, label, title, class: className } = Astro.props;
---

<section class:list={['about-section', className]} data-about-section>
  <header class="about-section-head">
    <span>{index}</span>
    <p>{label}</p>
    <h2>{title}</h2>
  </header>
  <slot />
</section>
