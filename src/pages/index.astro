---
import { getCollection } from 'astro:content';
import IntroCard from '../components/cards/IntroCard.astro';
import ConnectCard from '../components/cards/ConnectCard.astro';
import ProfileCard from '../components/cards/ProfileCard.astro';
import DashboardFlow from '../components/layout/DashboardFlow.astro';
import BlogHeatmap from '../components/widgets/BlogHeatmap.astro';
import LatestUpdates from '../components/widgets/LatestUpdates.astro';
import SiteInfoCard from '../components/widgets/SiteInfoCard.astro';
import { getSiteConfig } from '../data/site';
import { demoMoments } from '../data/moments';
import { formatCount } from '../utils/word-count';
import BaseLayout from '../layouts/BaseLayout.astro';

const { home, profile, site } = await getSiteConfig();

// 侧栏统计：文章数 / 分类数 / 标签数
const posts = await getCollection('blog', ({ data }) => !data.draft);
const categoryCount = new Set(posts.flatMap((post) => post.data.categories)).size;
const tagCount = new Set(posts.flatMap((post) => post.data.tags ?? [])).size;

const stats = [
  { label: '文章数', value: formatCount(posts.length) },
  { label: '分类数', value: formatCount(categoryCount) },
  { label: '标签数', value: formatCount(tagCount) },
];

// 最新动态：演示数据按日期倒序取第一条；配置 Ech0 后动态页为运行时拉取，
// 首页仍以构建期可得的这份为准。
const newestMoment = [...demoMoments].sort((a, b) => Date.parse(b.date) - Date.parse(a.date))[0];
const momentSummary = newestMoment
  ? newestMoment.content.replace(/\s+/g, ' ').trim().slice(0, 30)
  : '';
const latestMoment = newestMoment
  ? {
      summary: momentSummary + (newestMoment.content.trim().length > 30 ? '…' : ''),
      date: new Date(newestMoment.date),
      href: '/moments',
    }
  : null;
---

<BaseLayout title={site.pageTitle} description={site.pageDescription}>
  <div class="publication-bg" aria-hidden="true"></div>
  <DashboardFlow>
    <Fragment slot="profile">
      <ProfileCard profile={profile} />
    </Fragment>

    <Fragment slot="intro">
      <IntroCard intro={home.intro} quote={home.quote} />
    </Fragment>

    {
      home.latest.showHeatmapLatest && (
        <Fragment slot="latest">
          <LatestUpdates
            count={home.latest.count}
            excludeDraft={home.latest.excludeDraft}
            latestMoment={latestMoment}
          />
        </Fragment>
      )
    }

    <Fragment slot="heatmap">
      <BlogHeatmap
        weeks={home.latest.heatmapWeeks}
        excludeDraft={home.latest.excludeDraft}
        startDate={home.latest.startDate || null}
        dateArchiveBaseHref={home.latest.dateArchiveBaseHref || undefined}
        stats={stats}
      />
    </Fragment>

    <Fragment slot="siteInfo">
      <SiteInfoCard />
    </Fragment>

    <Fragment slot="connect">
      <ConnectCard links={home.links} />
    </Fragment>
  </DashboardFlow>
</BaseLayout>
