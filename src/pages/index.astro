---
import { getCollection } from 'astro:content';
import IntroCard from '../components/home/IntroCard.astro';
import ConnectCard from '../components/home/ConnectCard.astro';
import ProfileCard from '../components/home/ProfileCard.astro';
import DashboardFlow from '../components/home/DashboardFlow.astro';
import Footer from '../components/Footer.astro';
import BlogHeatmap from '../components/home/BlogHeatmap.astro';
import LatestUpdates from '../components/home/LatestUpdates.astro';
import SiteInfoCard from '../components/home/SiteInfoCard.astro';
import { getSiteConfig } from '../config';
import { getAllCategories, getAllTags } from '../lib/content-groups';
import { formatCount } from '../lib/word-count';
import { getUiText } from '../lib/ui-text';
import Base from '../layouts/Base.astro';

const siteConfig = await getSiteConfig();
const { home, profile, site } = siteConfig;
const ui = getUiText(siteConfig);

// 侧栏统计：文章数 / 分类数 / 标签数
const posts = await getCollection('blog', ({ data }) => !data.draft);
const categoryCount = getAllCategories(posts).length;
const tagCount = getAllTags(posts).length;

const stats = [
  { label: ui.homeStats.posts, value: formatCount(posts.length, ui.locale) },
  { label: ui.homeStats.categories, value: formatCount(categoryCount, ui.locale) },
  { label: ui.homeStats.tags, value: formatCount(tagCount, ui.locale) },
];
---

<Base title={site.pageTitle} description={site.pageDescription}>
  <div class="publication-bg" aria-hidden="true"></div>
  <DashboardFlow>
    <Fragment slot="profile">
      <ProfileCard profile={profile} />
    </Fragment>

    <Fragment slot="intro">
      <IntroCard intro={home.intro} quote={home.quote} />
    </Fragment>

    {
      home.latest.showHeatmapLatest && (
        <Fragment slot="latest">
          <LatestUpdates count={home.latest.count} excludeDraft={home.latest.excludeDraft} />
        </Fragment>
      )
    }

    {
      home.latest.showHeatmapLatest && (
        <Fragment slot="heatmap">
          <BlogHeatmap
            weeks={home.latest.heatmapWeeks}
            excludeDraft={home.latest.excludeDraft}
            startDate={home.latest.startDate || null}
            stats={stats}
          />
        </Fragment>
      )
    }

    <Fragment slot="siteInfo">
      <SiteInfoCard />
    </Fragment>

    <Fragment slot="connect">
      <ConnectCard links={home.links} />
    </Fragment>
  </DashboardFlow>
  <Fragment slot="footer">
    <div class="home-footer">
      <Footer />
    </div>
  </Fragment>
</Base>

<style>
  /* 桌面首页的版权在站点信息卡里；移动端站点信息收起后使用全站页脚 */
  .home-footer {
    display: none;
  }

  @media (max-width: 820px) {
    .home-footer {
      display: block;
    }
  }
</style>
