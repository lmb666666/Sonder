              class="proto-span-2"
              index="03"
              label={ui.about.gallery}
              title={ui.about.galleryTitle}
            >
              <AboutGallery />
            </ProtoBlock>
            <ProtoBlock
              class="proto-span-2"
              index="04"
              label={ui.about.tech}
              title={ui.about.techTitle}
            >
              <AboutTechStack
                tools={about.data.tools}
                hint={ui.about.techHint}
                resetLabel={ui.about.techReset}
              />
            </ProtoBlock>
            <ProtoBlock
              class="proto-span-2"
              index="05"
              label={ui.about.tokens}
              title={ui.about.tokenTitle}
            >
              <AboutTokens
                calendar={tokenCalendar}
                summary={tokenSummary}
                locale={ui.locale}
                cardTitle={ui.about.tokenCardTitle}
                cardSubtitle={ui.about.tokenCardSubtitle}
                labels={tokenLabels}
              />
            </ProtoBlock>
            <ProtoBlock
              class="proto-span-2"
              index="06"
              label={ui.about.contact}
              title={ui.about.contactTitle}
            >
              <AboutContact
                links={contactLinks}
                label={ui.about.contact}
                note={ui.about.contactNote}
                status={ui.about.contactStatus}
              />
            </ProtoBlock>
          </div>
        </div>
      )
    }

    {
      variant === '10' && (
        <div class="proto-layout proto-10">
          <ProtoBanner
            name={profile.name}
            lede={about.data.lede}
            tags={about.data.tags}
            location={about.data.location}
            moods={moods}
            avatarLabel={ui.about.avatarLabel}
            avatarControls={ui.about.avatarControls}
          />
          <AboutGallery />
          <div class="proto-narrow">
            <ProtoFacts mbti={about.data.mbti} now={about.data.now} nowLabel={ui.about.now} />
            <ProtoBlock index="01" label={ui.about.journey} title={ui.about.journeyTitle}>
              <AboutTimeline
                items={about.data.career}
                labels={{ study: ui.about.trackStudy, blog: ui.about.trackBlog }}
              />
            </ProtoBlock>
          </div>
          <ProtoBlock
            class="proto-wide"
            index="02"
            label={ui.about.works}
            title={ui.about.worksTitle}
          >
            <AboutWorks projects={projects} covers={[steelCover, cocoaCover]} />
          </ProtoBlock>
          <div class="proto-split">
            <ProtoBlock index="03" label={ui.about.skills} title={ui.about.skillsTitle}>
              <AboutSkills levels={about.data.skillLevels} focus={about.data.focus} />
            </ProtoBlock>
            <ProtoBlock index="04" label={ui.about.tech} title={ui.about.techTitle}>
              <AboutTechStack
                tools={about.data.tools}
                hint={ui.about.techHint}
                resetLabel={ui.about.techReset}
              />
            </ProtoBlock>
          </div>
          <ProtoBlock
            class="proto-wide"
            index="05"
            label={ui.about.tokens}
            title={ui.about.tokenTitle}
          >
            <AboutTokens
              calendar={tokenCalendar}
              summary={tokenSummary}
              locale={ui.locale}
              cardTitle={ui.about.tokenCardTitle}
              cardSubtitle={ui.about.tokenCardSubtitle}
              labels={tokenLabels}
            />
          </ProtoBlock>
          <ProtoBlock
            class="proto-wide"
            index="06"
            label={ui.about.contact}
            title={ui.about.contactTitle}
          >
            <AboutContact
              links={contactLinks}
              label={ui.about.contact}
              note={ui.about.contactNote}
              status={ui.about.contactStatus}
            />
          </ProtoBlock>
        </div>
      )
    }
  </main>
</Base>

