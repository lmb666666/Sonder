---
import { getCollection } from 'astro:content';

import AboutContact from '../../../components/about/AboutContact.astro';
import AboutGallery from '../../../components/about/AboutGallery.astro';
import AboutSkills from '../../../components/about/AboutSkills.astro';
import AboutTechStack from '../../../components/about/AboutTechStack.astro';
import AboutTimeline from '../../../components/about/AboutTimeline.astro';
import AboutTokens from '../../../components/about/AboutTokens.astro';
import AboutWorks from '../../../components/about/AboutWorks.astro';
import ProtoAvatar from '../../../components/about/prototypes/ProtoAvatar.astro';
import ProtoBanner from '../../../components/about/prototypes/ProtoBanner.astro';
import ProtoBlock from '../../../components/about/prototypes/ProtoBlock.astro';
import ProtoFacts from '../../../components/about/prototypes/ProtoFacts.astro';
import ProtoProfile from '../../../components/about/prototypes/ProtoProfile.astro';
import ProtoSideProfile from '../../../components/about/prototypes/ProtoSideProfile.astro';
import { getSiteConfig } from '../../../config';
import { tokenUsage } from '../../../data/token-usage';
import Base from '../../../layouts/Base.astro';
import { prototypeVariants } from '../../../lib/about-prototypes';
import { sortBlogPostsForArchive } from '../../../lib/content-dates';
import type { AvatarMood } from '../../../lib/pixel-avatar';
import {
  buildTokenCalendar,
  expandTokenUsage,
  summarizeTokenUsage,
} from '../../../lib/token-usage';
import { getUiText } from '../../../lib/ui-text';
import '../../../styles/about.css';
import '../../../styles/about-prototypes.css';

import cocoaCover from '../../../assets/figure/covers/cover-08-cocoa.png';
import steelCover from '../../../assets/figure/covers/cover-13-steel.png';

export function getStaticPaths() {
  const exposePrototypes = import.meta.env.DEV || process.env.VERCEL_ENV === 'preview';
  if (!exposePrototypes) return [];
  return Object.keys(prototypeVariants).map((variant) => ({
    params: { variant },
  }));
}

const { variant = '01' } = Astro.params;
const meta =
  prototypeVariants[variant as keyof typeof prototypeVariants] ?? prototypeVariants['01'];

const [about] = await getCollection('about');
if (!about) throw new Error('Missing about content.');

const siteConfig = await getSiteConfig();
const { home, profile } = siteConfig;
const ui = getUiText(siteConfig);
const projects = sortBlogPostsForArchive(
  await getCollection('projects', ({ data }) => !data.draft),
);

const bio = about.data.bio.length > 0 ? about.data.bio : about.data.lede;
const moods = (Object.entries(ui.about.avatarMoods) as [AvatarMood, string][]).map(
  ([key, label]) => ({ key, label }),
);
const contactLinks = [
  {
    label: 'Bilibili',
    icon: 'bilibili',
    tooltip: 'https://space.bilibili.com/477296514',
    copy: false,
  },
  ...home.links,
];

const tokenDays = expandTokenUsage(tokenUsage);
const tokenSummary = summarizeTokenUsage(tokenDays);
const tokenCalendar = buildTokenCalendar(tokenUsage, ui.locale);

const tokenLabels = {
  today: ui.about.tokenToday,
  total: ui.about.tokenTotal,
  peak: ui.about.tokenPeak,
  current: ui.about.tokenCurrent,
  longest: ui.about.tokenLongest,
  less: ui.about.tokenLess,
  more: ui.about.tokenMore,
  hint: ui.about.tokenHint,
  weekdays: ui.about.tokenWeekdays,
};

const previous = String(Math.max(1, Number(variant) - 1)).padStart(2, '0');
const next = String(Math.min(10, Number(variant) + 1)).padStart(2, '0');
---

<Base
  title={`关于页原型 ${variant} · ${meta.title}`}
  description={`Sonder 关于页原型方案 ${variant}`}
>
  <meta slot="head" name="robots" content="noindex" />

  <main class="about-page proto-page" data-about-page>
    <nav class="proto-switcher" aria-label="原型切换">
      <a href="/about/prototypes">全部原型</a>
      <span>方案 {variant} · {meta.title}</span>
      <div>
        <a href={`/about/prototypes/${previous}`} aria-label="上一个原型">←</a>
        <a href={`/about/prototypes/${next}`} aria-label="下一个原型">→</a>
      </div>
    </nav>

    {
      variant === '01' && (
        <div class="proto-layout proto-01">
          <aside class="proto-side">
            <ProtoSideProfile
              name={profile.name}
              role={profile.role}
              bio={bio}
              tags={about.data.tags}
              location={about.data.location}
              moods={moods}
              avatarLabel={ui.about.avatarLabel}
              avatarControls={ui.about.avatarControls}
            />
          </aside>
          <div class="proto-main">
            <ProtoBlock index="01" label={ui.about.profile} title="性格与现在">
              <ProtoFacts mbti={about.data.mbti} now={about.data.now} nowLabel={ui.about.now} />
            </ProtoBlock>
            <ProtoBlock index="02" label={ui.about.journey} title={ui.about.journeyTitle}>
              <AboutTimeline
                items={about.data.career}
                labels={{ study: ui.about.trackStudy, blog: ui.about.trackBlog }}
              />
            </ProtoBlock>
            <ProtoBlock index="03" label={ui.about.skills} title={ui.about.skillsTitle}>
              <AboutSkills levels={about.data.skillLevels} focus={about.data.focus} />
            </ProtoBlock>
            <ProtoBlock index="04" label={ui.about.tech} title={ui.about.techTitle}>
              <AboutTechStack
                tools={about.data.tools}
                hint={ui.about.techHint}
                resetLabel={ui.about.techReset}
              />
            </ProtoBlock>
            <ProtoBlock index="05" label={ui.about.tokens} title={ui.about.tokenTitle}>
              <AboutTokens
                calendar={tokenCalendar}
                summary={tokenSummary}
                locale={ui.locale}
                cardTitle={ui.about.tokenCardTitle}
                cardSubtitle={ui.about.tokenCardSubtitle}
                labels={tokenLabels}
              />
            </ProtoBlock>
            <ProtoBlock index="06" label={ui.about.works} title={ui.about.worksTitle}>
              <AboutWorks projects={projects} covers={[steelCover, cocoaCover]} />
            </ProtoBlock>
            <ProtoBlock index="07" label={ui.about.gallery} title={ui.about.galleryTitle}>
              <AboutGallery />
            </ProtoBlock>
            <ProtoBlock index="08" label={ui.about.contact} title={ui.about.contactTitle}>
              <AboutContact
                links={contactLinks}
                label={ui.about.contact}
                note={ui.about.contactNote}
                status={ui.about.contactStatus}
              />
            </ProtoBlock>
          </div>
        </div>
