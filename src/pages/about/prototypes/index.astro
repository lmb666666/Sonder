---
import Base from '../../../layouts/Base.astro';
import '../../../styles/about.css';
import '../../../styles/about-prototypes.css';

const exposePrototypes = import.meta.env.DEV || process.env.VERCEL_ENV === 'preview';
if (!exposePrototypes) return Astro.redirect('/about');

const prototypes = [
  { id: '01', title: '左资料栏 + 右单栏', note: '头像与资料固定在左，右侧一条阅读流。' },
  { id: '02', title: '左资料栏 + 右双列', note: '左栏固定，右侧两列卡片，信息密度更高。' },
  { id: '03', title: '右资料栏 + 左内容', note: '完全镜像的左右结构，资料在右侧。' },
  { id: '04', title: '双侧栏', note: '左资料、中内容、右 MBTI / 现在 / 联系。' },
  { id: '05', title: '顶部横幅 + 居中单栏', note: '横幅头像，正文 800px 单栏。' },
  { id: '06', title: '顶部横幅 + 双列瀑布', note: '横幅之下是两列不等高卡片。' },
  { id: '07', title: '杂志跨页', note: '头像与经历做开篇跨页，作品与图像做图版。' },
  { id: '08', title: '统一 Bento', note: '12 栏卡片拼贴，技能卡作为基准。' },
  { id: '09', title: '中央年表', note: '一条中央竖线串起经历与内容。' },
  { id: '10', title: '画册 / 展陈', note: '全宽图像带和窄文字栏交替。' },
];
---

<Base title="关于页原型" description="Sonder 关于页十套布局原型">
  <meta slot="head" name="robots" content="noindex" />
  <main class="about-page proto-index">
    <header class="proto-index-head">
      <p>ABOUT / PROTOTYPES</p>
      <h1>十套关于页布局</h1>
      <p>每套使用同一份内容，只改变骨架、节奏和视觉重心。点进去实际滚动体验。</p>
      <a href="/about">← 返回当前关于页</a>
    </header>

    <ol class="proto-index-list">
      {
        prototypes.map((item) => (
          <li>
            <a href={`/about/prototypes/${item.id}`}>
              <span>{item.id}</span>
              <div>
                <strong>{item.title}</strong>
                <p>{item.note}</p>
              </div>
              <i aria-hidden="true">→</i>
            </a>
          </li>
        ))
      }
    </ol>
  </main>
</Base>
