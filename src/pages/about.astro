---
import { getEntry } from 'astro:content';

import AboutBanner from '../components/about/AboutBanner.astro';
import AboutContact from '../components/about/AboutContact.astro';
import AboutExperience from '../components/about/AboutExperience.astro';
import AboutProfile from '../components/about/AboutProfile.astro';
import AboutSection from '../components/about/AboutSection.astro';
import AboutTechStack from '../components/about/AboutTechStack.astro';
import AboutTokens from '../components/about/AboutTokens.astro';
import AboutWorks from '../components/about/AboutWorks.astro';
import { getSiteConfig } from '../config';
import Base from '../layouts/Base.astro';
import { expandTokenUsage, summarizeTokenUsage } from '../lib/token-usage';
import { getUiText } from '../lib/ui-text';
import { withBase } from '../lib/url';
import '../styles/about.css';
import '../styles/about-final.css';
import '../styles/about-profile.css';

const aboutEntry = await getEntry('about', 'about');
const tokenUsageEntry = await getEntry('tokenUsage', 'tokenUsage');

if (!aboutEntry) {
  throw new Error('Missing src/data/about.yml content entry.');
}

if (!tokenUsageEntry) {
  throw new Error('Missing src/data/token-usage.yml content entry.');
}

const about = aboutEntry.data;
const siteConfig = await getSiteConfig();
const { profile } = siteConfig;
const ui = getUiText(siteConfig);

const contactLinks = about.contact.links;

const tokenDays = expandTokenUsage(tokenUsageEntry.data);
const tokenSummary = summarizeTokenUsage(tokenDays);

const tokenLabels = {
  today: ui.about.tokenToday,
  total: ui.about.tokenTotal,
  peak: ui.about.tokenPeak,
  current: ui.about.tokenCurrent,
  longest: ui.about.tokenLongest,
  range: ui.about.tokenRange,
  dayUnit: ui.about.tokenDayUnit,
};
---

<Base title={about.title} description={about.description}>
  <main class="about-page about-final" data-pagefind-body data-about-page>
    <AboutBanner
      title={ui.about.title}
      tags={about.banner.tags}
      avatar={withBase(profile.avatar)}
      avatarLabel={ui.about.avatarLabel}
    />

    <div class="about-final-sections">
      <AboutSection index="01" label={ui.about.profile}>
        <AboutProfile
          mbti={about.profile.mbti}
          bio={about.profile.bio}
          location={about.profile.location}
          status={about.profile.status}
          school={about.profile.school}
          photo={about.profile.photo ? withBase(about.profile.photo) : ''}
          labels={{
            bio: ui.about.bioLabel,
            location: ui.about.location,
            identity: ui.about.identity,
            school: ui.about.school,
            personality: ui.about.personality,
            learnMore: ui.about.learnMore,
            photoAlt: ui.about.photoAlt,
          }}
        />
      </AboutSection>

      <AboutSection index="02" label={ui.about.journey}>
        <AboutExperience items={about.experience} />
      </AboutSection>

      <AboutSection index="03" label={ui.about.tech}>
        <AboutTechStack
          tools={about.skills}
          statement={about.techStatement}
          resetLabel={ui.about.techReset}
          boardLabel={ui.about.techBoardLabel}
        />
      </AboutSection>

      <AboutSection index="04" label={ui.about.tokens}>
        <AboutTokens
          days={tokenDays}
          summary={tokenSummary}
          locale={ui.locale}
          cardTitle={ui.about.tokenCardTitle}
          labels={tokenLabels}
        />
      </AboutSection>

      <AboutSection class="about-works-wide" index="05" label={ui.about.works}>
        <AboutWorks works={about.works} />
      </AboutSection>

      <AboutSection index="06" label={ui.about.contact}>
        <AboutContact links={contactLinks} label={ui.about.contact} note={ui.about.contactNote} />
      </AboutSection>
    </div>
  </main>
</Base>

<script>
  import '../lib/about-page';
</script>
