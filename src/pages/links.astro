---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import FriendLinkApplication from '../components/links/FriendLinkApplication.astro';
import FriendLinkCard from '../components/links/FriendLinkCard.astro';
import '../styles/friend-link-card.css';
import '../styles/links-page.css';
import { resolveFriendLinkGroups, type FriendSourceDeps } from '../lib/friend-sources';
import { buildYoulinClientConfig } from '../lib/youlin';
import { getSiteConfig } from '../config';
import {
  resolveApplyProvider,
  resolveYoulinConfig,
  shouldFetchYoulinFirst,
  youlinApplyUrl,
  youlinCircleUrl,
  youlinLinksUrl,
} from '../config/youlin';
import { parseGitHubRepository } from '../lib/github';
import { getUiText } from '../lib/ui-text';
import { withBase } from '../lib/url';
import PageHero from '../components/PageHero.astro';

const friendsEntry = await getEntry('friends', 'friends');
if (!friendsEntry) {
  throw new Error('Missing src/data/friends.yml content entry.');
}
const friendLinkGroups = friendsEntry.data.groups;

const siteConfig = await getSiteConfig();
const { site, pages } = siteConfig;
const profile = site.profile;
const pageMeta = pages.links;
const ui = getUiText(siteConfig);
const youlin = resolveYoulinConfig(siteConfig.integrations.youlin);
const applyProvider = resolveApplyProvider(youlin.apply.provider, youlin.baseUrl, site.repository);
const issueRepository = applyProvider === 'github' ? parseGitHubRepository(site.repository) : null;

const sourceDeps: FriendSourceDeps = {
  localGroups: friendLinkGroups,
};

const friendCircle = siteConfig.integrations.friends;
const circleEnabled = friendCircle.enable && friendCircle.provider !== 'none';
const circleProvider = circleEnabled ? friendCircle.provider : null;
const useYoulinCircle = circleProvider === 'youlin';
const useFclCircle = circleProvider === 'fcl';
const fclUrl = useFclCircle ? friendCircle.fcl.apiUrl.trim() : '';
const clientFeedSrc = useFclCircle && fclUrl ? fclUrl : '';

const clientLinks = shouldFetchYoulinFirst(youlin.links.mode, youlin.links.sources, youlin.baseUrl);
const clientCircle = useYoulinCircle && Boolean(youlin.baseUrl);

const linksResolved = await resolveFriendLinkGroups(youlin, sourceDeps, {
  skipYoulin: clientLinks,
});

for (const error of linksResolved.errors) {
  console.warn(`[sonder friends] ${error}`);
}

const groups = linksResolved.groups;
const totalLinks = groups.reduce((count, group) => count + group.items.length, 0);
const rssCount = groups.reduce(
  (count, group) => count + group.items.filter((item) => item.rss).length,
  0,
);

const pageSize = friendCircle.pageSize;
const circleSummaryText =
  clientFeedSrc || clientCircle ? ui.links.circleLoading : ui.links.circleSummary(0, 0, 0);

const linksUrl = clientLinks ? youlinLinksUrl(youlin.baseUrl, youlin.links.group) : null;
const circleUrl = clientCircle ? youlinCircleUrl(youlin.baseUrl, youlin.circle.limit) : null;
const clientConfig = buildYoulinClientConfig({
  linksUrl,
  circleUrl,
  timeoutMs: youlin.timeoutMs,
  pageSize,
  messages: {
    note: ui.links.noteTemplate,
    circleSummary: ui.links.circleSummaryTemplate,
    unavailable: ui.links.youlinUnavailable,
    emptyLinks: ui.links.emptyLinks,
    emptyCircle: ui.links.emptyCircle,
  },
});

const linksNotices: string[] = [];
if (linksResolved.youlinTried && linksResolved.source !== 'youlin') {
  linksNotices.push(ui.links.youlinLinksFallback);
}
const linksNotice = linksNotices.join(' ');

const circleNotices: string[] = [];
if (circleEnabled && useFclCircle && !fclUrl) {
  circleNotices.push(ui.links.circleLoadFailed);
}
if (circleEnabled && useYoulinCircle && !youlin.baseUrl) {
  circleNotices.push(ui.links.youlinUnavailable);
}
const circleNotice = circleNotices.join(' ');
---

<Base title={`${pageMeta.title} | ${site.title}`} description={pageMeta.subtitle}>
  <main class="links-page" data-pagefind-body>
    <PageHero kicker={pageMeta.kicker} title={pageMeta.title} subtitle={pageMeta.subtitle}>
      <p class="archive-note" data-links-note>{ui.links.note(totalLinks, rssCount)}</p>
    </PageHero>

    <p class="links-source-note" data-links-notice hidden={!linksNotice}>{linksNotice}</p>

    <div data-friend-links>
      {
        groups.length === 0 ? (
          <p class="links-empty">{ui.links.emptyLinks}</p>
        ) : (
          groups.map((group, index) => (
            <section class="links-group" aria-labelledby={`links-group-${index}`}>
              <div class="links-group-heading">
                <h2 id={`links-group-${index}`}>{group.title}</h2>
                {group.description && <p>{group.description}</p>}
              </div>
              <FriendLinkCard items={group.items} columns={4} />
            </section>
          ))
        )
      }
    </div>

    {
      circleEnabled && (
        <section class="links-circle" aria-label={ui.links.circleAria}>
          <div class="links-group-heading">
            <h2>{ui.links.circleTitle}</h2>
            <p data-circle-summary>{circleSummaryText}</p>
          </div>

          <p class="links-source-note" data-circle-notice hidden={!circleNotice}>
            {circleNotice}
          </p>

          <div class="circle-grid" data-circle-list data-circle-size={pageSize}>
            <p
              class="links-empty"
              data-circle-empty
              hidden={Boolean(clientFeedSrc || clientCircle)}
            >
              {ui.links.emptyCircle}
            </p>
          </div>

          <div class="circle-actions" hidden>
            <button class="circle-more" type="button" data-circle-more hidden>
              {ui.links.expandMore}
            </button>
          </div>
        </section>
      )
    }

    {
      clientFeedSrc && (
        <script
          type="application/json"
          data-circle-feed-config
          set:html={JSON.stringify({
            src: clientFeedSrc,
            pageSize,
            messages: {
              summary: ui.links.circleSummaryTemplate,
              loading: ui.links.circleLoading,
              empty: ui.links.emptyCircle,
              loadMore: ui.links.expandMore,
              error: ui.links.circleLoadFailed,
            },
          }).replace(/</g, '\\u003c')}
        />
      )
    }

    {
      applyProvider === 'youlin' && (
        <section class="links-apply" aria-label={ui.links.applyAria}>
          <FriendLinkApplication
            provider="youlin"
            submitUrl={youlinApplyUrl(youlin.baseUrl)}
            turnstileSiteKey={youlin.apply.turnstileSiteKey}
            submitTimeoutMs={youlin.apply.timeoutMs}
            title={ui.links.applyTitle}
            description={ui.links.applyYoulinDescription}
            applyLabel={ui.links.applyYoulinLabel}
            applyHint={ui.links.applyYoulinHint}
            initialValue={{
              name: profile.name,
              url: site.url,
              avatar: new URL(withBase(profile.avatar), site.url).toString(),
              rss: `${site.url}/rss.xml`,
              bio: profile.role,
            }}
          />
        </section>
      )
    }

    {
      applyProvider === 'github' && issueRepository && (
        <section class="links-apply" aria-label={ui.links.applyAria}>
          <FriendLinkApplication
            repository={issueRepository}
            title={ui.links.applyTitle}
            description={ui.links.applyDescription}
            labels={['friend-link']}
            initialValue={{
              name: profile.name,
              url: site.url,
              avatar: new URL(withBase(profile.avatar), site.url).toString(),
              rss: `${site.url}/rss.xml`,
              bio: profile.role,
            }}
          />
        </section>
      )
    }

    {
      clientConfig && (
        <script
          type="application/json"
          data-youlin-client-config
          set:html={JSON.stringify(clientConfig).replace(/</g, '\\u003c')}
        />
      )
    }
  </main>

  <script>
    import { bindCircleMore } from '../lib/circle-more';
    import { initCircleFeed } from '../lib/circle-feed';

    const boot = () => {
      bindCircleMore();
      initCircleFeed();
      if (document.querySelector('script[data-youlin-client-config]')) {
        void import('../lib/youlin-client').then(({ initYoulinClient }) => initYoulinClient());
      }
    };

    document.addEventListener('astro:page-load', boot);
    if (document.readyState === 'loading')
      document.addEventListener('DOMContentLoaded', boot, { once: true });
    else boot();
  </script>
</Base>
