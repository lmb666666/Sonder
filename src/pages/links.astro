---
import Base from '../layouts/Base.astro';
import { existsSync } from 'node:fs';
import { readFile } from 'node:fs/promises';
import { resolve } from 'node:path';
import FriendLinkApplication from '../components/links/FriendLinkApplication.astro';
import FriendLinkCard from '../components/links/FriendLinkCard.astro';
import YoulinApplyCard from '../components/links/YoulinApplyCard.astro';
import '../styles/friend-link-card.css';
import '../styles/links-page.css';
import { crawlFriendPosts, type FriendCircleFeed } from '../lib/friend-data';
import {
  resolveFriendCircle,
  resolveFriendLinkGroups,
  type FriendSourceDeps,
} from '../lib/friend-sources';
import { buildYoulinClientConfig, toDisplayDate } from '../lib/youlin';
import { getSiteConfig } from '../config';
import {
  resolveApplyProvider,
  resolveYoulinConfig,
  shouldFetchYoulinFirst,
  youlinApplyUrl,
  youlinCircleUrl,
  youlinLinksUrl,
} from '../config/youlin';
import { parseGitHubRepository } from '../lib/github';
import { getUiText } from '../lib/ui-text';
import { withBase } from '../lib/url';
import PageHero from '../components/PageHero.astro';
import demoFeed from '../data/friend-circle-demo.json';
import { friendLinkGroups } from '../data/friends';

const siteConfig = await getSiteConfig();
const { site, profile, pages } = siteConfig;
const pageMeta = pages.links;
const ui = getUiText(siteConfig);
const youlin = resolveYoulinConfig(siteConfig.youlin);
const applyProvider = resolveApplyProvider(youlin.apply.provider, youlin.baseUrl, site.repository);
const issueRepository = applyProvider === 'github' ? parseGitHubRepository(site.repository) : null;

const readPublic = async (file: string) => {
  const path = resolve(process.cwd(), 'public', file.replace(/^\/+/, ''));
  return existsSync(path) ? readFile(path, 'utf8') : null;
};

const sourceDeps: FriendSourceDeps = {
  localGroups: friendLinkGroups,
  demo: demoFeed as unknown as FriendCircleFeed,
  readPublic,
  crawl: crawlFriendPosts,
};

const linksResolved = await resolveFriendLinkGroups(youlin, sourceDeps, {
  skipYoulin: youlin.links.mode === 'client',
});
const circleResolved = await resolveFriendCircle(youlin, sourceDeps, {
  links: linksResolved.groups,
  feedSrc: siteConfig.friendCircle.feed_src,
  skipYoulin: youlin.circle.mode === 'client',
});

for (const error of [...linksResolved.errors, ...circleResolved.errors]) {
  console.warn(`[sonder friends] ${error}`);
}

const groups = linksResolved.groups;
const totalLinks = groups.reduce((count, group) => count + group.items.length, 0);
const rssCount = groups.reduce(
  (count, group) => count + group.items.filter((item) => item.rss).length,
  0,
);

const circlePosts = circleResolved.posts;
const activeCount =
  circleResolved.stats?.active || new Set(circlePosts.map((post) => post.author)).size;
const circleFriendsCount = circleResolved.friendsCount;
const pageSize = siteConfig.friendCircle.pageSize;
const initialCount = Math.min(circlePosts.length, pageSize);
const shortDate = (post: { date?: string }) => toDisplayDate(post.date);

const linksUrl = shouldFetchYoulinFirst(youlin.links.mode, youlin.links.sources, youlin.baseUrl)
  ? youlinLinksUrl(youlin.baseUrl, youlin.links.group)
  : null;
const circleUrl = shouldFetchYoulinFirst(youlin.circle.mode, youlin.circle.sources, youlin.baseUrl)
  ? youlinCircleUrl(youlin.baseUrl, youlin.circle.limit)
  : null;
const clientConfig = buildYoulinClientConfig({
  linksUrl,
  circleUrl,
  timeoutMs: youlin.timeoutMs,
  pageSize,
  messages: {
    note: ui.links.noteTemplate,
    circleSummary: ui.links.circleSummaryTemplate,
    unavailable: ui.links.youlinUnavailable,
    emptyLinks: ui.links.emptyLinks,
    emptyCircle: ui.links.emptyCircle,
  },
});

const notices: string[] = [];
if (linksResolved.youlinTried && linksResolved.source !== 'youlin') {
  notices.push(ui.links.youlinLinksFallback);
}
if (circleResolved.youlinTried && circleResolved.source !== 'youlin') {
  notices.push(ui.links.youlinCircleFallback);
}
if (circleResolved.source === 'demo') {
  const feedError = circleResolved.errors.find((error) => error.startsWith('friendcircle:'));
  notices.push(
    feedError ? ui.links.feedError(feedError.replace(/^friendcircle:\s*/, '')) : ui.links.feedDemo,
  );
}
const sourceNotice = notices.join(' ');
---

<Base title={`${pageMeta.title} | ${site.title}`} description={pageMeta.subtitle}>
  <main class="links-page" data-pagefind-body>
    <PageHero kicker={pageMeta.kicker} title={pageMeta.title} subtitle={pageMeta.subtitle}>
      <p class="archive-note" data-links-note>{ui.links.note(totalLinks, rssCount)}</p>
    </PageHero>

    <p class="links-source-note" data-source-note hidden={!sourceNotice}>{sourceNotice}</p>

    <div data-friend-links>
      {
        groups.length === 0 ? (
          <p class="links-empty">{ui.links.emptyLinks}</p>
        ) : (
          groups.map((group, index) => (
            <section class="links-group" aria-labelledby={`links-group-${index}`}>
              <div class="links-group-heading">
                <h2 id={`links-group-${index}`}>{group.title}</h2>
                {group.description && <p>{group.description}</p>}
              </div>
              <FriendLinkCard items={group.items} columns={4} />
            </section>
          ))
        )
      }
    </div>

    <section class="links-circle" aria-label={ui.links.circleAria}>
      <div class="links-group-heading">
        <h2>{ui.links.circleTitle}</h2>
        <p data-circle-summary>
          {ui.links.circleSummary(circleFriendsCount, activeCount, circlePosts.length)}
        </p>
      </div>

      <div class="circle-grid" data-circle-list data-circle-size={pageSize}>
        {circlePosts.length === 0 && <p class="links-empty">{ui.links.emptyCircle}</p>}
        {
          circlePosts.map((post, index) => (
            <article
              class:list={['circle-card', { 'circle-card--hidden': index >= initialCount }]}
              data-circle-card
            >
              <a
                class="circle-card__author"
                href={post.authorUrl || post.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class="circle-card__avatar" aria-hidden="true">
                  {post.avatar ? (
                    <img src={post.avatar} alt="" loading="lazy" decoding="async" />
                  ) : (
                    <span>{(post.author[0] || '?').toUpperCase()}</span>
                  )}
                </span>
                <span class="circle-card__name">{post.author}</span>
              </a>
              <a
                class="circle-card__title"
                href={post.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                {post.title}
              </a>
              <footer class="circle-card__meta">
                {post.tags?.length ? (
                  <span class="circle-card__tags">
                    {post.tags.slice(0, 3).map((tag) => (
                      <span>#{tag}</span>
                    ))}
                  </span>
                ) : null}
                {post.date && <time datetime={shortDate(post)}>{shortDate(post)}</time>}
              </footer>
            </article>
          ))
        }
      </div>

      <div class="circle-actions">
        <button
          class="circle-more"
          type="button"
          data-circle-more
          hidden={circlePosts.length <= pageSize}
        >
          {ui.links.expandMore}
        </button>
      </div>
    </section>

    {
      applyProvider === 'youlin' && (
        <YoulinApplyCard
          href={youlinApplyUrl(youlin.baseUrl)}
          title={ui.links.applyTitle}
          description={ui.links.applyYoulinDescription}
          label={ui.links.applyYoulinLabel}
        />
      )
    }

    {
      applyProvider === 'github' && issueRepository && (
        <section class="links-apply" aria-label={ui.links.applyAria}>
          <FriendLinkApplication
            repository={issueRepository}
            title={ui.links.applyTitle}
            description={ui.links.applyDescription}
            labels={['friend-link']}
            initialValue={{
              name: profile.name,
              url: site.url,
              avatar: new URL(withBase(profile.avatar), site.url).toString(),
              rss: `${site.url}/rss.xml`,
              bio: profile.role,
            }}
          />
        </section>
      )
    }

    {
      clientConfig && (
        <script
          type="application/json"
          data-youlin-client-config
          set:html={JSON.stringify(clientConfig).replace(/</g, '\\u003c')}
        />
      )
    }
  </main>

  <script>
    import { bindCircleMore } from '../lib/circle-more';

    const boot = () => {
      bindCircleMore();
      if (document.querySelector('script[data-youlin-client-config]')) {
        void import('../lib/youlin-client').then(({ initYoulinClient }) => initYoulinClient());
      }
    };

    document.addEventListener('astro:page-load', boot);
    if (document.readyState === 'loading')
      document.addEventListener('DOMContentLoaded', boot, { once: true });
    else boot();
  </script>
</Base>
