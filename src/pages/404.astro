---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = await getCollection('blog', ({ data }) => !data.draft);

function withBase(href: string) {
  if (href === '/') {
    return `${basePath}/` || '/';
  }

  return `${basePath}${href.startsWith('/') ? href : `/${href}`}`;
}

const postHrefs = posts.map((post) => withBase(`/blog/${post.id}/`));
---

<BaseLayout title="页面未找到" description="请求的页面不存在。">
  <div class="publication-bg" aria-hidden="true"></div>
  <main class="not-found-shell" aria-labelledby="not-found-title">
    <section class="not-found-panel">
      <p class="not-found-kicker">404</p>
      <h1 id="not-found-title">页面未找到</h1>
      <nav class="not-found-actions" aria-label="404 页面导航">
        <a class="primary-link" href={withBase('/')}>回到首页</a>
        <a href={withBase('/blog')} data-random-post>随机文章</a>
      </nav>
      <script is:inline define:vars={{ postHrefs }}>
        (() => {
          const link = document.querySelector('[data-random-post]');
          if (!(link instanceof HTMLAnchorElement) || postHrefs.length === 0) return;
          link.addEventListener('click', (event) => {
            if (
              event.button !== 0 ||
              event.metaKey ||
              event.ctrlKey ||
              event.shiftKey ||
              event.altKey
            ) {
              return;
            }
            event.preventDefault();
            window.location.href = postHrefs[Math.floor(Math.random() * postHrefs.length)];
          });
        })();
      </script>
    </section>
  </main>
</BaseLayout>

<style>
  .not-found-shell {
    display: grid;
    min-height: calc(100vh - 56px);
    place-items: center;
    padding-top: 116px;
    padding-bottom: 72px;
  }

  .not-found-panel {
    width: min(100%, 860px);
    padding: clamp(22px, 5vw, 56px) clamp(6px, 3vw, 18px);
    animation: not-found-in 420ms ease both;
  }

  .not-found-kicker {
    margin: 0 0 12px;
    color: var(--paper-accent);
    font-family: var(--font-ui-label);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  h1 {
    max-width: 11em;
    margin: 0;
    color: var(--paper-ink);
    font-size: clamp(2.3rem, 7vw, 4.6rem);
    line-height: 1.08;
  }

  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }

  .not-found-actions a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 8px 14px;
    border: 1px solid var(--paper-line);
    border-radius: 8px;
    background: var(--paper-control);
    color: var(--paper-ink);
    font-family: var(--font-ui-label);
    font-size: 0.88rem;
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      background 180ms ease,
      color 180ms ease;
  }

  .not-found-actions a:hover,
  .not-found-actions a:focus-visible {
    border-color: var(--paper-line-strong);
    background: var(--paper-control-hover);
    color: var(--paper-accent);
    transform: translateY(-1px);
  }

  .not-found-actions a:focus-visible {
    outline: 2px solid var(--paper-accent);
    outline-offset: 3px;
  }

  .not-found-actions .primary-link {
    border-color: color-mix(in srgb, var(--paper-accent) 24%, var(--paper-line));
  }

  @keyframes not-found-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 720px) {
    .not-found-shell {
      min-height: 100vh;
      padding-top: 92px;
      padding-bottom: 42px;
    }

    .not-found-panel {
      padding: 24px 0;
    }

    h1 {
      max-width: 8em;
      font-size: 2.34rem;
    }

    .not-found-actions {
      display: grid;
      grid-template-columns: 1fr;
      margin-top: 24px;
    }
  }
</style>
