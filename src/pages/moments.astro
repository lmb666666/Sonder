---
import Base from '../layouts/Base.astro';
import MomentEntry from '../components/moments/MomentEntry.astro';
import MomentSkeleton from '../components/moments/MomentSkeleton.astro';
import PageHero from '../components/PageHero.astro';
import { getSiteConfig } from '../config';
import { demoMoments } from '../data/moments';
import { formatMomentRange, groupMomentsByMonth, type MomentItem } from '../lib/moments';
import { getUiText } from '../lib/ui-text';
// 动态页特殊内容复用文章指令的纸面卡片、视频与播放器样式，保持同一套 DOM。
import '../plugins/markdown/directives/styles.css';
import '../plugins/markdown/directives/widgets.css';
import 'photoswipe/style.css';
import '../styles/moments-page.css';

const siteConfig = await getSiteConfig();
const { site } = siteConfig;
const pageMeta = siteConfig.pages.moments;
const ui = getUiText(siteConfig);

const ech0Mode = pageMeta.apiUrl.trim().length > 0;
const pageSize = pageMeta.pageSize;
const items: MomentItem[] = ech0Mode ? [] : demoMoments;
const groups = groupMomentsByMonth(items, ui.locale);
const initialCount = Math.min(items.length, pageSize);
const visibleIds = new Set(items.slice(0, initialCount).map((item) => item.id));
const range = formatMomentRange(items);
const statsText = items.length
  ? `${ui.moments.count(items.length)}${range ? ` · ${range}` : ''}`
  : ui.moments.count(0);
const initialRemaining = Math.max(0, items.length - initialCount);

const clientMessages = {
  loading: ui.moments.loading,
  count: ui.moments.count('{count}'),
  loadMoreCount: ui.moments.loadMoreCount('{count}'),
  imageAria: ui.moments.imageAria('{index}'),
  moreImages: ui.moments.moreImages('{count}'),
  loadingMore: ui.moments.loadingMore,
  loadFailed: ui.moments.loadFailed,
  loadFailedHint: ui.moments.loadFailedHint,
  loadMoreFailed: ui.moments.loadMoreFailed,
  retry: ui.moments.retry,
  empty: ui.moments.empty,
  extension: ui.moments.extension,
};
---

<Base title={`${pageMeta.title} | ${site.title}`} description={pageMeta.subtitle}>
  <main class="moments-page" data-pagefind-body data-moments-page>
    <PageHero
      kicker={pageMeta.kicker}
      title={pageMeta.title}
      subtitle={pageMeta.subtitle}
      note={pageMeta.note || undefined}
    >
      <p class="moments-stats" data-moments-stats aria-live="polite">
        {ech0Mode ? ui.moments.loading : statsText}
      </p>
    </PageHero>

    {ech0Mode && <MomentSkeleton />}

    <div class="moments-feed" data-moments-list data-page-size={pageSize}>
      {
        groups.map((group) => (
          <section
            class:list={[
              'moments-month',
              {
                'is-hidden': !group.items.some((item) => visibleIds.has(item.id)),
              },
            ]}
            data-moment-month
            data-month-key={group.key}
          >
            <header class="moments-month-head">
              <h2>{group.label}</h2>
              <span class="moments-month-rule" aria-hidden="true" />
            </header>
            <ol class="moments-month-list">
              {group.items.map((moment) => (
                <MomentEntry
                  moment={moment}
                  locale={ui.locale}
                  hidden={!visibleIds.has(moment.id)}
                  specialLabels={ui.moments.extension}
                  imageAria={ui.moments.imageAria}
                  moreImages={ui.moments.moreImages}
                />
              ))}
            </ol>
          </section>
        ))
      }
    </div>

    <p class="moments-empty" data-moments-empty hidden={ech0Mode || items.length > 0}>
      {ui.moments.empty}
    </p>

    <div class="moments-error" data-moments-error role="alert" hidden>
      <p data-moments-error-text>{ui.moments.loadFailed}</p>
      <button class="moments-retry" type="button" data-moments-retry>
        {ui.moments.retry}
      </button>
    </div>

    <div class="moments-actions" data-moments-actions hidden={ech0Mode || initialRemaining === 0}>
      <button
        class="moments-more"
        type="button"
        data-moments-more
        hidden={ech0Mode || initialRemaining === 0}
      >
        {ui.moments.loadMoreCount(initialRemaining)}
      </button>
    </div>

    <p class="moments-more-error" data-moments-more-error role="status" hidden>
      <span>{ui.moments.loadMoreFailed}</span>
      <button class="moments-retry" type="button" data-moments-more-retry>
        {ui.moments.retry}
      </button>
    </p>

    {
      pageMeta.showPoweredBy && ech0Mode && (
        <p class="moments-powered">
          Powered by{' '}
          <a href="https://github.com/lin-snow/Ech0" target="_blank" rel="noopener noreferrer">
            Ech0
          </a>
        </p>
      )
    }

    <script
      type="application/json"
      data-moments-config
      set:html={JSON.stringify({
        ech0: ech0Mode,
        apiUrl: pageMeta.apiUrl.trim(),
        metingApi: siteConfig.music.meting_api,
        pageSize,
        locale: ui.locale,
        messages: clientMessages,
      }).replace(/</g, '\\u003c')}
    />
  </main>

  <script>
    import { pauseAudioPlayers } from '../plugins/markdown/directives/widgets/audio-player';
    import { initMoments } from '../lib/moments-client';

    const boot = () => initMoments();
    document.addEventListener('astro:page-load', boot);
    document.addEventListener('astro:before-swap', pauseAudioPlayers);
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', boot, { once: true });
    } else {
      boot();
    }
  </script>
</Base>
