---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import BlogArchive from '../../components/blog/BlogArchive.astro';
import GroupNav from '../../components/blog/GroupNav.astro';
import { getSiteConfig } from '../../data/site';
import { sortBlogPostsForArchive } from '../../lib/content-dates';

const siteConfig = await getSiteConfig();
const { site, pages } = siteConfig;
const pageMeta = pages.blog;
const posts = sortBlogPostsForArchive(await getCollection('blog', ({ data }) => !data.draft));
const postsPerPage = pageMeta.postsPerPage;
const totalPages = Math.max(1, Math.ceil(posts.length / postsPerPage));
const page = {
  data: posts.slice(0, postsPerPage),
  currentPage: 1,
  lastPage: totalPages,
  total: posts.length,
  size: postsPerPage,
  url: {
    current: '/blog/',
    next: totalPages > 1 ? '/blog/page/2/' : undefined,
  },
};
---

<Base title={`${pageMeta.title} | ${site.title}`} description={pageMeta.subtitle}>
  <Fragment slot="head">
    <style>
      main {
        width: min(100%, var(--layout-shell-width));
        max-width: none;
        padding: var(--layout-page-top) var(--layout-page-gutter) var(--layout-page-bottom);
      }

      @media (max-width: 720px) {
        main {
          padding-top: 92px;
        }
      }
    </style>
  </Fragment>

  <main data-pagefind-body>
    <BlogArchive
      page={page}
      headerKicker={pageMeta.kicker}
      headerTitle={pageMeta.title}
      headerSubtitle={pageMeta.subtitle}
      headerNote={pageMeta.note}
      coverImageStyle={pageMeta.coverImageStyle}
      listLayout={pageMeta.listLayout}
    >
      <GroupNav slot="after-header" />
    </BlogArchive>
  </main>
</Base>
