---
import Base from '../../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import BackLink from '../../../components/blog/BackLink.astro';
import BlogArchive from '../../../components/blog/BlogArchive.astro';
import { getSiteConfig } from '../../../config';
import { sortBlogPostsForArchive } from '../../../lib/content-dates';
import { getAllTags } from '../../../lib/content-groups';
import { getUiText } from '../../../lib/ui-text';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);

  return getAllTags(posts).map((tag) => {
    const tagPosts = sortBlogPostsForArchive(tag.posts);

    return {
      params: { tag: tag.slug },
      props: {
        tag,
        page: {
          data: tagPosts,
          currentPage: 1,
          lastPage: 1,
          total: tagPosts.length,
          size: tagPosts.length,
          url: {
            current: `/blog/tags/${tag.slug}/`,
          },
        },
      },
    };
  });
}

const siteConfig = await getSiteConfig();
const { site, pages } = siteConfig;
const pageMeta = pages.blog;
const { tag, page } = Astro.props;
const ui = getUiText(siteConfig);
---

<Base title={`${tag.name} | ${site.title}`} description={site.description}>
  <Fragment slot="head">
    <style>
      main {
        width: min(100%, var(--layout-shell-width));
        max-width: none;
        padding: var(--layout-page-top) var(--layout-page-gutter) var(--layout-page-bottom);
      }

      @media (max-width: 720px) {
        main {
          padding-top: 92px;
        }
      }
    </style>
  </Fragment>

  <main data-pagefind-body>
    <BackLink href="/blog/" label={ui.groups.back} />
    <BlogArchive
      page={page}
      headerKicker={ui.groups.tag}
      headerTitle={tag.name}
      headerNote={ui.groups.tagNote(tag.count)}
      coverImageStyle={pageMeta.coverImageStyle}
      listLayout={pageMeta.listLayout}
    />
  </main>
</Base>
