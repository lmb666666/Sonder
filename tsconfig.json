{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "strictNullChecks": true,
    "paths": {
      "@sonder/core": ["./src/framework/index.ts"],
      "@sonder/pages": ["./src/modules/index.ts"],
      "@sonder/page-media": ["./src/modules/media/index.ts"],
      "@sonder/mdx-components/*": ["./src/components/mdx/*"],
      "@sonder/plugin-markdown": ["./src/plugins/markdown/index.ts"],
      "@sonder/plugin-markdown/styles.css": ["./src/plugins/markdown/styles.css"],
      "@sonder/plugin-callout": ["./src/plugins/markdown/callout/index.ts"],
      "@sonder/plugin-callout/styles.css": ["./src/plugins/markdown/callout/styles.css"],
      "@sonder/plugin-markdown-directives": ["./src/plugins/markdown/directives/index.ts"],
      "@sonder/plugin-markdown-directives/styles.css": [
        "./src/plugins/markdown/directives/styles.css"
      ],
      "@sonder/theme-default": ["./src/components/theme/index.ts"],
      "@sonder/theme-default/*": ["./src/components/theme/*"]
    }
  }
}
