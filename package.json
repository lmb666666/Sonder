{
  "name": "sonder",
  "type": "module",
  "version": "0.3.0",
  "author": "Liang",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "fonts:subsets": "bun scripts/fonts/subset-fonts.ts",
    "build": "bun run fonts:subsets && astro build && pagefind --site dist --output-subdir pagefind --root-selector main --exclude-selectors \"[data-pagefind-ignore]\" --force-language zh",
    "preview": "astro preview",
    "astro": "astro",
    "content:new": "bun scripts/new-content.ts",
    "post:new": "bun scripts/new-content.ts post",
    "media:new": "bun scripts/new-content.ts media",
    "lint": "eslint .",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "bun run lint && prettier --check --ignore-unknown .",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@expressive-code/plugin-collapsible-sections": "^0.44.1",
    "@expressive-code/plugin-line-numbers": "^0.44.1",
    "abcjs": "^6.7.2",
    "astro": "^7.1.3",
    "astro-expressive-code": "^0.44.1",
    "ci-info": "^4.4.0",
    "date-fns": "^4.4.0",
    "fast-xml-parser": "^5.3.3",
    "github-slugger": "^2.0.0",
    "katex": "^0.16.47",
    "lucide-astro": "^0.556.0",
    "mermaid": "^11.16.0",
    "qrcode": "^1.5.4",
    "rehype-katex": "^7.0.1",
    "rehype-mathjax": "^7.1.0",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.3",
    "smol-toml": "^1.7.0"
  },
  "devDependencies": {
    "@fontsource/maple-mono": "^5.3.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^8.57.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.1",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.2"
  },
  "lint-staged": {
    "*": "bun run format:check"
  }
}
