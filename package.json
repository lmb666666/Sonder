  "scripts": {
    "prepare": "pnpm clean && nuxt prepare",
    "clean": "rimraf .data node_modules/.cache",
    "dev": "nuxt dev --open",
    "dev:host": "nuxt dev --host",
    "build": "nuxt build",
    "generate": "nuxt generate && unrun scripts/pad-llms-bom.ts",
    "preview": "nuxt preview",
    "bump": "pnpx taze -w && rimraf pnpm-lock.yaml && pnpm update && pnpm dedupe",
    "lint": "eslint && stylelint '**/*.{vue,scss}'",
    "lint:fix": "eslint --fix && stylelint '**/*.{vue,scss}' --fix",
    "format:check": "eslint --no-fix && stylelint '**/*.{vue,scss}'",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "new": "unrun scripts/new-blog.ts",
    "check:feed": "unrun scripts/framework/get-feed.ts",
    "check:feed/all": "unrun scripts/framework/check-all-feeds.ts",
    "generate-friend-json": "unrun scripts/generate-friend-json.ts",
    "audit:config": "unrun scripts/audit/config.ts",
    "audit:content": "unrun scripts/audit/content.ts",
    "audit:dist": "unrun scripts/audit/dist.ts"
  },
